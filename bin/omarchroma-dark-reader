def command_output(command: list[str]) -> str:
    result = subprocess.run(
        command,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    return result.stdout.strip() if result.returncode == 0 else ""


def default_desktop() -> str:
    return (
        command_output(["xdg-settings", "get", "default-web-browser"])
        or command_output(["xdg-mime", "query", "default", "x-scheme-handler/https"])
    )


def browser_info() -> dict:
    desktop = default_desktop()
    info = BROWSERS.get(desktop)
    if info is None:
        return {
            "supported": False,
            "desktop": desktop,
            "name": desktop or "No default browser",
        }

    result = dict(info)
    result["supported"] = True
    result["desktop"] = desktop
    result["config"] = str(Path(result["config"]).expanduser())
    profile = active_profile(result)
    result["profile"] = str(profile)
    result["darkReaderInstalled"] = dark_reader_installed(result, profile)
    if result["family"] == "chromium":
        result["darkReaderStalled"] = chromium_dark_reader_stalled(profile)
    return result


def dark_reader_installed(info: dict, profile: Path) -> bool:
    if info["family"] == "firefox":
        return firefox_dark_reader_installed(profile)
    return chromium_dark_reader_installed(profile)


# A Chromium extension id is exactly 32 characters drawn from a-p: it is a
# hex digest re-encoded into that alphabet. Anything else is not an id.
CHROMIUM_ID_PATTERN = re.compile(r"\A[a-p]{32}\Z")


def valid_extension_id(value: object) -> bool:
    """Whether this is shaped like an extension id.

    The id becomes a path component under the profile, and one of the places it
    is read from is a key in the browser's Preferences JSON. A key is just text,
    so without this a crafted one -- "../../../.." and so on -- would send the
    theme write outside the profile entirely."""
    return isinstance(value, str) and bool(CHROMIUM_ID_PATTERN.match(value))


def chromium_extension_id(profile: Path) -> str:
    """Which id Dark Reader actually has in this profile.

    Omarchroma writes the theme into the extension's own storage, which is keyed
    by id, so guessing wrong writes it nowhere. The store id is used when it is
    present; otherwise the installed extensions are searched for one that calls
    itself Dark Reader, which is what finds a side-loaded build. Falls back to
    the store id so a fresh profile still has somewhere to write."""
    if (profile / "Extensions" / CHROMIUM_STORE_EXTENSION_ID).is_dir():
        return CHROMIUM_STORE_EXTENSION_ID

    extensions = profile / "Extensions"
    if extensions.is_dir():
        try:
            candidates = sorted(extensions.iterdir())
        except OSError:
            candidates = []
        for candidate in candidates:
            if not candidate.is_dir():
                continue
            for manifest in sorted(candidate.glob("*/manifest.json")):
                try:
                    name = json.loads(manifest.read_text()).get("name", "")
                except (json.JSONDecodeError, OSError):
                    continue
                if isinstance(name, str) and name.strip().lower() == "dark reader" \
                        and valid_extension_id(candidate.name):
                    return candidate.name

    # An unpacked extension lives wherever it was loaded from, so it has no
    # directory here; Preferences still records it.
    preferences = profile / "Preferences"
    if preferences.is_file():
        try:
            settings = json.loads(preferences.read_text()).get("extensions", {}).get("settings", {})
        except (json.JSONDecodeError, OSError):
            settings = {}
        for key, entry in sorted(settings.items()):
            if not isinstance(entry, dict):
                continue
            name = (entry.get("manifest") or {}).get("name", "")
            if isinstance(name, str) and name.strip().lower() == "dark reader" \
                    and valid_extension_id(key):
                return key

    return CHROMIUM_STORE_EXTENSION_ID


def chromium_preferences_entry(profile: Path) -> dict | None:
    preferences = profile / "Preferences"
    if not preferences.is_file():
        return None
    try:
        settings = json.loads(preferences.read_text()).get("extensions", {}).get("settings", {})
    except (json.JSONDecodeError, OSError):
        return None
    entry = settings.get(CHROMIUM_STORE_EXTENSION_ID)
    return entry if isinstance(entry, dict) else None


def chromium_dark_reader_installed(profile: Path) -> bool:
    """Whether Dark Reader is really installed, not merely spoken for.

    Deliberately does not count "Sync Extension Settings/<id>": apply_theme
    creates that directory itself, so counting it made this return true for any
    browser Omarchroma had ever themed, whether or not the extension existed.

    A bare key in Preferences does not count either. A force-install policy the
    browser accepted but could not fetch leaves an empty entry there -- a
    pending install, not an installed extension."""
    if (profile / "Extensions" / chromium_extension_id(profile)).exists():
        return True
    entry = chromium_preferences_entry(profile)
    return bool(entry) and any(key in entry for key in ("manifest", "path"))


def chromium_dark_reader_stalled(profile: Path) -> bool:
    """A force-install the browser registered and then never completed.

    Ungoogled-chromium derivatives substitute every Google hostname for an
    unresolvable one, so the Web Store update URL the policy names cannot be
    reached and the extension never arrives. The policy is not at fault and
    retrying will not help, which is worth saying rather than leaving a browser
    silently unthemed."""
    if chromium_dark_reader_installed(profile):
        return False
    entry = chromium_preferences_entry(profile)
    return entry is not None and not entry


def firefox_dark_reader_installed(profile: Path) -> bool:
    extensions_json = profile / "extensions.json"
    if extensions_json.is_file():
        try:
            addons = json.loads(extensions_json.read_text()).get("addons", [])
            for addon in addons:
                if addon.get("id") == FIREFOX_EXTENSION_ID and addon.get("active", True):
                    return True
        except (json.JSONDecodeError, OSError):
            pass
    if (profile / "extensions" / f"{FIREFOX_EXTENSION_ID}.xpi").exists():
        return True
    if (profile / "browser-extension-data" / FIREFOX_EXTENSION_ID).exists():
        return True
    return False


def active_profile(info: dict) -> Path:
    config_dir = Path(info["config"])
    if info["family"] == "firefox":
        return firefox_active_profile(config_dir)
    return chromium_active_profile(config_dir)


def chromium_active_profile(config_dir: Path) -> Path:
    local_state = config_dir / "Local State"
    if local_state.is_file():
        try:
            state = json.loads(local_state.read_text())
            profile = state.get("profile", {}).get("last_used")
            if profile and "/" not in profile and profile not in {".", ".."}:
                return config_dir / profile
        except (json.JSONDecodeError, OSError):
            pass
    return config_dir / "Default"


def firefox_active_profile(config_dir: Path) -> Path:
    profiles_ini = config_dir / "profiles.ini"
    if not profiles_ini.is_file():
        return config_dir

    parser = configparser.ConfigParser()
    try:
        parser.read(profiles_ini)
    except configparser.Error:
        return config_dir

    install_default = None
    for section in parser.sections():
        if section.startswith("Install") and parser.has_option(section, "Default"):
            install_default = parser.get(section, "Default")
            break

    selected = None
    for section in parser.sections():
        if not section.startswith("Profile"):
            continue
        path = parser.get(section, "Path", fallback="")
        if not path:
            continue
        if install_default and path == install_default:
            selected = section
            break
        if parser.get(section, "Default", fallback="0") == "1":
            selected = section

    if selected is None:
        for section in parser.sections():
            if section.startswith("Profile") and parser.has_option(section, "Path"):
                selected = section
                break
    if selected is None:
        return config_dir

    path = Path(parser.get(selected, "Path"))
    if parser.get(selected, "IsRelative", fallback="1") == "1":
        return config_dir / path
    return path


def browser_running(executables: list[str]) -> bool:
    expected = set(executables)
    proc = Path("/proc")
    for entry in proc.iterdir():
        if not entry.name.isdigit():
            continue
        try:
            executable = (entry / "exe").resolve().name
        except OSError:
            continue
        if executable in expected:
            return True
    return False


def write_status(path: Path | None, **values: object) -> None:
    if path is None:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    current = {}
    if path.is_file():
        try:
            current = json.loads(path.read_text())
        except (json.JSONDecodeError, OSError):
            current = {}
    current.update(values)
    atomic_write(path, json.dumps(current, indent=2) + "\n")


def snapshot_settings(db, snapshot_file: Path, info: dict, profile: Path, database: Path) -> None:
    if snapshot_file.exists():
        return
    entries = {}
    for key in MANAGED_KEYS:
        value = db.get(key)
        entries[key.decode()] = {
            "existed": value is not None,
            "value": base64.b64encode(value).decode() if value is not None else "",
        }
    snapshot_file.parent.mkdir(parents=True, exist_ok=True)
    atomic_write(snapshot_file, json.dumps({
        "browser": info["name"],
        "browserDesktop": info["desktop"],
        "browserFamily": "chromium",
        "browserProfile": str(profile),
        "database": str(database),
        "entries": entries,
    }, indent=2) + "\n")


def restore_theme(state_dir: Path, status_file: Path | None) -> int:
    snapshot_file = state_dir / "original/dark-reader.json"
    if not snapshot_file.exists():
        print("Omarchroma: no Dark Reader snapshot found")
        return 0

    snapshot = json.loads(snapshot_file.read_text())
    info = BROWSERS.get(snapshot.get("browserDesktop", ""))
    if info and browser_running(info["executables"]):
        write_status(status_file, darkReader="restore-pending-browser-exit")
        print(f"Omarchroma: close {info['name']} before restoring Dark Reader")
        return 2

    family = snapshot.get("browserFamily", "chromium")
    if family == "firefox":
        restore_firefox_theme(snapshot)
    else:
        try:
            import plyvel
        except ImportError:
            print("Omarchroma: python-plyvel is required", file=sys.stderr)
            return 1

        database = Path(snapshot["database"])
        database.mkdir(parents=True, exist_ok=True)
        with plyvel.DB(str(database), create_if_missing=True) as db:
            for key, entry in snapshot.get("entries", {}).items():
                raw_key = key.encode()
                if entry.get("existed"):
                    db.put(raw_key, base64.b64decode(entry["value"]))
                else:
                    db.delete(raw_key)

    write_status(status_file, darkReader="restored")
    print(f"Omarchroma: Dark Reader restored for {snapshot.get('browser', 'browser')}")
    return 0


def reset_theme(status_file: Path | None) -> int:
    """Return Dark Reader to its factory defaults.

    Deliberately independent of the snapshot. On a machine that has had
    Omarchroma before, the recorded "original" is itself Omarchroma output --
    its theme and every builtIn entry in customThemes already name the generated
    scheme -- so replaying it reinstates a previous generation rather than
    stock. Deleting the managed keys instead lets Dark Reader rebuild its own
    defaults, and costs nothing user-made: Omarchroma only ever overwrote the
    built-in schemes in place."""
    info = browser_info()
    if not info["supported"]:
        print(f"Omarchroma: {info['name']} is not a supported browser")
        return 0
    if browser_running(info["executables"]):
        write_status(status_file, darkReader="reset-pending-browser-exit")
        print(f"Omarchroma: close {info['name']} before resetting Dark Reader")
        return 2

    profile = active_profile(info)
    if info["family"] == "firefox":
        database = profile / "storage-sync-v2.sqlite"
        if database.exists():
            with sqlite3.connect(database) as connection:
                connection.execute(
                    "DELETE FROM storage_sync_data WHERE ext_id = ?",
                    (FIREFOX_EXTENSION_ID,),
                )
                connection.commit()
    else:
        try:
            import plyvel
        except ImportError:
            print("Omarchroma: python-plyvel is required", file=sys.stderr)
            return 1

        database = profile / "Sync Extension Settings" / chromium_extension_id(profile)
        if not database.is_dir():
            print("Omarchroma: no Dark Reader settings to reset")
            write_status(status_file, darkReader="reset")
            return 0
        with plyvel.DB(str(database), create_if_missing=False) as db:
            for key in MANAGED_KEYS:
                db.delete(key)

    write_status(status_file, darkReader="reset")
    print(f"Omarchroma: Dark Reader reset to defaults for {info['name']}")
    return 0


def firefox_storage_data(database: Path) -> dict:
    if not database.exists():
        return {}
    with sqlite3.connect(database) as connection:
        row = connection.execute(
            "SELECT data FROM storage_sync_data WHERE ext_id = ?",
            (FIREFOX_EXTENSION_ID,),
        ).fetchone()
    if row is None or row[0] is None:
        return {}
    return json.loads(row[0])


def write_firefox_storage_data(database: Path, data: dict) -> None:
    database.parent.mkdir(parents=True, exist_ok=True)
    with sqlite3.connect(database) as connection:
        connection.execute(
            "CREATE TABLE IF NOT EXISTS storage_sync_data ("
            "ext_id TEXT NOT NULL PRIMARY KEY, "
            "data TEXT, "
            "sync_change_counter INTEGER NOT NULL DEFAULT 1)"
        )
        connection.execute(
            "INSERT INTO storage_sync_data(ext_id, data, sync_change_counter) "
            "VALUES(?, ?, 1) "
            "ON CONFLICT(ext_id) DO UPDATE SET "
            "data = excluded.data, "
            "sync_change_counter = storage_sync_data.sync_change_counter + 1",
            (FIREFOX_EXTENSION_ID, json.dumps(data, separators=(",", ":"))),
        )
        connection.commit()


def snapshot_firefox_settings(snapshot_file: Path, info: dict, profile: Path, database: Path) -> None:
    if snapshot_file.exists():
        return
    data = firefox_storage_data(database)
    snapshot_file.parent.mkdir(parents=True, exist_ok=True)
    atomic_write(snapshot_file, json.dumps({
        "browser": info["name"],
        "browserDesktop": info["desktop"],
        "browserFamily": "firefox",
        "browserProfile": str(profile),
        "database": str(database),
        "dataExisted": bool(data),
        "data": data,
    }, indent=2) + "\n")


def restore_firefox_theme(snapshot: dict) -> None:
    database = Path(snapshot["database"])
    if snapshot.get("dataExisted"):
        write_firefox_storage_data(database, snapshot.get("data", {}))
        return
    if not database.exists():
        return
    with sqlite3.connect(database) as connection:
        connection.execute(
            "DELETE FROM storage_sync_data WHERE ext_id = ?",
            (FIREFOX_EXTENSION_ID,),
        )
        connection.commit()


def apply_firefox_theme(info: dict, theme: dict, state_dir: Path | None, status_file: Path | None) -> int:
    profile = active_profile(info)
    database = profile / "storage-sync-v2.sqlite"
    if state_dir is not None:
        snapshot_firefox_settings(state_dir / "original/dark-reader.json", info, profile, database)

    data = firefox_storage_data(database)
    data["theme"] = theme
    data["enabled"] = True
    data["enabledByDefault"] = True
    data["detectDarkTheme"] = False
    data["automation"] = {"enabled": False, "mode": "", "behavior": "OnOff"}
    data["changeBrowserTheme"] = False
    data["syncSettings"] = True

    palette_keys = {
        "darkColorScheme",
        "darkSchemeBackgroundColor",
        "darkSchemeTextColor",
        "scrollbarColor",
        "selectionColor",
        "styleSystemControls",
        "stylesheet",
    }
    for key in ("customThemes", "presets"):
        entries = data.get(key)
        if not isinstance(entries, list):
            continue
        for entry in entries:
            entry_theme = entry.get("theme")
            if isinstance(entry_theme, dict):
                entry_theme.update({
                    name: theme[name]
                    for name in palette_keys
                    if name in theme
                })
    write_firefox_storage_data(database, data)

    write_status(
        status_file,
        browser=info["name"],
        browserDesktop=info["desktop"],
        browserProfile=str(profile),
        darkReader="synchronized",
    )
    print(f"Omarchroma: Dark Reader synchronized for {info['name']}")
    return 0


def apply_theme(theme_file: Path, state_dir: Path | None, status_file: Path | None) -> int:
    info = browser_info()
    if not info["supported"]:
        write_status(
            status_file,
            browser=info["name"],
            browserDesktop=info["desktop"],
            darkReader="unsupported",
        )
        print(f"Omarchroma: {info['name']} is not a supported browser")
        return 0

    if browser_running(info["executables"]):
        write_status(
            status_file,
            browser=info["name"],
            browserDesktop=info["desktop"],
            darkReader="pending-browser-exit",
        )
        print(f"Omarchroma: Dark Reader update queued until {info['name']} exits")
        return 2

    theme = json.loads(theme_file.read_text())
    if info["family"] == "firefox":
        return apply_firefox_theme(info, theme, state_dir, status_file)

    try:
        import plyvel
    except ImportError:
        print("Omarchroma: python-plyvel is required", file=sys.stderr)
        return 1

    profile = active_profile(info)
    database = profile / "Sync Extension Settings" / chromium_extension_id(profile)
    database.mkdir(parents=True, exist_ok=True)
    palette_keys = {
        "darkColorScheme",
        "darkSchemeBackgroundColor",
        "darkSchemeTextColor",
        "scrollbarColor",
        "selectionColor",
        "styleSystemControls",
        "stylesheet",
    }

    with plyvel.DB(str(database), create_if_missing=True) as db:
        if state_dir is not None:
            snapshot_settings(db, state_dir / "original/dark-reader.json", info, profile, database)
        db.put(b"theme", json.dumps(theme, separators=(",", ":")).encode())
        db.put(b"enabled", b"true")
        db.put(b"enabledByDefault", b"true")
        db.put(b"detectDarkTheme", b"false")
        db.put(b"automation", b'{"enabled":false,"mode":"","behavior":"OnOff"}')
        db.put(b"changeBrowserTheme", b"false")
        db.put(b"syncSettings", b"true")

        for key in (b"customThemes", b"presets"):
            raw = db.get(key)
            if raw is None:
                continue
            entries = json.loads(raw)
            for entry in entries:
                entry_theme = entry.get("theme")
                if isinstance(entry_theme, dict):
                    entry_theme.update({
                        name: theme[name]
                        for name in palette_keys
                        if name in theme
                    })
            db.put(key, json.dumps(entries, separators=(",", ":")).encode())

    write_status(
        status_file,
        browser=info["name"],
        browserDesktop=info["desktop"],
        browserProfile=str(profile),
        darkReader="synchronized",
    )
    print(f"Omarchroma: Dark Reader synchronized for {info['name']}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--info", action="store_true")
    parser.add_argument("--theme", type=Path)
    parser.add_argument("--state-dir", type=Path)
    parser.add_argument("--status", type=Path)
    parser.add_argument("--restore", action="store_true")
    parser.add_argument("--mode", default="captured", choices=("captured", "stock"))
    args = parser.parse_args()

    if args.info:
        print(json.dumps(browser_info()))
        return 0
    if args.restore:
        if args.mode == "stock":
            return reset_theme(args.status)
        if args.state_dir is None:
            parser.error("--state-dir is required with --restore --mode=captured")
        return restore_theme(args.state_dir, args.status)
    if args.theme is None:
        parser.error("--theme is required unless --info is used")
    return apply_theme(args.theme, args.state_dir, args.status)


if __name__ == "__main__":
    raise SystemExit(main())
