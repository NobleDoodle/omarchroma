#!/usr/bin/env python3
import argparse
import base64
import configparser
import json
import os
import re
import sqlite3
import stat
import subprocess
import sys
import tempfile
from pathlib import Path


def atomic_write(path: Path, data: str, mode: int | None = None) -> None:
    """Replace path with data, through a temporary nothing else can have opened.

    mkstemp creates with O_CREAT|O_EXCL under a random name in the destination
    directory, so a symlink planted at a guessable temporary path cannot be
    followed, and the content is flushed before the rename."""
    path.parent.mkdir(parents=True, exist_ok=True)
    if mode is None:
        try:
            mode = stat.S_IMODE(path.stat().st_mode)
        except OSError:
            mode = 0o644
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


# The id Dark Reader has when it comes from the Chrome Web Store. It is a hash
# of the publisher's key, so every store install shares it -- but a build the
# user side-loaded has its own, and side-loading is the only route left on a
# browser that cannot install from the store. Treated as the first guess, not
# as the answer: see chromium_extension_id.
CHROMIUM_STORE_EXTENSION_ID = "eimadpbcbfnmbkopoojfekhnkhdbieeh"
FIREFOX_EXTENSION_ID = "addon@darkreader.org"

# Every key Omarchroma writes or edits. Snapshotting records these, and a stock
# reset deletes them so Dark Reader regenerates its own defaults on next start.
MANAGED_KEYS = [
    b"theme",
    b"enabled",
    b"enabledByDefault",
    b"detectDarkTheme",
    b"automation",
    b"changeBrowserTheme",
    b"syncSettings",
    b"customThemes",
    b"presets",
]

