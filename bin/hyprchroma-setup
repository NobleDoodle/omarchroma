#!/usr/bin/env bash
# Interactive install for hyprchroma, run in Omarchy's presented terminal so
# the questions have somewhere to be asked and makepkg has somewhere to ask for
# a password. The panel cannot do any of this itself: it has no terminal, and a
# password prompt inside omarchy-shell is a hang.
set -uo pipefail

# Commands resolve from a fixed, verified set rather than the inherited PATH.
# /usr/local/{bin,sbin} are excluded -- nothing here lives there and they are
# the entries most often left group-writable -- and what remains is checked to
# be root-owned and unwritable by others. /usr/bin/stat is named absolutely
# because it is the trust root the check is anchored to.
omarchroma_trusted_path() {
  local directory owner mode trusted=""
  for directory in /usr/bin /usr/share/omarchy/bin; do
    [[ -d $directory ]] || continue
    read -r owner mode < <(/usr/bin/stat -Lc '%u %a' "$directory" 2>/dev/null) || continue
    [[ $owner == 0 || $owner == "$(</proc/sys/kernel/overflowuid)" ]] || continue
    (( (8#$mode & 8#022) == 0 )) || continue
    trusted="${trusted:+$trusted:}$directory"
  done
  printf '%s' "${trusted:-/usr/bin:/usr/share/omarchy/bin}"
}
PATH=$(omarchroma_trusted_path)
export PATH

# Computed here, ahead of everything else, rather than only when the build
# needs it: hyprchroma-dark-reader is a plain script in this same checkout and
# needs no build to run, so the Dark Reader question below can check whether
# it is already configured immediately, not leave that until after makepkg.
here=$(cd -- "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/.." && pwd)

bold=$'\033[1m'; dim=$'\033[2m'; reset=$'\033[0m'; warn=$'\033[1;33m'

say()  { printf '%s\n' "$*"; }
head2() { printf '\n%s%s%s\n' "$bold" "$*" "$reset"; }
note() { printf '%s%s%s\n' "$dim" "$*" "$reset"; }

# Default no. Someone holding return through this should end up with less
# installed, not more.
ask() {
  local prompt=$1 answer
  read -r -p "$prompt [y/N]: " answer
  [[ ${answer,,} == y || ${answer,,} == yes ]]
}

# sudo's own credential cache (five minutes by default) is what every later
# privileged step in this script -- including makepkg's own pacman -U at the
# very end, and the AUR install's own sudo call -- relies on to avoid asking
# for the password again within its lifetime. Left to expire naturally, a
# later prompt happens cold, after whatever came before it went quiet: a live
# session on this exact hardware family showed that specific idle-then-
# sudden-redraw transition landing on a documented amdgpu GFXOFF bug, where
# the GPU fails to wake in time and sudo's own PAM conversation -- which
# tolerates no delay -- reports authentication as failed outright rather than
# merely slow. Kept refreshed here from the first successful authentication
# onward, so every later step, including ones this script does not call
# sudo for directly, reuses the cache silently instead of prompting cold.
keepalive_pid=""
start_sudo_keepalive() {
  [[ -n $keepalive_pid ]] && return 0
  local script_pid=$$
  ( while kill -0 "$script_pid" 2>/dev/null; do sleep 60; sudo -n true 2>/dev/null; done ) >/dev/null 2>&1 &
  keepalive_pid=$!
}
run_sudo() {
  sudo "$@" && start_sudo_keepalive
}

# Checked before a single question is asked, not alongside the optional
# frameworks' dependencies below: jq is what the Dark Reader check right
# after that question reads its answer with, and python is what every helper
# this project ships is written in. Missing either does not just leave
# something optional inactive -- jq missing makes that very check silently
# wrong, reading "not installed" no matter what is actually true, the same
# failure mode this project already fixed once for the wrong reason. So this
# is not offered like the others: declining leaves nothing safe to continue
# into, and the script stops rather than run partly broken.
base_missing=()
for pkg in jq python; do
  pacman -Qq "$pkg" &>/dev/null || base_missing+=("$pkg")
done
if (( ${#base_missing[@]} )); then
  head2 "Before anything else"
  say "hyprchroma needs these, and this script itself uses them before it can ask you anything else:"
  say "  sudo pacman -S --needed ${base_missing[*]}"
  say ""
  if ask "Install them now"; then
    run_sudo pacman -S --needed "${base_missing[@]}" || {
      say "That did not finish, and nothing past this point works without them. Stopping."
      exit 1
    }
  else
    say "Setup cannot continue without them."
    exit 1
  fi
fi

cat <<'INTRO'
Hyprchroma setup

Hyprchroma carries your Omarchy theme into applications that do not follow it
on their own. GTK and Qt/KDE are always included -- they are what most of the
desktop is built from. The rest are optional, and this asks about them now so
you are not left with a panel offering things you do not use.
INTRO

# --- the optional frameworks ----------------------------------------------
head2 "Pear Desktop"
cat <<'PEAR'
Pear Desktop is a desktop app for YouTube Music. Hyprchroma can generate a
stylesheet for it so its window matches your theme instead of staying black
regardless of what the rest of the desktop looks like.

Only useful if you actually use it. Nothing else depends on this.
PEAR
want_pear=no
if ask "Include Pear Desktop"; then want_pear=yes; fi

head2 "Dark Reader"
cat <<'DR'
Dark Reader is a browser extension that darkens web pages. Hyprchroma can push
your theme's colors into it, so pages are tinted to match the rest of the
desktop rather than the extension's own grey.

Hyprchroma does not install the extension -- that is yours to add from your
browser's store. This only decides whether it syncs to it when it is there.
DR
want_dark=no
if ask "Include Dark Reader"; then
  want_dark=yes
  # Right where the question was answered, not after the build finishes
  # minutes from now: the point is to hand over the store link while it is
  # still on screen, not to have it scroll past at the very end. By its own
  # path, not a bare command -- hyprchroma-dark-reader is installed to
  # /usr/lib/hyprchroma, deliberately off this script's own trusted PATH
  # above since it is a private helper, and a bare call here always failed
  # silently and read as "not installed" no matter what was actually true.
  browser=$("$here/lib/hyprchroma-dark-reader" --info 2>/dev/null | jq -r '.name // ""' 2>/dev/null || true)
  installed=$("$here/lib/hyprchroma-dark-reader" --info 2>/dev/null | jq -r '.darkReaderInstalled // false' 2>/dev/null || echo false)
  if [[ $installed != true ]]; then
    say ""
    note "Dark Reader is not installed in ${browser:-your browser}."
    note "Add it from your browser's store and Hyprchroma will theme it from the next sync:"
    note "  Chrome Web Store  https://chromewebstore.google.com/detail/dark-reader/eimadpbcbfnmbkopoojfekhnkhdbieeh"
    note "  Firefox Add-ons   https://addons.mozilla.org/firefox/addon/darkreader/"
  else
    note "Already configured in ${browser:-your browser}."
  fi
fi

# Only asked where there is something to theme. A machine without Flatpak
# answers no without being asked, which also keeps the row out of the panel.
want_flatpak=no
if command -v flatpak >/dev/null; then
  head2 "Flatpak apps"
  cat <<'FLATPAK'
Flatpak apps read their settings from a folder of their own, so they miss the
GTK and Qt/KDE colors above. Hyprchroma can let every Flatpak app read them:
four read-only permissions -- your two GTK folders, kdeglobals, and your KDE
color schemes -- and nothing else. Each app picks it up on its next launch.

This changes a permission for every Flatpak app you have, which is why it is
off unless you say so. Switching it off later removes exactly those four.
FLATPAK
  if ask "Include Flatpak apps"; then want_flatpak=yes; fi
fi

# The same helper the service uses decides what is installed, so this asks
# about exactly the browsers it would theme -- and not at all if there are none.
want_browsers=no
found_browsers=$("$here/lib/hyprchroma-state" detect-browsers 2>/dev/null | paste -sd, - | sed 's/,/, /g')
if [[ -n $found_browsers ]]; then
  head2 "Additional browsers"
  cat <<BROWSERS
Omarchy colors Chromium, Chrome, Brave, Edge and Helium itself, but not these,
which Hyprchroma found here: $found_browsers.

Hyprchroma can color their tabs, toolbar and menus too. It adds a stylesheet
to each Firefox-family profile, and a custom theme to Vivaldi, which it writes
once Vivaldi is closed. Each browser picks it up on its next start.

It changes files inside your browser profiles, which is why it is off unless
you say so. Switching it off removes exactly what it added.
BROWSERS
  if ask "Include additional browsers"; then want_browsers=yes; fi
fi

# --- what those choices need ----------------------------------------------
head2 "Dependencies"
missing=()
explain=()

if ! pacman -Qq adw-gtk-theme &>/dev/null; then
  missing+=(adw-gtk-theme)
  explain+=("adw-gtk-theme  GTK 3 apps follow the theme. Without it they keep the system default.")
fi
if [[ $want_dark == yes ]] && ! pacman -Qq python-plyvel &>/dev/null; then
  missing+=(python-plyvel)
  explain+=("python-plyvel  Dark Reader's settings live in a LevelDB. Without it, Chromium browsers are skipped.")
fi

if (( ${#missing[@]} )); then
  say "These are missing:"
  printf '  %s\n' "${explain[@]}"
  say ""
  say "  sudo pacman -S --needed ${missing[*]}"
  say ""
  if ask "Install them now"; then
    run_sudo pacman -S --needed "${missing[@]}" || note "pacman did not finish; you can run the command above later."
  else
    note "Skipped. Hyprchroma installs and runs without them; those parts stay inactive."
  fi
else
  note "Everything needed is already installed."
fi

# Pear Desktop itself is not a dependency in the sense above -- it is the
# application being themed, not something this needs to run -- and it has no
# package in the official repos to hand to pacman the way the others above
# do. Same check bin/hyprchroma itself uses to decide whether Pear is worth
# syncing at all, so this offers exactly when that would otherwise find
# nothing to theme. pear-desktop-bin, not pear-desktop: both provide the same
# pear-desktop binary the check above looks for, but the plain package builds
# a full Electron app from source on install -- heavy enough, live on this
# project's own 7.2GB test machine, to have pushed the whole session into
# swap and taken the terminal down with it. -bin skips that build entirely.
if [[ $want_pear == yes ]] && ! command -v pear-desktop >/dev/null &&
   [[ ! -d "$HOME/.config/YouTube Music" ]]; then
  say ""
  note "Pear Desktop is not installed."
  say "  omarchy pkg aur add pear-desktop-bin"
  say ""
  if ask "Install it now"; then
    if command -v omarchy >/dev/null; then
      omarchy pkg aur add pear-desktop-bin ||
        note "Could not install pear-desktop-bin; you can run the command above later."
    else
      note "\"omarchy\" was not found, so this cannot be run for you; use the command above."
    fi
  else
    note "Skipped. The panel will still offer Pear Desktop once you install it yourself."
  fi
fi

# --- consent, then build --------------------------------------------------
head2 "What this installs"
cat <<CONSENT
hyprchroma is the background service that keeps GTK, Qt/KDE, and the
frameworks you chose above following your Omarchy theme -- everything this
setup has asked about runs through it, not the panel itself.

It is built from source and installed with pacman, so it can be listed,
upgraded and removed like any other package. Building it:

- builds the service from this checkout with makepkg, which asks pacman to
  install the result -- nothing is downloaded, and no QML is installed
- pacman will ask for your password and show you exactly what it will install
- enables hyprchromad.service for your user, which watches for theme changes

Once running it writes only inside your own home directory: GTK and Qt/KDE
theme files, the Omarchy theme hooks, and the frameworks you chose above. It
runs no privileged command of its own, and it never installs Dark Reader.

Removing it later: sudo pacman -R hyprchroma
CONSENT

printf '\nType "I understand" to continue: '
read -r acknowledgement
if [[ $acknowledgement != "I understand" ]]; then
  printf '%sSetup cancelled; nothing was changed.%s\n' "$warn" "$reset"
  exit 1
fi

head2 "Building"
# $here is set at the top of this script, not here: it is the same checkout
# this script sits in, not a fresh download. The plugin and the service are
# the same repository, so what Omarchy already cloned is the source -- which
# means what gets installed is what you have in front of you, and on a
# published listing, what was reviewed. Cloning again here would let those be
# different things.
if [[ ! -f $here/packaging/PKGBUILD ]]; then
  say "Could not find the package recipe next to this script ($here/packaging)."
  exit 1
fi
cd "$here/packaging" || exit 1
# BUILDDIR moves only makepkg's own scratch space (src/ and pkg/), never the
# source, which package() still reads from $startdir/.. exactly as before.
# Left inside the checkout, that scratch space sits in the same directory
# tree the Omarchy shell watches for plugin changes, and package() writing
# dozens of files there fired that watcher dozens of times a second, mid-build
# -- reloading the panel's whole QML component tree while a build was still
# running underneath it, live on this project's own test machine.
#
# Under the user's own cache directory, not /tmp: every other directory this
# project ever touches lives under $HOME, and a fixed name in a directory
# shared by every user on the machine is a squatting target regardless of
# what mktemp's own randomized suffix does to make the specific path hard to
# guess -- the rule here has always been about the directory, not just the
# name. mktemp -p still gives the leaf a name nothing else could have created
# first.
build_cache="${XDG_CACHE_HOME:-$HOME/.cache}/hyprchroma-setup"
mkdir -p -- "$build_cache" || { say "Could not create $build_cache."; exit 1; }
BUILDDIR=$(mktemp -d -p "$build_cache") || { say "Could not create a build directory."; exit 1; }
trap 'rm -rf -- "$BUILDDIR"; [[ -n $keepalive_pid ]] && kill "$keepalive_pid" 2>/dev/null' EXIT
export BUILDDIR
# BUILDDIR alone only moves makepkg's own scratch space (src/ and pkg/);
# the finished package itself still defaults to $startdir -- this PKGBUILD's
# own directory, back inside the watched plugin tree -- unless PKGDEST says
# otherwise. That finished file landing there, right as makepkg's own sudo
# pacman -U needs the password, reproduced the exact reload-storm-timed PAM
# failure this was meant to fix, on this project's own test machine.
export PKGDEST="$BUILDDIR"
# Warmed here regardless of whether an earlier step already authenticated,
# so a system with every dependency already satisfied -- which never called
# run_sudo above -- does not hit its very first prompt deep inside makepkg's
# own internal install step at the end of the build.
run_sudo -v || { say "Could not authenticate; nothing was built."; exit 1; }
makepkg -si --needed || { say "The build did not finish; nothing else was changed."; exit 1; }

# --- apply the choices, now that the tool exists --------------------------
head2 "Applying your choices"
[[ $want_pear == yes ]] || hyprchroma framework remove pear
[[ $want_dark == yes ]] || hyprchroma framework remove dark-reader
# Opt-in, so a yes has to switch it on rather than just leave it listed --
# which "framework restore" does.
if [[ $want_flatpak == yes ]]; then
  hyprchroma framework restore flatpak
else
  hyprchroma framework remove flatpak
fi
if [[ $want_browsers == yes ]]; then
  hyprchroma framework restore browsers
else
  hyprchroma framework remove browsers
fi

systemctl --user enable --now hyprchromad.service ||
  note "Could not start hyprchromad.service; 'systemctl --user status hyprchromad' will say why."

# enable --now above starts the service only if it was not already running --
# on an update it was, so it keeps executing whatever it had already loaded
# into memory. pacman does not restart a running service, and the Omarchy
# shell does not notice a changed plugin file the same way either: this is
# exactly what made a real fix look like it had not happened at all.
#
# Not run automatically. omarchy restart shell was tried here and pulled back:
# live on this project's own test machine, its relaunch step failed silently
# once, leaving no shell running at all until it was retried by hand -- worse
# than the stale-code problem it exists to fix. Printing the commands and
# leaving them to be run and watched is the safer default until that is
# understood.
head2 "Restart to finish"
cat <<'RESTARTINFO'
Restart your Omarchy shell after closing this window. You can do so from
your terminal: omarchy restart shell
RESTARTINFO

head2 "Done"
say "Anything you left out can be put back from the panel: press / and then its number."
say ""
read -r -p "Press return to close this window. "
