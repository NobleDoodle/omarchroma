#!/usr/bin/env bash
# Interactive install for hyprchroma, run in Omarchy's presented terminal so
# the questions have somewhere to be asked and makepkg has somewhere to ask for
# a password. The panel cannot do any of this itself: it has no terminal, and a
# password prompt inside omarchy-shell is a hang.
set -uo pipefail

# Commands resolve from a fixed, verified set rather than the inherited PATH.
# /usr/local/{bin,sbin} are excluded -- nothing here lives there and they are
# the entries most often left group-writable -- and what remains is checked to
# be root-owned and unwritable by others. /usr/bin/stat is named absolutely
# because it is the trust root the check is anchored to.
omarchroma_trusted_path() {
  local directory owner mode trusted="" unmapped="" overflow inside count
  # The overflow uid stands in for an owner this namespace does not map --
  # root's /usr, under systemd's sandboxing. Where it is mapped, as in the host
  # namespace, it is the nobody account, and trusted with nothing.
  if [[ -r /proc/self/uid_map ]] && overflow=$(</proc/sys/kernel/overflowuid); then
    unmapped=$overflow
    while read -r inside _ count; do
      (( overflow >= inside && overflow < inside + count )) && unmapped=""
    done < /proc/self/uid_map
  fi
  for directory in /usr/bin /usr/share/omarchy/bin; do
    [[ -d $directory ]] || continue
    read -r owner mode < <(/usr/bin/stat -Lc '%u %a' "$directory" 2>/dev/null) || continue
    [[ $owner == 0 || ( -n $unmapped && $owner == "$unmapped" ) ]] || continue
    (( (8#$mode & 8#022) == 0 )) || continue
    trusted="${trusted:+$trusted:}$directory"
  done
  printf '%s' "${trusted:-/usr/bin:/usr/share/omarchy/bin}"
}
PATH=$(omarchroma_trusted_path)
export PATH

# Computed here, ahead of everything else, rather than only when the build
# needs it: hyprchroma-dark-reader is a plain script in this same checkout and
# needs no build to run, so the Dark Reader question below can check whether
# it is already configured immediately, not leave that until after makepkg.
here=$(cd -- "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/.." && pwd)

bold=$'\033[1m'; dim=$'\033[2m'; reset=$'\033[0m'; warn=$'\033[1;33m'

say()  { printf '%s\n' "$*"; }
head2() { printf '\n%s%s%s\n' "$bold" "$*" "$reset"; }
note() { printf '%s%s%s\n' "$dim" "$*" "$reset"; }

# Default no. Someone holding return through this should end up with less
# installed, not more. A second argument of "yes" makes return mean yes, for a
# question about something already on: keeping it must not take a keypress.
ask() {
  local prompt=$1 default=${2:-no} answer
  if [[ $default == yes ]]; then
    read -r -p "$prompt [Y/n]: " answer
    [[ ${answer,,} != n && ${answer,,} != no ]]
  else
    read -r -p "$prompt [y/N]: " answer
    [[ ${answer,,} == y || ${answer,,} == yes ]]
  fi
}

# sudo's own credential cache (five minutes by default) is what every later
# privileged step in this script -- including makepkg's own pacman -U at the
# very end, and the AUR install's own sudo call -- relies on to avoid asking
# for the password again within its lifetime. Left to expire naturally, a
# later prompt happens cold, after whatever came before it went quiet: a live
# session on this exact hardware family showed that specific idle-then-
# sudden-redraw transition landing on a documented amdgpu GFXOFF bug, where
# the GPU fails to wake in time and sudo's own PAM conversation -- which
# tolerates no delay -- reports authentication as failed outright rather than
# merely slow. Kept refreshed here from the first successful authentication
# onward, so every later step, including ones this script does not call
# sudo for directly, reuses the cache silently instead of prompting cold.
keepalive_pid=""
start_sudo_keepalive() {
  [[ -n $keepalive_pid ]] && return 0
  local script_pid=$$
  ( while kill -0 "$script_pid" 2>/dev/null; do sleep 60; sudo -n true 2>/dev/null; done ) >/dev/null 2>&1 &
  keepalive_pid=$!
}
run_sudo() {
  sudo "$@" && start_sudo_keepalive
}

# Every AUR install goes through these two. The password is asked for before
# anything is fetched from the AUR, not left to yay: yay only calls sudo at
# the very end, after the download and the build, and a prompt that fails
# there -- as it did once, live, with nothing on screen to say so -- leaves a
# finished package in ~/.cache/yay that was never installed. The cached
# credential (kept fresh by the keepalive above) is what yay's own sudo then
# uses. Afterwards pacman is asked whether the package is really there, so a
# failure is reported as one rather than as silence.
authenticate_for() {
  say ""
  say "sudo asks for your password now, before anything is downloaded: $1"
  run_sudo -v
}
aur_install() {
  local package=$1
  omarchy pkg aur add "$package" || true
  if pacman -Qq "$package" &>/dev/null; then
    note "Installed $package."
    return 0
  fi
  note "$package was not installed. Nothing else was changed; you can try again"
  note "later with: omarchy pkg aur add $package"
  return 1
}

# Reversal is not in the official repos. It comes from its AUR package, the
# way Pear Desktop does above -- but only once that package's recipe is the
# one reviewed for this release: it builds Reversal from its GitHub
# repository and installs Reversal and Reversal-dark under /usr/share/icons,
# nothing else. A recipe that has changed since is not built here; the AUR
# page is named so it can be read first. Checked right before the install,
# against what the AUR serves now.
REVERSAL_AUR=reversal-icon-theme-git
REVERSAL_PKGBUILD_SHA256=dd4cecbf36c25f0be53d19c0373935a7d90739d876a07a621b956d180fee01a4
reversal_installed() {
  [[ -f ${XDG_DATA_HOME:-$HOME/.local/share}/icons/Reversal/index.theme ||
     -f /usr/share/icons/Reversal/index.theme ]]
}
reversal_recipe_verified() {
  local sum
  sum=$(curl -fsSL --max-time 20 --proto '=https' \
          "https://aur.archlinux.org/cgit/aur.git/plain/PKGBUILD?h=$REVERSAL_AUR" | sha256sum) || return 1
  [[ ${sum%% *} == "$REVERSAL_PKGBUILD_SHA256" ]]
}
# Offered whenever Icons is included, whichever set was picked, and on its
# own from the panel's Icons view (--reversal). Only the AUR package itself
# counts as installed here -- a copy put in the icon folders by hand works,
# but nothing keeps it current. Why it is wanted is said before the question,
# never after. Leaves reversal_result: installed, declined or failed.
reversal_result=declined
offer_reversal() {
  reversal_result=declined
  if pacman -Qq "$REVERSAL_AUR" &>/dev/null; then
    reversal_result=installed
    return 0
  fi
  head2 "Reversal icons"
  if reversal_installed; then
    say "Why this is asked: Reversal is in your icon folders, but it was not"
    say "installed from its package, so nothing keeps it up to date. The package"
    say "puts a copy in /usr/share/icons that updates with the rest of your system."
    say "Your copy in ~/.local/share/icons is still used first while it is there."
  elif [[ $icon_set == yaru ]]; then
    say "Why this is asked: you chose Yaru, which Omarchy already has, so Icons"
    say "works without this. Reversal is the other set the panel switches to (r),"
    say "and the plates behind app covers are drawn in its style. Without it, the"
    say "panel offers Yaru only."
  else
    cat <<'WHY'
Why this is asked: Reversal is the icon pack Omarchroma offers by default. It
gives all of your icons one clean look, as rounded squares, and once it is
installed Omarchroma follows your theme exactly, folders and app icons alike.

If you do not install it, Icons uses Yaru, Omarchy's own icons, with its
folders colored to match your theme; your app icons stay as they are. The
panel then shows Reversal as not installed, and you can install it from there
(Icons, then r) if you change your mind.
WHY
  fi
  cat <<REVERSALAUR

Reversal is not part of Omarchy or the official Arch repositories, so it comes
from the AUR as $REVERSAL_AUR. Installing it:
  - checks the AUR recipe first: downloads its PKGBUILD (a small text file)
    from aur.archlinux.org and compares it with the one reviewed for this
    release; a recipe that has changed is not built
  - downloads the icons' source (about 20 MB) from
    github.com/yeyushengfan258/Reversal-icon-theme
  - builds the package as you, with yay, in ~/.cache/yay
  - installs Reversal and Reversal-dark into /usr/share/icons with pacman,
    which needs your password (sudo); that is asked for before anything is
    downloaded

The command:  omarchy pkg aur add $REVERSAL_AUR
Removing it later:  sudo pacman -R $REVERSAL_AUR
REVERSALAUR
  say ""
  if ! ask "Download and install Reversal from the AUR"; then
    note "Skipped; nothing was downloaded."
    return 0
  fi
  reversal_result=failed
  if ! command -v omarchy >/dev/null; then
    note "\"omarchy\" was not found, so this cannot be run for you; use the command above."
  elif ! authenticate_for "pacman installs Reversal at the end."; then
    note "No password given, so nothing was downloaded."
  else
    say "Checking the AUR recipe (downloading its PKGBUILD from aur.archlinux.org)..."
    if ! reversal_recipe_verified; then
      note "The AUR recipe for $REVERSAL_AUR is not the one this release was checked against"
      note "(or the AUR could not be reached), so nothing else was downloaded. Read it first:"
      note "  https://aur.archlinux.org/packages/$REVERSAL_AUR"
      note "then install it with the command above if it looks right."
    else
      note "Recipe verified: it builds Reversal from github.com/yeyushengfan258/Reversal-icon-theme."
      aur_install "$REVERSAL_AUR" && reversal_result=installed
    fi
  fi
  return 0
}

# From the panel's Icons view: only the Reversal offer, then Reversal chosen
# if it arrived. Nothing else in this script runs.
if [[ ${1:-} == --reversal ]]; then
  icon_set=reversal
  offer_reversal
  if [[ $reversal_result == installed ]]; then
    if hyprchroma icons set reversal >/dev/null 2>&1; then
      note "Icons uses Reversal now."
    else
      note "Reversal is installed; choose it in the panel: Icons, then r."
    fi
  fi
  say ""
  read -r -p "Press return to close this window. "
  exit 0
fi

# Checked before a single question is asked, not alongside the optional
# frameworks' dependencies below: jq is what the Dark Reader check right
# after that question reads its answer with, and python is what every helper
# this project ships is written in. Missing either does not just leave
# something optional inactive -- jq missing makes that very check silently
# wrong, reading "not installed" no matter what is actually true, the same
# failure mode this project already fixed once for the wrong reason. So this
# is not offered like the others: declining leaves nothing safe to continue
# into, and the script stops rather than run partly broken.
base_missing=()
for pkg in jq python; do
  pacman -Qq "$pkg" &>/dev/null || base_missing+=("$pkg")
done
if (( ${#base_missing[@]} )); then
  head2 "Before anything else"
  say "hyprchroma needs these, and this script itself uses them before it can ask you anything else."
  say "Installing them downloads them from the official Arch repositories; sudo asks for"
  say "your password first, and pacman shows what it will download before it does:"
  say "  sudo pacman -S --needed ${base_missing[*]}"
  say ""
  if ask "Install them now"; then
    run_sudo pacman -S --needed "${base_missing[@]}" || {
      say "That did not finish, and nothing past this point works without them. Stopping."
      exit 1
    }
  else
    say "Setup cannot continue without them."
    exit 1
  fi
fi

# The first screen: what this is, what is new, and one question. It has to
# fit Omarchy's floating terminal (875x600) below the logo the presentation
# wrapper prints -- about 31 rows, 13 of them the logo -- with no scrolling,
# so the intro is kept to five lines and WHATSNEW.md to one line per item.
# tests/test-setup.sh measures it.
printf '%sOmarchroma setup%s\n' "$bold" "$reset"
cat <<'INTRO'
Omarchroma installs a user service called Hyprchroma that carries your Omarchy
theme into apps that do not follow it on their own. GTK and Qt/KDE are always
on; you choose the rest next. Nothing is downloaded or installed without
saying what and why, and asking first.
INTRO

# What changed in this version, read from the checkout's own WHATSNEW.md -- the
# same file the repository shows -- so it is written once per release and
# cannot drift from what is being installed. Its "# " title becomes a heading;
# a checkout without it just skips this.
if [[ -f $here/WHATSNEW.md ]]; then
  head2 "$(sed -n 's/^# //p' "$here/WHATSNEW.md" | head -1)"
  sed '/^# /d; /^$/d' "$here/WHATSNEW.md"
fi
say ""
if ! ask "Would you like to proceed with the install/update?" yes; then
  say "Nothing was changed."
  exit 0
fi
# Each block after this starts at the top of the window, not below the last.
printf '\033[H\033[2J'

# --- the optional frameworks ----------------------------------------------
# One question first: every framework at once, or one at a time. Either way,
# what they need is checked and offered afterwards, the same way. What is
# here to theme is looked up first, so the overview can say so.
has_flatpak=no
command -v flatpak >/dev/null && has_flatpak=yes
# The same helper the service uses decides what is installed, so this asks
# about exactly the browsers it would theme -- and not at all if there are none.
found_browsers=$("$here/lib/hyprchroma-state" detect-browsers 2>/dev/null | paste -sd, - | sed 's/,/, /g')

# One line per framework, 80 columns at most: a 20-column name, then a
# description of 57 or less. A long browser list wraps under its own.
head2 "Frameworks"
say "Each one carries your theme into one kind of application:"
say ""
framework_line() {
  local name=$1 line first=yes
  while IFS= read -r line; do
    if [[ $first == yes ]]; then
      printf '  %s%-20s%s %s\n' "$bold" "$name" "$reset" "$line"; first=no
    else
      printf '  %-20s %s\n' "" "$line"
    fi
  done < <(fold -s -w 57 <<<"$2" | sed 's/ *$//')
}
framework_line "GTK and GNOME" "Always on: GTK 3/4 and GNOME apps (needs adw-gtk-theme)"
framework_line "Qt and KDE" "Always on: Qt and KDE apps, their colors and icons"
framework_line "Thunderbird" "Its own window; writes a stylesheet into mail profiles"
framework_line "Pear Desktop" "YouTube Music app; offers it from the AUR if missing"
framework_line "Dark Reader" "Tints web pages via the extension (needs python-plyvel)"
if [[ $has_flatpak == yes ]]; then
  framework_line "Flatpak apps" "Flatpak apps read your colors: four read-only permissions"
else
  framework_line "Flatpak apps" "Flatpak is not installed here, so it stays off"
fi
if [[ -n $found_browsers ]]; then
  framework_line "Additional browsers" "Tabs, toolbar and menus of: $found_browsers"
else
  framework_line "Additional browsers" "No Firefox-family browser or Vivaldi here; stays off"
fi
framework_line "Icons" "Theme-colored icons and folders (needs python-pillow)"
cat <<'ALL'

Yes switches on every one with something to theme here; no asks one by one.
Nothing is downloaded or installed yet: each download or install asks first.
ALL
all_frameworks=no
if ask "Enable every framework"; then all_frameworks=yes; fi
# One at a time, each section explains itself; all at once, a summary follows.
explain() { if [[ $all_frameworks == yes ]]; then cat >/dev/null; else cat; fi; }
section() { [[ $all_frameworks == yes ]] || head2 "$@"; }

section "Additional Apps"
explain <<'TB'
Thunderbird does not pick up the GTK theme in its own window. Hyprchroma
colors it the same way it colors Firefox, which Thunderbird reads the next
time it starts. This writes into your mail profiles, so it is off unless
you say so.
TB
want_thunderbird=no
if [[ $all_frameworks == yes ]] || ask "Include Thunderbird"; then want_thunderbird=yes; fi
explain <<'PEAR'
Pear Desktop is a desktop app for YouTube Music. Hyprchroma can generate a
stylesheet for it so its window matches your theme instead of staying black
regardless of what the rest of the desktop looks like.
PEAR
want_pear=no
if [[ $all_frameworks == yes ]] || ask "Include Pear Desktop (YouTube Music)"; then want_pear=yes; fi

section "Dark Reader"
explain <<'DR'
Dark Reader is a browser extension that darkens web pages. Hyprchroma can push
your theme's colors into it, so pages are tinted to match the rest of the
desktop rather than the extension's own grey.

Hyprchroma does not install the extension -- that is yours to add from your
browser's store. This only decides whether it syncs to it, in every browser
and profile it is installed in, not only your default browser.
DR
want_dark=no
if [[ $all_frameworks == yes ]] || ask "Include Dark Reader"; then
  want_dark=yes
  # Right where the question was answered, not after the build finishes
  # minutes from now: the point is to hand over the store link while it is
  # still on screen, not to have it scroll past at the very end. By its own
  # path, not a bare command -- hyprchroma-dark-reader is installed to
  # /usr/lib/hyprchroma, deliberately off this script's own trusted PATH
  # above since it is a private helper, and a bare call here always failed
  # silently and read as "not installed" no matter what was actually true.
  found_in=$("$here/lib/hyprchroma-dark-reader" --info 2>/dev/null | jq -r '(.browsers // []) | join(", ")' 2>/dev/null || true)
  if [[ -z $found_in ]]; then
    say ""
    note "Dark Reader is not installed in any supported browser yet."
    note "Add it from a browser's store and Hyprchroma will theme it from the next sync:"
    note "  Chrome Web Store  https://chromewebstore.google.com/detail/dark-reader/eimadpbcbfnmbkopoojfekhnkhdbieeh"
    note "  Firefox Add-ons   https://addons.mozilla.org/firefox/addon/darkreader/"
  else
    note "Found in $found_in; each is themed, and any browser you add it to later."
  fi
fi

# Only asked where there is something to theme. A machine without Flatpak
# answers no without being asked, which also keeps the row out of the panel.
want_flatpak=no
if [[ $has_flatpak == yes ]]; then
  section "Flatpak apps"
  explain <<'FLATPAK'
Flatpak apps read their settings from a folder of their own, so they miss the
GTK and Qt/KDE colors above. Hyprchroma can let every Flatpak app read them:
four read-only permissions -- your two GTK folders, kdeglobals, and your KDE
color schemes -- and nothing else. Each app picks it up on its next launch.

This changes a permission for every Flatpak app you have, which is why it is
off unless you say so. Switching it off later removes exactly those four.
FLATPAK
  if [[ $all_frameworks == yes ]] || ask "Include Flatpak apps"; then want_flatpak=yes; fi
fi

want_browsers=no
if [[ -n $found_browsers ]]; then
  section "Additional browsers"
  explain <<BROWSERS
Omarchy colors Chromium, Chrome, Brave and Helium itself, but not these,
which Hyprchroma found here: $found_browsers.

Hyprchroma can color their tabs, toolbar and menus too. It adds a stylesheet
to each Firefox-family profile, and a custom theme to Vivaldi, which it writes
once Vivaldi is closed. Each browser picks it up on its next start.

It changes files inside your browser profiles, which is why it is off unless
you say so. Switching it off removes exactly what it added.
BROWSERS
  if [[ $all_frameworks == yes ]] || ask "Include additional browsers"; then want_browsers=yes; fi
fi

# --- icons ------------------------------------------------------------------
section "Icons"
explain <<'ICONS'
Hyprchroma can give every Omarchy theme a matching icon set, Reversal or Yaru,
in the color nearest the theme's accent. Folders take their color from the
theme -- its sidebar highlight, its accent or its window border, your choice
in the panel -- and change with it. App icons Reversal does not have can be
put on its rounded plate, so the app menu matches.

It points each theme at an icon theme of its own, so it is off unless you say
so. Switching it off puts every theme's own icon setting back.
ICONS
settings_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hyprchroma"
if [[ $all_frameworks == no && $(jq -r '.frameworks.icons // false' "$settings_dir/settings.json" 2>/dev/null) == true ]]; then
  note "It is on now; answer yes to keep it."
fi
want_icons=no
icon_set=$(jq -r '.icon_set // "reversal"' "$settings_dir/icons/settings.json" 2>/dev/null || echo reversal)
[[ $icon_set == yaru ]] || icon_set=reversal
if [[ $all_frameworks == yes ]] || ask "Include icons"; then
  want_icons=yes
  # All at once keeps the recorded set (Reversal the first time); the panel
  # switches it with r / y.
  if [[ $all_frameworks == no ]]; then
    say ""
    say "  1) Reversal  colorful rounded icons, with covers for apps it lacks"
    say "  2) Yaru      Ubuntu's icons, already part of Omarchy; every app keeps its own"
    default_choice=1; [[ $icon_set == yaru ]] && default_choice=2
    read -r -p "Icon set [$default_choice]: " set_choice
    case ${set_choice:-$default_choice} in
      2) icon_set=yaru ;;
      *) icon_set=reversal ;;
    esac
  fi
fi

if [[ $all_frameworks == yes ]]; then
  say ""
  say "Switching on:"
  say "  Thunderbird, Pear Desktop (YouTube Music), Dark Reader"
  [[ $want_flatpak == yes ]] && say "  Flatpak apps"
  [[ $want_browsers == yes ]] && say "  Additional browsers: $found_browsers"
  if [[ $icon_set == yaru ]]; then
    say "  Icons, with Yaru (the panel switches sets: r / y)"
  else
    say "  Icons, with Reversal if you install it below, otherwise Yaru"
  fi
  [[ $has_flatpak == yes ]] || note "No Flatpak here, so Flatpak apps stays off."
  [[ -n $found_browsers ]] || note "No additional browser found, so Additional browsers stays off."
fi

# --- restarting apps after a theme change ---------------------------------
# Yes always means on. It used to ask "Turn it off" when it was already on,
# and a yes typed out of habit switched it off. Instead the default follows
# what is recorded, so holding return keeps the current choice either way.
head2 "Restart apps at theme change"
cat <<'RESTART'
Yes: after each theme change, the panel opens with the apps still on the old
theme, ready to restart. Nothing closes until you press Ctrl+Enter.
No: restart them yourself when you want, from the panel (/ then Ctrl+Enter).

Restarting closes apps, so save your work first. An app may not offer to
save, and an app with several windows closes without asking.
RESTART
current_restart=$(jq -r '.restartMode // "off"' "${XDG_STATE_HOME:-$HOME/.local/state}/hyprchroma/settings.json" 2>/dev/null || echo off)
restart_default=no
if [[ $current_restart == confirm || $current_restart == force ]]; then
  restart_default=yes
  note "It is on now."
fi
want_restart=off
if ask "Show the restart list after each theme change" "$restart_default"; then
  want_restart=confirm
fi

# --- Reversal ---------------------------------------------------------------
# Ahead of the dependency check: without Reversal, Icons uses Yaru, and Yaru
# has packages of its own to check for.
if [[ $want_icons == yes ]]; then
  offer_reversal
  if [[ $icon_set == reversal ]] && ! reversal_installed; then
    icon_set=yaru
    note "Icons uses Yaru, with folders in your theme's colors. Reversal can be"
    note "installed later from the panel: Icons, then r."
  fi
fi

# --- what those choices need ----------------------------------------------
head2 "Dependencies"
missing=()
explain=()

if ! pacman -Qq adw-gtk-theme &>/dev/null; then
  missing+=(adw-gtk-theme)
  explain+=("adw-gtk-theme  GTK 3 apps follow the theme. Without it they keep the system default.")
fi
if [[ $want_icons == yes ]]; then
  if ! pacman -Qq python-pillow &>/dev/null; then
    missing+=(python-pillow)
    explain+=("python-pillow  Icons draws app covers and reads Yaru's folders with it.")
  fi
  if [[ $icon_set == yaru ]]; then
    pacman -Qq python-numpy &>/dev/null || {
      missing+=(python-numpy)
      explain+=("python-numpy  Yaru's folders are traced once so they can take the theme's color.")
    }
    pacman -Qq yaru-icon-theme &>/dev/null || {
      missing+=(yaru-icon-theme)
      explain+=("yaru-icon-theme  The Yaru icon set. Omarchy ships it, but it is not installed here.")
    }
  fi
fi
if [[ $want_dark == yes ]] && ! pacman -Qq python-plyvel &>/dev/null; then
  missing+=(python-plyvel)
  explain+=("python-plyvel  Dark Reader's settings live in a LevelDB. Without it, Chromium browsers are skipped.")
fi

if (( ${#missing[@]} )); then
  say "These are missing:"
  printf '  %s\n' "${explain[@]}"
  say ""
  say "Installing them downloads them from the official Arch repositories. sudo"
  say "asks for your password first; pacman then lists each package with its size"
  say "and asks once more before it downloads anything:"
  say "  sudo pacman -S --needed ${missing[*]}"
  say ""
  if ask "Install them now"; then
    run_sudo pacman -S --needed "${missing[@]}" || note "pacman did not finish; you can run the command above later."
  else
    note "Skipped. Hyprchroma installs and runs without them; those parts stay inactive."
  fi
else
  note "Everything needed is already installed."
fi

# Pear Desktop itself is not a dependency in the sense above -- it is the
# application being themed, not something this needs to run -- and it has no
# package in the official repos to hand to pacman the way the others above
# do. Same check bin/hyprchroma itself uses to decide whether Pear is worth
# syncing at all, so this offers exactly when that would otherwise find
# nothing to theme. pear-desktop-bin, not pear-desktop: both provide the same
# pear-desktop binary the check above looks for, but the plain package builds
# a full Electron app from source on install -- heavy enough, live on this
# project's own 7.2GB test machine, to have pushed the whole session into
# swap and taken the terminal down with it. -bin skips that build entirely.
if [[ $want_pear == yes ]] && ! command -v pear-desktop >/dev/null &&
   [[ ! -d "$HOME/.config/YouTube Music" ]]; then
  head2 "Pear Desktop app"
  cat <<'PEARAUR'
Why this is asked: you included Pear Desktop, but the app itself is not
installed, so there is nothing for Hyprchroma to theme yet.

It is not part of Omarchy or the official Arch repositories, so it comes from
the AUR as pear-desktop-bin, the project's own prebuilt release. Installing it:
  - downloads its AUR recipe from aur.archlinux.org, and the app itself
    (about 110 MB) from the project's releases on GitHub
  - packages it as you, with yay, in ~/.cache/yay
  - installs it with pacman, which needs your password (sudo); that is
    asked for before anything is downloaded

The command:  omarchy pkg aur add pear-desktop-bin
Removing it later:  sudo pacman -R pear-desktop-bin
PEARAUR
  say ""
  if ask "Download and install Pear Desktop from the AUR"; then
    if ! command -v omarchy >/dev/null; then
      note "\"omarchy\" was not found, so this cannot be run for you; use the command above."
    elif ! authenticate_for "pacman installs Pear Desktop at the end."; then
      note "No password given, so nothing was downloaded."
    else
      aur_install pear-desktop-bin || true
    fi
  else
    note "Skipped; nothing was downloaded. The panel themes Pear Desktop once you install it."
  fi
fi

# --- consent, then build --------------------------------------------------
head2 "What this installs"
cat <<CONSENT
hyprchroma is the background service that keeps GTK, Qt/KDE, and the
frameworks you chose above following your Omarchy theme -- everything this
setup has asked about runs through it, not the panel itself.

It is built from source and installed with pacman, so it can be listed,
upgraded and removed like any other package. Building it:

- builds the service from this checkout with makepkg, which asks pacman to
  install the result -- nothing is downloaded, and no QML is installed
- pacman will ask for your password and show you exactly what it will install
- enables hyprchromad.service for your user, which watches for theme changes

Once running it writes only inside your own home directory: GTK and Qt/KDE
theme files, the Omarchy theme hooks, and the frameworks you chose above. It
runs no privileged command of its own, and it never installs Dark Reader.

Removing it later: open the panel, press s for Settings, then u for Uninstall.
CONSENT

printf '\nType "I understand" to continue: '
read -r acknowledgement
if [[ $acknowledgement != "I understand" ]]; then
  printf '%sSetup cancelled; nothing was changed.%s\n' "$warn" "$reset"
  exit 1
fi

head2 "Building"
# $here is set at the top of this script, not here: it is the same checkout
# this script sits in, not a fresh download. The plugin and the service are
# the same repository, so what Omarchy already cloned is the source -- which
# means what gets installed is what you have in front of you, and on a
# published listing, what was reviewed. Cloning again here would let those be
# different things.
if [[ ! -f $here/packaging/PKGBUILD ]]; then
  say "Could not find the package recipe next to this script ($here/packaging)."
  exit 1
fi
cd "$here/packaging" || exit 1
# BUILDDIR moves only makepkg's own scratch space (src/ and pkg/), never the
# source, which package() still reads from $startdir/.. exactly as before.
# Left inside the checkout, that scratch space sits in the same directory
# tree the Omarchy shell watches for plugin changes, and package() writing
# dozens of files there fired that watcher dozens of times a second, mid-build
# -- reloading the panel's whole QML component tree while a build was still
# running underneath it, live on this project's own test machine.
#
# Under the user's own cache directory, not /tmp: every other directory this
# project ever touches lives under $HOME, and a fixed name in a directory
# shared by every user on the machine is a squatting target regardless of
# what mktemp's own randomized suffix does to make the specific path hard to
# guess -- the rule here has always been about the directory, not just the
# name. mktemp -p still gives the leaf a name nothing else could have created
# first.
build_cache="${XDG_CACHE_HOME:-$HOME/.cache}/hyprchroma-setup"
mkdir -p -- "$build_cache" || { say "Could not create $build_cache."; exit 1; }
BUILDDIR=$(mktemp -d -p "$build_cache") || { say "Could not create a build directory."; exit 1; }
trap 'rm -rf -- "$BUILDDIR"; [[ -n $keepalive_pid ]] && kill "$keepalive_pid" 2>/dev/null' EXIT
export BUILDDIR
# BUILDDIR alone only moves makepkg's own scratch space (src/ and pkg/);
# the finished package itself still defaults to $startdir -- this PKGBUILD's
# own directory, back inside the watched plugin tree -- unless PKGDEST says
# otherwise. That finished file landing there, right as makepkg's own sudo
# pacman -U needs the password, reproduced the exact reload-storm-timed PAM
# failure this was meant to fix, on this project's own test machine.
export PKGDEST="$BUILDDIR"
# Warmed here regardless of whether an earlier step already authenticated,
# so a system with every dependency already satisfied -- which never called
# run_sudo above -- does not hit its very first prompt deep inside makepkg's
# own internal install step at the end of the build.
run_sudo -v || { say "Could not authenticate; nothing was built."; exit 1; }
makepkg -si --needed || { say "The build did not finish; nothing else was changed."; exit 1; }

# --- apply the choices, now that the tool exists --------------------------
head2 "Applying your choices"
# Thunderbird is opt-in, so a yes has to switch it on. Pear stays on unless
# it was declined. Declining both hides the Additional Apps row; saying yes
# to either leaves the row up and sets each switch on its own.
if [[ $want_thunderbird == yes ]]; then
  hyprchroma --target=thunderbird --set-enabled=true --quiet ||
    note "Could not switch Thunderbird on; the panel can do it: open Additional Apps."
else
  hyprchroma --target=thunderbird --set-enabled=false --quiet || true
fi
if [[ $want_pear == no ]]; then
  hyprchroma --target=pear --set-enabled=false --quiet || true
fi
if [[ $want_thunderbird == no && $want_pear == no ]]; then
  hyprchroma framework remove apps ||
    note "Could not hide Additional Apps; Settings can do it."
fi
[[ $want_dark == yes ]] || hyprchroma framework remove dark-reader
# Opt-in, so a yes has to switch it on rather than just leave it listed --
# which "framework restore" does.
if [[ $want_flatpak == yes ]]; then
  hyprchroma framework restore flatpak
else
  hyprchroma framework remove flatpak
fi
if [[ $want_browsers == yes ]]; then
  hyprchroma framework restore browsers
else
  hyprchroma framework remove browsers
fi
# Opt-in like Flatpak: the set first, so switching it on applies that one.
if [[ $want_icons == yes ]]; then
  hyprchroma icons set "$icon_set" >/dev/null 2>&1 ||
    note "Could not choose $icon_set yet (is it installed?); the panel can: open Icons."
  hyprchroma framework restore icons ||
    note "Could not switch Icons on; the panel can do it: open Icons, then press i."
else
  hyprchroma framework remove icons
fi
hyprchroma --restart-mode="$want_restart" >/dev/null ||
  note "Could not save the restart setting; it can be set in the panel: press s."

# Restarted, not only started. "enable --now" starts the service only when it
# is not already running -- on an update it was, so it went on executing the
# version it had loaded, and pacman does not restart a running service either:
# every fix on the service's side looked as if it had not happened at all,
# until the next login. Restarting it is safe: the service is ours, it re-runs
# one quiet sync on the way up, and nothing waits on it staying up meanwhile.
# Reloaded first, so a changed unit -- its sandboxing, say -- is the one the
# restart starts. pacman's own hook reloads user managers after the install;
# this is for when that did not reach this session's.
systemctl --user daemon-reload ||
  note "Could not reload the user service manager; the service may start with its previous settings."
systemctl --user enable hyprchromad.service ||
  note "Could not enable hyprchromad.service; 'systemctl --user status hyprchromad' will say why."
systemctl --user restart hyprchromad.service ||
  note "Could not start hyprchromad.service; 'systemctl --user status hyprchromad' will say why."

# The shell is another matter: it does not notice a changed plugin file, and
# is not restarted here. omarchy restart shell was tried here and pulled back:
# live on this project's own test machine, its relaunch step failed silently
# once, leaving no shell running at all until it was retried by hand -- worse
# than the stale-code problem it exists to fix. Printing the commands and
# leaving them to be run and watched is the safer default until that is
# understood.
head2 "Restart to finish"
cat <<'RESTARTINFO'
Restart your Omarchy shell after closing this window. You can do so from
your terminal: omarchy restart shell
RESTARTINFO

head2 "Done"
say "Anything you left out can be put back from the panel: press s for Settings, then its number."
say ""
read -r -p "Press return to close this window. "
