#!/usr/bin/env bash
# Interactive uninstall for Omarchroma, opened from the panel (Settings, then
# Uninstall) in Omarchy's presented terminal, the same way setup is: it asks
# before every step, says what that step changes, and asks for a password only
# for the steps that remove packages. Nothing is downloaded.
#
# Everything runs from main(), called on the last line, so bash has read the
# whole script before the last step removes the plugin folder this file is in.
set -uo pipefail

# Commands resolve from a fixed, verified set rather than the inherited PATH,
# exactly as in setup.
omarchroma_trusted_path() {
  local directory owner mode trusted="" unmapped="" overflow inside count
  # The overflow uid stands in for an owner this namespace does not map --
  # root's /usr, under systemd's sandboxing. Where it is mapped, as in the host
  # namespace, it is the nobody account, and trusted with nothing.
  if [[ -r /proc/self/uid_map ]] && overflow=$(</proc/sys/kernel/overflowuid); then
    unmapped=$overflow
    while read -r inside _ count; do
      (( overflow >= inside && overflow < inside + count )) && unmapped=""
    done < /proc/self/uid_map
  fi
  for directory in /usr/bin /usr/share/omarchy/bin; do
    [[ -d $directory ]] || continue
    read -r owner mode < <(/usr/bin/stat -Lc '%u %a' "$directory" 2>/dev/null) || continue
    [[ $owner == 0 || ( -n $unmapped && $owner == "$unmapped" ) ]] || continue
    (( (8#$mode & 8#022) == 0 )) || continue
    trusted="${trusted:+$trusted:}$directory"
  done
  printf '%s' "${trusted:-/usr/bin:/usr/share/omarchy/bin}"
}
PATH=$(omarchroma_trusted_path)
export PATH

here=$(cd -- "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/.." && pwd)
plugin_id=io.github.nobledoodle.omarchroma

bold=$'\033[1m'; dim=$'\033[2m'; reset=$'\033[0m'; warn=$'\033[1;33m'
say()  { printf '%s\n' "$*"; }
head2() { printf '\n%s%s%s\n' "$bold" "$*" "$reset"; }
step_number=0
step() { step_number=$((step_number + 1)); head2 "$step_number. $*"; }
note() { printf '%s%s%s\n' "$dim" "$*" "$reset"; }

# Default no, as in setup: holding return through this removes nothing.
ask() {
  local prompt=$1 default=${2:-no} answer
  if [[ $default == yes ]]; then
    read -r -p "$prompt [Y/n]: " answer
    [[ ${answer,,} != n && ${answer,,} != no ]]
  else
    read -r -p "$prompt [y/N]: " answer
    [[ ${answer,,} == y || ${answer,,} == yes ]]
  fi
}

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hyprchroma"
data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/hyprchroma"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/hyprchroma-setup"
hooks=("$HOME/.config/omarchy/hooks/theme-set.d/hyprchroma"
       "$HOME/.config/omarchy/hooks/font-set.d/hyprchroma")
reversal_package=reversal-icon-theme-git
# What setup may have installed for Omarchroma, and what each was for. Only
# offered when it was installed on its own (not pulled in by something else),
# nothing needs it, and Omarchy does not ship it. adw-gtk-theme is not
# Omarchy's -- Omarchy sets plain Adwaita -- so it is offered like the rest;
# yaru-icon-theme and jq are Omarchy's and never are.
helper_packages=(adw-gtk-theme python-pillow python-numpy python-plyvel)
helper_purpose() {
  case $1 in
    adw-gtk-theme) printf '%s' "GTK 3 apps' themed look (Omarchy itself uses plain Adwaita)" ;;
    python-pillow) printf '%s' "Icons: app covers and Yaru's folders" ;;
    python-numpy)  printf '%s' "Icons: tracing Yaru's folders" ;;
    python-plyvel) printf '%s' "Dark Reader in Chromium-based browsers" ;;
  esac
}

# The installed command, or this checkout's own copy when the package is
# already gone: the checkout carries the same helpers, so a restore still works.
hyprchroma_command() {
  if [[ -x /usr/bin/hyprchroma ]]; then
    printf '%s' /usr/bin/hyprchroma
  elif [[ -x $here/bin/hyprchroma && -d $here/lib ]]; then
    printf '%s' "$here/bin/hyprchroma"
  else
    return 1
  fi
}

# Ours only if it is the hook hyprchroma writes: the same file as the
# package's copy, or, with the package gone, one that runs hyprchroma.
our_hook() {
  local hook=$1
  [[ -f $hook && ! -L $hook ]] || return 1
  if [[ -r /usr/share/hyprchroma/hooks/hyprchroma ]]; then
    cmp -s -- /usr/share/hyprchroma/hooks/hyprchroma "$hook"
  else
    cmp -s -- "$here/share/hooks/hyprchroma" "$hook" || grep -q 'hyprchroma --force' -- "$hook"
  fi
}

removable_helper() {
  local package=$1 info
  info=$(LC_ALL=C pacman -Qi -- "$package" 2>/dev/null) || return 1
  grep -q '^Install Reason *: Explicitly installed' <<<"$info" || return 1
  grep -q '^Required By *: None' <<<"$info" || return 1
  ! grep -qxF -- "$package" /usr/share/omarchy/install/*.packages 2>/dev/null
}

# Themes whose own icon setting names Reversal, after the restore: removing
# the package would leave those without their icons.
themes_using_reversal() {
  grep -l -s '^Reversal' "$HOME"/.config/omarchy/themes/*/icons.theme \
    /usr/share/omarchy/themes/*/icons.theme 2>/dev/null |
    sed 's|.*/themes/\([^/]*\)/icons.theme|\1|' | sort -u | paste -sd, - | sed 's/,/, /g'
}

# Each theme still pointing at Omarchroma-Icons after a restore -- its own
# setting lost with a deleted settings folder -- goes back to Yaru: an overlay
# Omarchroma made for a stock theme is removed, so the stock theme's own
# setting applies again; any other theme gets plain Yaru. Then the current
# theme's setting is staged and handed to GTK, and the generated theme goes.
icons_fallback() {
  local themes=$HOME/.config/omarchy/themes file dir slug fixed=0 staged current own
  for file in "$themes"/*/icons.theme; do
    [[ -f $file && ! -L $file ]] || continue
    grep -qx 'Omarchroma-Icons' -- "$file" || continue
    dir=${file%/icons.theme}; slug=${dir##*/}
    if [[ -d /usr/share/omarchy/themes/$slug && $(ls -A -- "$dir") == icons.theme ]]; then
      rm -f -- "$file" && rmdir -- "$dir"
    else
      printf 'Yaru\n' > "$file"
    fi
    fixed=$((fixed + 1))
  done
  staged=$HOME/.local/state/omarchy/current/theme/icons.theme
  if [[ -f $staged ]] && grep -qx 'Omarchroma-Icons' -- "$staged"; then
    current=$(cat -- "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)
    own=$(cat -- "$themes/$current/icons.theme" 2>/dev/null ||
          cat -- "/usr/share/omarchy/themes/$current/icons.theme" 2>/dev/null || echo Yaru)
    printf '%s\n' "$own" > "$staged"
  fi
  if [[ $(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null) == "'Omarchroma-Icons'" ]]; then
    gsettings set org.gnome.desktop.interface icon-theme "$(cat -- "$staged" 2>/dev/null || echo Yaru)" 2>/dev/null
  fi
  [[ -L $HOME/.local/share/icons/Omarchroma-Icons ]] && rm -f -- "$HOME/.local/share/icons/Omarchroma-Icons"
  [[ -d $HOME/.icons/Omarchroma-Icons ]] && rm -rf -- "$HOME/.icons/Omarchroma-Icons"
  (( fixed )) && note "$fixed themes still pointed at Omarchroma's icons with no record of their own; they use Yaru now."
  return 0
}

# Put theming and icons back: from the snapshot, or Omarchy's defaults when
# the snapshot is gone or asked for. Then the icon fallback, either way.
restored=no
run_restore() {
  local mode=$1
  if [[ -z $hc ]]; then
    note "The hyprchroma command is not here, so only the icons can be put back."
  elif "$hc" restore --"$mode"; then
    note "Put back."
  elif [[ $mode == captured ]] && "$hc" restore --stock; then
    note "The snapshot from before Omarchroma was not there; put back to Omarchy's defaults."
  else
    note "Some of it could not be put back; the output above says what."
  fi
  icons_fallback
  restored=yes
}

# Before anything that theming depends on is removed -- hyprchroma, Reversal,
# the helpers, the snapshot itself -- theming and icons are put back if that
# has not happened yet: otherwise apps keep Omarchroma's colors with nothing
# left to change them, and themes point at icons that are gone.
ensure_restored() {
  [[ $restored == yes ]] && return 0
  note "First, your apps' theming and icons are put back (step 2 was skipped):"
  note "removing this would leave Omarchroma's colors with nothing to update them,"
  note "and themes pointing at icons that are gone."
  run_restore captured
}

keepalive_pid=""
run_sudo() {
  sudo "$@" || return $?
  if [[ -z $keepalive_pid ]]; then
    local script_pid=$$
    ( while kill -0 "$script_pid" 2>/dev/null; do sleep 60; sudo -n true 2>/dev/null; done ) >/dev/null 2>&1 &
    keepalive_pid=$!
  fi
}

main() {
  trap '[[ -n $keepalive_pid ]] && kill "$keepalive_pid" 2>/dev/null' EXIT

  if (( EUID == 0 )); then
    say "Run this as yourself, not as root: it changes files in your home folder."
    exit 1
  fi

  local hc="" package_version="" service_state="" hook found_hooks=() helpers=() package
  hc=$(hyprchroma_command) || hc=""
  package_version=$(pacman -Q hyprchroma 2>/dev/null | cut -d' ' -f2)
  service_state=$(systemctl --user is-enabled hyprchromad.service 2>/dev/null || true)
  for hook in "${hooks[@]}"; do our_hook "$hook" && found_hooks+=("$hook"); done
  for package in "${helper_packages[@]}"; do removable_helper "$package" && helpers+=("$package"); done

  cat <<'INTRO'
Omarchroma uninstall

This takes Omarchroma off this computer, one step at a time. Each step says
what it changes and asks first. Return puts your apps' theming and icons back;
at every later step it means no, and nothing in that step is changed. Nothing is downloaded. Your password is asked
for only by the steps that remove packages. Ctrl+C stops at any point.
INTRO

  head2 "Found here"
  say "  Omarchroma panel        $here"
  say "  hyprchroma package      ${package_version:-not installed}"
  say "  Background service      ${service_state:-not set up}"
  say "  Theme hooks             ${#found_hooks[@]} of 2"
  say "  Settings and snapshots  $([[ -d $state_dir ]] && echo "$state_dir" || echo none)"
  pacman -Qq "$reversal_package" &>/dev/null && say "  Reversal icons          $reversal_package (from the AUR)"
  (( ${#helpers[@]} )) && say "  Helper packages         ${helpers[*]}"

  # --- the service -------------------------------------------------------
  if [[ -n $service_state && $service_state != not-found ]]; then
    step "Stop the background service"
    cat <<'STEP'
hyprchromad.service watches for theme changes and re-syncs your apps. Stopping
it first means nothing re-applies a theme while the next step puts things back.
It runs as you, so this needs no password:
  systemctl --user disable --now hyprchromad.service
STEP
    if ask "Stop and disable the service"; then
      systemctl --user disable --now hyprchromad.service &&
        note "Stopped and disabled." ||
        note "systemctl did not finish; 'systemctl --user status hyprchromad' says why."
    else
      note "Skipped; the service keeps running."
    fi
  fi

  # --- put the apps' theming back ----------------------------------------
  step "Put your apps' theming and icons back"
  cat <<'STEP'
Omarchroma changed files in your home folder so apps follow your theme. This
puts them back: GTK and Qt/KDE settings, every theme's icons (back to its own
Yaru), the stylesheets in your browser and Thunderbird profiles, Pear
Desktop's and Dark Reader's colors, and the Flatpak permissions it added.
Only files in your home folder are touched.

  1) As they were before Omarchroma, from the snapshot it took (recommended)
  2) Omarchy's own defaults, ignoring the snapshot
  3) Leave them, keeping hyprchroma installed (removing it, Reversal or the
     settings below still puts them back first)
STEP
  # Return puts them back: an uninstall that leaves Omarchroma's colors and
  # icons behind, with nothing left to update them, is a broken desktop.
  local choice
  read -r -p "Choice (1, 2 or 3) [1]: " choice
  case ${choice:-1} in
    2) run_restore stock ;;
    3) note "Left as they are." ;;
    *) run_restore captured ;;
  esac

  # --- theme hooks -------------------------------------------------------
  if (( ${#found_hooks[@]} )); then
    step "Remove the theme hooks"
    say "Omarchy runs these on every theme and font change to start a sync:"
    printf '  %s\n' "${found_hooks[@]}"
    say "Only these two files are removed; the other hooks in those folders stay."
    if ask "Remove them"; then
      rm -f -- "${found_hooks[@]}" && note "Removed." || note "Could not remove them."
    else
      note "Skipped. Once the package is gone they do nothing, but they stay."
    fi
  fi

  # --- the package -------------------------------------------------------
  if [[ -n $package_version ]]; then
    step "Remove the hyprchroma package"
    cat <<'STEP'
This is the service and its helpers in /usr/bin, /usr/lib/hyprchroma and
/usr/share/hyprchroma. Removing a package needs your password (sudo); pacman
then lists what it removes and asks once more:
  sudo pacman -R hyprchroma
STEP
    if ask "Remove the hyprchroma package"; then
      ensure_restored
      run_sudo pacman -R hyprchroma || note "pacman did not finish; you can run the command above later."
    else
      note "Skipped; the package stays installed."
    fi
  fi

  # --- Reversal ----------------------------------------------------------
  if pacman -Qq "$reversal_package" &>/dev/null; then
    step "Remove the Reversal icons"
    cat <<STEP
Setup installed Reversal from the AUR for Icons. Nothing else in Omarchroma
uses it, but other apps or your own icon settings might. Removing it needs
your password (sudo):
  sudo pacman -R $reversal_package
STEP
    local using
    using=$(themes_using_reversal)
    [[ -n $using ]] && note "These themes name Reversal as their own icons and would fall back to another set: $using"
    if ask "Remove the Reversal icons"; then
      ensure_restored
      run_sudo pacman -R "$reversal_package" || note "pacman did not finish; you can run the command above later."
    else
      note "Skipped; Reversal stays installed."
    fi
  fi

  # --- helper packages ---------------------------------------------------
  if (( ${#helpers[@]} )); then
    step "Remove helper packages"
    say "Setup may have installed these for Omarchroma. Nothing else installed"
    say "needs them, and Omarchy does not ship them, but something you run by hand"
    say "might:"
    for package in "${helpers[@]}"; do
      printf '  %-15s %s\n' "$package" "$(helper_purpose "$package")"
    done
    # Asked now, after the restore step: if GTK still names adw-gtk3, the
    # theming was not put back, and removing the theme leaves GTK 3 apps on
    # the plain default.
    local gtk_now=""
    gtk_now=$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'")
    if [[ " ${helpers[*]} " == *" adw-gtk-theme "* && $gtk_now == adw-gtk3* ]]; then
      note "GTK is still set to $gtk_now, so the theming was not put back above;"
      note "without adw-gtk-theme, GTK 3 apps fall back to the plain default look."
    fi
    say "Removing them needs your password (sudo):"
    say "  sudo pacman -R ${helpers[*]}"
    if ask "Remove them"; then
      ensure_restored
      run_sudo pacman -R "${helpers[@]}" || note "pacman did not finish; you can run the command above later."
    else
      note "Skipped; they stay installed."
    fi
  fi

  # --- settings and snapshots --------------------------------------------
  local leftovers=() path
  for path in "$state_dir" "$data_dir" "$cache_dir"; do [[ -e $path ]] && leftovers+=("$path"); done
  if (( ${#leftovers[@]} )); then
    step "Delete Omarchroma's settings and snapshots"
    say "These hold your Omarchroma choices, generated colors and icons, and the"
    say "snapshot of your settings from before Omarchroma:"
    printf '  %s\n' "${leftovers[@]}"
    say "Keep them to reinstall later with the same choices, or to put your apps'"
    say "theming back later. Deleted, they cannot be brought back."
    if ask "Delete them"; then
      ensure_restored
      rm -rf -- "${leftovers[@]}" && note "Deleted." || note "Some could not be deleted."
    else
      note "Skipped; they stay."
    fi
  fi

  # --- the panel ---------------------------------------------------------
  step "Remove the Omarchroma panel"
  cat <<STEP
Last, the panel itself: Omarchy unloads it from the bar and deletes its folder,
which holds this script:
  omarchy plugin remove $plugin_id
STEP
  local removed_panel=no
  if [[ ! -d $HOME/.config/omarchy/plugins/$plugin_id ]]; then
    note "Not installed in your Omarchy plugins; nothing to remove."
  elif ask "Remove the panel"; then
    omarchy plugin remove "$plugin_id" --yes && removed_panel=yes ||
      note "Could not remove it; you can run the command above later."
  else
    note "Skipped; the panel stays on the bar."
  fi

  head2 "Done"
  if [[ $removed_panel == yes ]]; then
    say "Restart your Omarchy shell to clear it from memory: omarchy restart shell"
  else
    say "Anything skipped can be done later, from the panel or with the commands above."
  fi
  say ""
  read -r -p "Press return to close this window. "
}

main "$@"
exit
