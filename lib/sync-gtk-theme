# The colors go in a file of our own, and gtk.css is only made to reference
# it. Taking gtk.css over meant a user's own rules there stopped applying the
# moment this was installed and were overwritten on every theme change; now
# they sit below the import and override it, which is the right way round.
import_line='@import url("hyprchroma.css");'
# Each of the four is skipped when it already holds what it should: a sync
# with the palette unchanged -- a forced one, or one another framework set
# off -- started the helper four times to rewrite identical files. Read only
# when a regular file: a fifo planted in its place would block the read.
write_if_changed() {
  if [[ -f $1 && ! -L $1 && $2 == "$(cat -- "$1" 2>/dev/null)" ]]; then
    return 0
  fi
  printf '%s\n' "$2" | "$HYPRCHROMA_LIB/hyprchroma-state" write-file --path "$1" --mode 644
}
import_if_missing() {
  if [[ -f $1 ]] && grep -qF -- "$import_line" "$1" 2>/dev/null; then
    return 0
  fi
  "$HYPRCHROMA_LIB/hyprchroma-state" ensure-import --path "$1" --line "$import_line" >/dev/null
}
write_if_changed "$gtk3_dir/hyprchroma.css" "$gtk3_css"
write_if_changed "$gtk4_dir/hyprchroma.css" "$gtk4_css"
import_if_missing "$gtk3_dir/gtk.css"
import_if_missing "$gtk4_dir/gtk.css"
trap - EXIT

# Setting a theme that is not installed leaves GTK 3 falling back to its
# default, which looks like this simply did not work. Say so instead.
if gtk_theme_installed "$gtk_theme"; then
  set_interface gtk-theme "$gtk_theme"
else
  echo "sync-gtk-theme: $gtk_theme is not installed; GTK 3 apps will not follow the theme" >&2
  echo "sync-gtk-theme: install adw-gtk-theme to fix that" >&2
fi
set_interface color-scheme "$color_scheme"
set_interface accent-color "$gnome_accent"

icon_theme=$(omarchy_icon_theme sync-gtk-theme)
if [[ -n $icon_theme ]]; then
  set_interface icon-theme "$icon_theme"
fi

# Only the family follows Omarchy; the point size stays whatever the user chose.
monospace_font=$(omarchy_font)
if [[ -n $monospace_font ]]; then
  current_monospace=$(gsettings get org.gnome.desktop.interface monospace-font-name 2>/dev/null || printf "''")
  current_monospace=${current_monospace#\'}
  current_monospace=${current_monospace%\'}
  monospace_size=${current_monospace##* }
  [[ $monospace_size =~ ^[0-9]+$ ]] || monospace_size=11
  set_interface monospace-font-name "$monospace_font $monospace_size"
fi
