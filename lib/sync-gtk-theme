gsettings set org.gnome.desktop.interface color-scheme "$color_scheme"
gsettings set org.gnome.desktop.interface accent-color "$gnome_accent"

icon_theme=$(omarchy_icon_theme sync-gtk-theme)
if [[ -n $icon_theme ]]; then
  gsettings set org.gnome.desktop.interface icon-theme "$icon_theme"
fi

# Only the family follows Omarchy; the point size stays whatever the user chose.
monospace_font=$(omarchy_font)
if [[ -n $monospace_font ]]; then
  current_monospace=$(gsettings get org.gnome.desktop.interface monospace-font-name 2>/dev/null || printf "''")
  current_monospace=${current_monospace#\'}
  current_monospace=${current_monospace%\'}
  monospace_size=${current_monospace##* }
  [[ $monospace_size =~ ^[0-9]+$ ]] || monospace_size=11
  gsettings set org.gnome.desktop.interface monospace-font-name \
    "$monospace_font $monospace_size"
fi
