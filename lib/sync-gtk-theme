#!/usr/bin/env bash

set -euo pipefail

# Commands are resolved from a fixed, verified set of directories rather than
# from whatever PATH was inherited. Most of these scripts run unattended --
# from the shell service and from theme hooks -- so a directory someone else
# can write to appearing earlier in PATH would hand them every command run
# here; the installer and uninstaller pin it for the same reason even though
# a person starts those.
# /usr/local/bin and /usr/local/sbin are not in the set -- nothing this plugin
# invokes lives there, and they are the entries most often left group-writable
# on a real machine -- and /bin, /sbin and /usr/sbin are usrmerge symlinks to
# /usr/bin that add nothing. What is left is checked to be root-owned and
# unwritable by anyone else rather than assumed to be. /usr/bin/stat is named
# absolutely because it is the trust root the check is anchored to: if it
# cannot be trusted, nothing here can be.
hyprchroma_trusted_path() {
  local directory owner mode trusted=""
  for directory in /usr/bin /usr/share/omarchy/bin; do
    [[ -d $directory ]] || continue
    read -r owner mode < <(/usr/bin/stat -Lc '%u %a' "$directory" 2>/dev/null) || continue
    # Root, or an owner not mapped into this namespace: under systemd's
    # sandboxing /usr reports the overflow uid rather than root.
    [[ $owner == 0 || $owner == "$(</proc/sys/kernel/overflowuid)" ]] || continue
    (( (8#$mode & 8#022) == 0 )) || continue
    trusted="${trusted:+$trusted:}$directory"
  done
  # With stat itself unavailable there is nothing to validate against, so fall
  # back to the same fixed identities rather than to the inherited PATH.
  printf '%s' "${trusted:-/usr/bin:/usr/share/omarchy/bin}"
}
PATH=$(hyprchroma_trusted_path)
export PATH

# Derived from this script's own resolved location, never from the
# environment: it chooses which executable performs every write. See the same
# reasoning in bin/hyprchroma.
HYPRCHROMA_LIB=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")


# The palette is resolved once and kept, not asked for a key at a time: each
# call costs a process start, and a full sync reads more than fifty keys.
declare -A PALETTE
PALETTE_LOADED=0

load_palette() {
  local key value
  # The sync hands over the palette it has just resolved; this resolves its
  # own only when run on its own. Every value is checked as #rrggbb by color()
  # either way, so what arrives here can choose colors and nothing else.
  while IFS=$'\t' read -r key value; do
    [[ -n $key ]] && PALETTE[$key]=$value
  done < <(if [[ -n ${HYPRCHROMA_PALETTE_TSV:-} ]]; then
             printf '%s\n' "$HYPRCHROMA_PALETTE_TSV"
           else
             "$HYPRCHROMA_LIB/hyprchroma-palette" --all 2>&1
           fi)
  if [[ -z ${PALETTE[background]:-} ]]; then
    echo "sync-gtk-theme: no palette available; see 'hyprchroma palette --template'" >&2
    exit 1
  fi
  PALETTE_LOADED=1
}

color() {
  # Deliberately does not load: every call site is $(color x), which runs in a
  # subshell, so anything this set would be discarded and the palette would be
  # re-resolved once per key. The caller loads it once, in the parent shell.
  local value=${PALETTE[$1]:-}
  if [[ ! $value =~ ^#[0-9A-Fa-f]{6}$ ]]; then
    echo "sync-gtk-theme: invalid palette color '$1': $value" >&2
    exit 1
  fi
  printf '%s' "$value"
}

palette_mode() {
  [[ ${PALETTE[mode]:-dark} == light ]] && printf 'light' || printf 'dark'
}

rgb() {
  local hex=${1#\#}
  printf '%d, %d, %d' \
    "$((16#${hex:0:2}))" \
    "$((16#${hex:2:2}))" \
    "$((16#${hex:4:2}))"
}

contrasting_fg() {
  local color=${1#\#}
  local red=$((16#${color:0:2}))
  local green=$((16#${color:2:2}))
  local blue=$((16#${color:4:2}))

  if (( red * 299 + green * 587 + blue * 114 > 150000 )); then
    printf '%s' "$darker_background"
  else
    printf '%s' "$bright_foreground"
  fi
}

# Omarchy themes each name an icon theme in icons.theme, but nothing in Omarchy
# applies it, so KDE and GTK drift apart or fall back to whatever was set last.
omarchy_icon_theme() {
  local name_file="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme.name"
  [[ -f $name_file ]] || return 0
  local slug directory value
  slug=$(tr -d "\\n" <"$name_file")
  [[ -n $slug ]] || return 0
  directory=$(omarchy theme dir "$slug" 2>/dev/null) || return 0
  [[ -f "$directory/icons.theme" ]] || return 0
  value=$(tr -d "\\n" <"$directory/icons.theme")
  [[ $value =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 0
  # A theme may name an icon set that is not installed; the stock vantablack and
  # white themes both do. Applying one would leave apps with no icons at all.
  [[ -d "/usr/share/icons/$value" || \
     -d "${XDG_DATA_HOME:-$HOME/.local/share}/icons/$value" ]] || {
    printf "%s: Omarchy theme requests icon theme '%s', which is not installed\\n" \
      "$1" "$value" >&2
    return 0
  }
  printf "%s" "$value"
}

# Omarchy owns the monospace font (omarchy font set), but it only rewrites
# terminal configs and fontconfig -- it never touches gsettings, so the GTK
# monospace font goes stale the moment the font changes.
omarchy_font() {
  local value
  value=$(omarchy font current 2>/dev/null) || return 0
  value=${value//$'\n'/}
  [[ -n $value ]] || return 0
  [[ $value =~ ^[A-Za-z0-9][A-Za-z0-9\ ._-]*$ ]] || return 0
  printf '%s' "$value"
}

# A theme only counts as available if it is on disk somewhere GTK looks,
# rather than merely named.
gtk_theme_installed() {
  local name=$1 base entry
  for base in "$HOME/.themes" "${XDG_DATA_HOME:-$HOME/.local/share}/themes" \
              /usr/share/themes /usr/local/share/themes; do
    [[ -d $base/$name ]] && return 0
  done
  local -a extra
  IFS=':' read -ra extra <<< "${XDG_DATA_DIRS:-}"
  for entry in "${extra[@]:-}"; do
    [[ -n $entry && -d $entry/themes/$name ]] && return 0
  done
  return 1
}

# gsettings needs its schemas installed. Where they are not, writing the key
# through dconf still works, and doing nothing at all would be worse.
set_interface() {
  local key=$1 value=$2
  if gsettings writable org.gnome.desktop.interface "$key" >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface "$key" "$value" && return 0
  fi
  command -v dconf >/dev/null 2>&1 || return 0
  dconf write "/org/gnome/desktop/interface/${key}" "'$value'" 2>/dev/null || true
}

load_palette
background=$(color background)
dark_background=$(color dark_background)
darker_background=$(color darker_background)
lighter_background=$(color lighter_background)
foreground=$(color foreground)
dark_foreground=$(color dark_foreground)
light_foreground=$(color light_foreground)
bright_foreground=$(color bright_foreground)
accent=$(color accent)
selection=$(color selection)
selection_foreground=$(color selection_foreground)
muted=$(color muted)
red=$(color red)
bright_red=$(color bright_red)
green=$(color green)
bright_green=$(color bright_green)
yellow=$(color yellow)
bright_yellow=$(color bright_yellow)
mode=$(palette_mode)

if [[ $mode != "dark" && $mode != "light" ]]; then
  echo "sync-gtk-theme: invalid Omarchy mode: $mode" >&2
  exit 1
fi

darker_rgb=$(rgb "$darker_background")
bright_rgb=$(rgb "$bright_foreground")
accent_foreground=$(contrasting_fg "$accent")
red_foreground=$(contrasting_fg "$red")
green_foreground=$(contrasting_fg "$green")
yellow_foreground=$(contrasting_fg "$yellow")

hex=${accent#\#}
red_channel=$((16#${hex:0:2}))
green_channel=$((16#${hex:2:2}))
blue_channel=$((16#${hex:4:2}))

gnome_accent=$(awk -v r="$red_channel" -v g="$green_channel" -v b="$blue_channel" '
  function max3(a, b, c) {
    return a > b ? (a > c ? a : c) : (b > c ? b : c)
  }
  function min3(a, b, c) {
    return a < b ? (a < c ? a : c) : (b < c ? b : c)
  }
  function hue(red, green, blue, maximum, minimum, delta, value) {
    maximum = max3(red, green, blue)
    minimum = min3(red, green, blue)
    delta = maximum - minimum
    if (delta == 0) return -1
    if (maximum == red)
      value = 60 * ((green - blue) / delta)
    else if (maximum == green)
      value = 60 * (((blue - red) / delta) + 2)
    else
      value = 60 * (((red - green) / delta) + 4)
    return value < 0 ? value + 360 : value
  }
  BEGIN {
    names[1] = "blue";   colors[1] = "53 132 228"
    names[2] = "teal";   colors[2] = "33 144 164"
    names[3] = "green";  colors[3] = "58 148 74"
    names[4] = "yellow"; colors[4] = "200 136 0"
    names[5] = "orange"; colors[5] = "237 91 0"
    names[6] = "red";    colors[6] = "230 45 66"
    names[7] = "pink";   colors[7] = "213 97 153"
    names[8] = "purple"; colors[8] = "145 65 172"
    names[9] = "slate";  colors[9] = "111 131 150"

    target_max = max3(r, g, b)
    target_min = min3(r, g, b)
    if (target_max == 0 || (target_max - target_min) / target_max < 0.12) {
      print "slate"
      exit
    }

    target_hue = hue(r, g, b)
    best_distance = -1
    for (i = 1; i <= 9; i++) {
      split(colors[i], candidate, " ")
      distance = target_hue - hue(candidate[1], candidate[2], candidate[3])
      if (distance < 0) distance = -distance
      if (distance > 180) distance = 360 - distance
      if (best_distance < 0 || distance < best_distance) {
        best_distance = distance
        best_name = names[i]
      }
    }
    print best_name
  }
')

if [[ $mode == "light" ]]; then
  gtk_theme="adw-gtk3"
  color_scheme="prefer-light"
else
  gtk_theme="adw-gtk3-dark"
  color_scheme="prefer-dark"
fi

gtk3_dir="$HOME/.config/gtk-3.0"
gtk4_dir="$HOME/.config/gtk-4.0"
mkdir -p "$gtk3_dir" "$gtk4_dir"

