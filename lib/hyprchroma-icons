def _index_theme(inherits: str) -> str:
    return (
        "[Icon Theme]\n"
        f"Name={THEME_NAME}\n"
        f"Comment={inherits} with folders and app covers from Omarchroma\n"
        f"Inherits={inherits},hicolor\n"
        "Example=folder\n"
        "Directories=apps/scalable,places/scalable\n\n"
        "[apps/scalable]\nSize=64\nContext=Applications\nMinSize=16\nMaxSize=512\nType=Scalable\n\n"
        "[places/scalable]\nSize=64\nContext=Places\nMinSize=16\nMaxSize=512\nType=Scalable\n"
    )


def _link_dir_contents(source: Path, destination: Path) -> None:
    """destination holds exactly one relative symlink per .svg in source."""
    if destination.is_symlink():
        remove_entry(destination)
    make_dir(destination)
    live = {path.name for path in source.iterdir() if path.suffix == ".svg"} if source.is_dir() else set()
    for existing in destination.iterdir():
        if existing.name not in live:
            remove_entry(existing)
    for name in live:
        link = destination / name
        target = os.path.relpath(source / name, destination)
        if not (link.is_symlink() and os.readlink(link) == target):
            replace_symlink(link, target)


def theme_dir() -> Path:
    return private_icons() / THEME_NAME


def inherited_base() -> str:
    match = re.search(r"^Inherits=([^,\n]+)", _read(theme_dir() / "index.theme"), re.M)
    return match.group(1).strip() if match else ""


def install_theme(base: str) -> bool:
    """Build ~/.icons/Omarchroma-Icons inheriting base; True when Inherits= changed.

    The tree lives in ~/.icons, which the app menu scans before hicolor; a
    directory symlink in ~/.local/share/icons lets Qt/KDE (Omarchroma's own
    KDE icon list among them) find it by name without the menu seeing it twice."""
    changed = inherited_base() != base
    _link_dir_contents(cover_store(), theme_dir() / "apps" / "scalable")
    _link_dir_contents(place_store(), theme_dir() / "places" / "scalable")
    write_if_changed(theme_dir() / "index.theme", _index_theme(base), 0o644)
    link = public_icons() / THEME_NAME
    target = os.path.relpath(theme_dir(), public_icons())
    if not (link.is_symlink() and os.readlink(link) == target):
        if link.is_symlink() or not link.exists():
            replace_symlink(link, target)
    return changed


def refresh_icon_cache() -> None:
    tool = shutil.which("gtk-update-icon-cache")
    if tool and (theme_dir() / "index.theme").is_file():
        subprocess.run([tool, "-f", "-t", "-q", str(theme_dir())], check=False, capture_output=True)


# Each theme's own icons.theme, saved before it is first pointed elsewhere --
# themes added later included -- so switching Icons off puts back exactly what
# each theme had, and removes what it did not have.
def _backup_dir() -> Path:
    return state_dir() / "icons-theme-backup"


def _backup_manifest() -> dict:
    manifest = read_json_file(_backup_dir() / "manifest.json", {})
    for key in ("files", "created", "overlays"):
        if not isinstance(manifest.get(key), list):
            manifest[key] = []
    return manifest


def _remember_original(manifest: dict, slug: str, path: Path, overlay: bool) -> bool:
    known = slug in manifest["files"] or slug in manifest["created"]
    if known:
        return False
    if path.is_file() and not path.is_symlink():
        write_text(_backup_dir() / slug / "icons.theme", _read(path, 4096), 0o644)
        manifest["files"].append(slug)
    else:
        manifest["created"].append(slug)
    if overlay and slug not in manifest["overlays"]:
        manifest["overlays"].append(slug)
    return True


def write_theme_pointers(base_changed: bool) -> None:
    """Point every Omarchy theme, the staged current theme and GTK at the generated theme.

    The name never changes, so GTK would not notice a new Inherits= line; when
    it changed, gsettings goes to the base for a moment and back, which makes
    running GTK apps load the theme again."""
    manifest = _backup_manifest()
    dirty = False
    if "gsettings" not in manifest:
        manifest["gsettings"] = gsettings_get()
        dirty = True
    pointer = THEME_NAME + "\n"
    for slug in theme_slugs():
        directory = user_themes() / slug
        overlay = not directory.exists()
        if overlay and not (stock_themes() / slug).is_dir():
            continue
        path = directory / "icons.theme"
        if _read(path) == pointer:
            # Already pointing here with no record of what it was (the state
            # folder was removed): there is no original to put back, so switching
            # off removes the pointer and Omarchy's own (if any) shows again.
            if slug not in manifest["files"] and slug not in manifest["created"]:
                manifest["created"].append(slug)
                if not any(p.name != "icons.theme" for p in directory.iterdir()) and (stock_themes() / slug).is_dir():
                    manifest["overlays"].append(slug)
                dirty = True
            continue
        dirty |= _remember_original(manifest, slug, path, overlay)
        make_dir(directory)
        write_text(path, pointer, 0o644)
    staged = omarchy_current() / "theme" / "icons.theme"
    if staged.parent.is_dir() and _read(staged) != pointer:
        if "staged" not in manifest:
            manifest["staged"] = staged.is_file()
            if staged.is_file():
                write_text(_backup_dir() / "staged-icons.theme", _read(staged, 4096), 0o644)
            dirty = True
        write_text(staged, pointer, 0o644)
    if dirty:
        write_json_file(_backup_dir() / "manifest.json", manifest)
    if base_changed or gsettings_get() != THEME_NAME:
        nudge_gtk()


# ------------------------------------------------- telling running apps --

def _session_env() -> dict[str, str]:
    env = dict(os.environ)
    if not env.get("DBUS_SESSION_BUS_ADDRESS"):
        runtime = env.get("XDG_RUNTIME_DIR", "")
        if runtime.startswith("/") and os.path.exists(f"{runtime}/bus"):
            env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={runtime}/bus"
    return env


def gsettings_get() -> str:
    if isolated():
        return ""
    try:
        result = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "icon-theme"],
                                check=True, capture_output=True, text=True, env=_session_env(), timeout=5)
    except (OSError, subprocess.SubprocessError):
        return ""
    return result.stdout.strip().strip("'\"")


def gsettings_set(name: str) -> None:
    if isolated() or not re.match(r"^[A-Za-z0-9][A-Za-z0-9._ -]{0,63}$", name or ""):
        return
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", name],
                   check=False, capture_output=True, env=_session_env(), timeout=5)


def nudge_gtk() -> None:
    """Running GTK apps reload an icon theme only when its name changes. This one's
    name never does, so going to the base set for a moment and back is what
    makes them repaint folders and app icons now."""
    base = inherited_base()
    if base and gsettings_get() == THEME_NAME:
        gsettings_set(base)
    gsettings_set(THEME_NAME)


def nudge_kde() -> None:
    """KIconLoader in every running KDE app reloads its icons on this signal --
    what System Settings sends after an icon change. Best-effort: no KDE app
    listening is the ordinary case."""
    if isolated() or not shutil.which("gdbus"):
        return
    subprocess.run(["gdbus", "emit", "--session", "--object-path", "/KIconLoader",
                    "--signal", "org.kde.KIconLoader.iconChanged", "0"],
                   check=False, capture_output=True, env=_session_env(), timeout=5)


# ---------------------------------------------------------------- status --

def last_apply() -> dict:
    return read_json_file(state_dir() / "last-apply.json", {})


def write_status(palette: dict | None = None, **extra) -> dict:
    """What the panel shows. Rewritten after every recolor and around every apply."""
    previous = read_json_file(state_dir() / "status.json", {})
    slug = current_theme_slug()
    current = settings()
    chosen_set = str(current["icon_set"])
    palette = palette or folder_palette(slug)
    status = {
        **{key: palette[key] for key in ("mode", "face", "shade", "source", "slug")},
        "icon_set": chosen_set,
        "covers": current["covers"],
        "sets": {name: {"label": SET_LABELS[name], "installed": set_installed(name)} for name in ICON_SETS},
        "modes": {name: {"face": folder_palette(slug, name, chosen_set)["face"], "source": mode_source(slug, name)}
                  for name in FOLDER_MODES},
        "theme": THEME_NAME,
        "applying": bool(previous.get("applying", False)),
        "error": str(previous.get("error", ""))[:200],
        "last_apply": last_apply(),
        "base": inherited_base() or (base_theme_for(slug, chosen_set) if slug else ""),
        "active": theme_dir().is_dir(),
    }
    status.update(extra)
    write_json_file(state_dir() / "status.json", status)
    return status


# ------------------------------------------------------------------ apply --

def apply(slug: str = "") -> dict:
    """The whole framework, for the active theme: folders first (what shows at
    once), then app covers, the generated theme, every theme's pointer, and a
    nudge so running apps repaint."""
    chosen_set = icon_set()
    if not set_installed(chosen_set):
        message = f"{SET_LABELS[chosen_set]} is not installed"
        write_status(applying=False, error=message)
        raise MissingSet(message)
    write_status(applying=True, error="")
    try:
        with Lock("apply.lock"):
            if chosen_set == "reversal":
                ensure_reversal_sage()
            slug = valid_slug(slug) or current_theme_slug()
            palette = recolor_folders(slug)
            counts = generate(cover_store(), bool(settings()["covers"]), chosen_set)
            base = base_theme_for(slug, chosen_set) if slug else (
                "Yaru-dark" if chosen_set == "yaru" else "Reversal-dark")
            base_changed = install_theme(base)
            refresh_icon_cache()
            write_theme_pointers(base_changed or "written" in palette)
            if base_changed or "written" in palette:
                nudge_kde()
    except BaseException as error:
        write_status(applying=False, error=str(error) or type(error).__name__)
        raise
    summary = {"theme": THEME_NAME, "base": base, "slug": slug, "icon_set": chosen_set,
               "folders": palette["mode"], "face": palette["face"],
               "changed": bool(base_changed or "written" in palette),
               "applied_at": int(time.time()), **counts}
    write_json_file(state_dir() / "last-apply.json", summary)
    write_status(palette, applying=False, error="")
    return summary


def set_folders(mode: str, apply_now: bool) -> dict:
    """Choose the folder color source; recolor at once when the framework is on."""
    if mode == "next":
        order = FOLDER_MODES
        mode = order[(order.index(folder_mode()) + 1) % len(order)]
    if mode not in FOLDER_MODES:
        raise SystemExit("folder color must be background, accent, border, yaru or next")
    save_setting("folder_mode", mode)
    if not apply_now:
        return write_status()
    if not set_installed(icon_set()):
        return write_status(error=f"{SET_LABELS[icon_set()]} is not installed")
    palette = recolor_folders(current_theme_slug(), mode)
    if "written" in palette:
        nudge_gtk()
        nudge_kde()
    return write_status(palette, error="")


def revert() -> None:
    """Put every theme's icons.theme back as it was, and take the generated theme away.

    The base sets themselves stay installed; so does the sage variant, which is
    an ordinary Reversal theme of its own."""
    with Lock("apply.lock"):
        backup = _backup_dir()
        manifest = _backup_manifest()
        for slug in manifest["files"]:
            if not valid_slug(slug):
                continue
            saved = backup / slug / "icons.theme"
            destination = user_themes() / slug / "icons.theme"
            if saved.is_file() and destination.parent.is_dir():
                write_text(destination, _read(saved, 4096), 0o644)
        for slug in manifest["created"]:
            path = user_themes() / slug / "icons.theme"
            if valid_slug(slug) and _read(path).strip() == THEME_NAME:
                remove_entry(path)
        for slug in manifest["overlays"]:
            directory = user_themes() / slug
            if valid_slug(slug) and directory.is_dir() and not directory.is_symlink():
                try:
                    directory.rmdir()
                except OSError:
                    pass  # something else of the user's is in it now
        staged = omarchy_current() / "theme" / "icons.theme"
        if staged.parent.is_dir() and _read(staged).strip() == THEME_NAME:
            if (backup / "staged-icons.theme").is_file():
                write_text(staged, _read(backup / "staged-icons.theme", 4096), 0o644)
            else:
                remove_entry(staged)
        originals = read_json_file(state_dir() / "absolute-icons.json", {})
        for path_text, icon in originals.items():
            path = Path(path_text)
            if not isinstance(icon, str) or "\n" in icon or path.is_symlink() or not path.is_file():
                continue
            try:
                path.relative_to(home())
            except ValueError:
                continue
            text = _read(path, 1 << 18)
            match = re.search(r"^Icon=.*$", text, re.M)
            if match:
                write_text(path, text[:match.start()] + "Icon=" + icon + text[match.end():])
        link = public_icons() / THEME_NAME
        if link.is_symlink():
            remove_entry(link)
        remove_tree(theme_dir())
        remove_tree(data_dir())
        for name in ("absolute-icons.json", "absolute-sources.json", "cache.json", "folder-stamp",
                     "last-apply.json"):
            remove_entry(state_dir() / name)
        saved_gsettings = manifest.get("gsettings")
        if isinstance(saved_gsettings, str) and saved_gsettings and saved_gsettings != THEME_NAME:
            gsettings_set(saved_gsettings)
        # Forget the baseline: the next time Icons is switched on, what each
        # theme has then is what it goes back to.
        remove_tree(backup)
    write_status(applying=False, error="")


class MissingSet(SystemExit):
    pass


# ------------------------------------------------------------ vectorize --
# Yaru's folders are flat color regions (rim, tab, face, top highlight,
# engraved emblem), so each traces cleanly: classify every pixel of the 512px
# artwork by nearest role color, stack the roles as nested masks, and trace
# each mask with marching squares. One fill per role keeps recoloring a plain
# hex replacement, as it is for Reversal. numpy and PIL load only here.

TRACE_VERSION = 1
# Yaru (orange) role colors, measured from 256x256@2x/places/folder.png and
# folder-music.png, in paint order.
ROLES = {
    "rim": "#822514",
    "tab": "#a22805",
    "face": "#da5b2a",
    "highlight": "#e17c55",
    "emblem": "#731505",
    "emblem-deep": "#550805",
}
# Each layer is its own role plus every role painted above it inside it, so
# stacked layers leave no seams.
_LAYERS = (
    ("rim", None),
    ("tab", ("tab", "face", "highlight", "emblem", "emblem-deep")),
    ("face", ("face", "highlight", "emblem", "emblem-deep")),
    ("highlight", ("highlight",)),
    ("emblem", ("emblem", "emblem-deep")),
    ("emblem-deep", ("emblem-deep",)),
)
# Share of opaque pixels that must sit near a role color: icons with other
# artwork (Dropbox, the distributor logo) are not folders.
_MIN_FIT = 0.97


def _numpy():
    try:
        import numpy
    except ImportError as error:
        raise SystemExit("python-numpy is not installed; Yaru folders need it") from error
    return numpy


def classify(image):
    np = _numpy()
    data = np.asarray(image.convert("RGBA"), dtype=np.float32)
    alpha = data[..., 3] / 255.0
    palette = np.stack([np.array([int(v[i:i + 2], 16) for i in (1, 3, 5)], dtype=np.float32)
                        for v in ROLES.values()])
    distance = np.linalg.norm(data[..., :3][..., None, :] - palette[None, None, :, :], axis=-1)
    roles = distance.argmin(axis=-1)
    solid = alpha > 0.9
    fit = float((distance.min(axis=-1)[solid] < 40).mean()) if solid.any() else 0.0
    return alpha, roles, fit


def _soften(mask):
    np = _numpy()
    field = np.pad(mask.astype(np.float32), 1, mode="edge")
    kernel = (1.0, 2.0, 1.0)
    rows = sum(weight * field[:, i:i + mask.shape[1]] for i, weight in enumerate(kernel)) / 4.0
    return sum(weight * rows[i:i + mask.shape[0], :] for i, weight in enumerate(kernel)) / 4.0


def contours(field, level: float = 0.5) -> list[list[tuple[float, float]]]:
    """Closed iso-lines of a 2D field (marching squares), in pixel-center coordinates."""
    np = _numpy()
    f = np.pad(field.astype(np.float32), 1, mode="constant", constant_values=0.0)
    inside = f > level
    case = (inside[:-1, :-1].astype(np.uint8) * 8 + inside[:-1, 1:] * 4
            + inside[1:, 1:] * 2 + inside[1:, :-1])
    cells = np.argwhere((case != 0) & (case != 15))

    def point(edge):
        kind, y, x = edge
        if kind == "h":
            a, b = f[y, x], f[y, x + 1]
            t = (level - a) / (b - a) if b != a else 0.5
            return (x + t - 1, y - 1)
        a, b = f[y, x], f[y + 1, x]
        t = (level - a) / (b - a) if b != a else 0.5
        return (x - 1, y + t - 1)

    links: dict[tuple, list[tuple]] = {}

    def join(a, b):
        links.setdefault(a, []).append(b)
        links.setdefault(b, []).append(a)

    for y, x in cells:
        c = int(case[y, x])
        top, right, bottom, left = ("h", y, x), ("v", y, x + 1), ("h", y + 1, x), ("v", y, x)
        if c in (1, 14):
            join(left, bottom)
        elif c in (2, 13):
            join(bottom, right)
        elif c in (3, 12):
            join(left, right)
        elif c in (4, 11):
            join(top, right)
        elif c in (6, 9):
            join(top, bottom)
        elif c in (7, 8):
            join(left, top)
        else:  # saddles 5 and 10: the cell center decides
            center = (f[y, x] + f[y, x + 1] + f[y + 1, x] + f[y + 1, x + 1]) / 4 > level
            if (c == 5) == center:
                join(left, top)
                join(bottom, right)
            else:
                join(left, bottom)
                join(top, right)

    loops, seen = [], set()
    for start in links:
        if start in seen:
            continue
        loop, previous, current = [start], None, start
        seen.add(start)
        while True:
            options = [edge for edge in links[current] if edge != previous and edge not in seen]
            if not options:
                break
            previous, current = current, options[0]
            seen.add(current)
            loop.append(current)
        if len(loop) >= 3:
            loops.append([point(edge) for edge in loop])
    return loops


def simplify(points, epsilon: float):
    """Ramer-Douglas-Peucker on a closed loop."""
    np = _numpy()
    if len(points) < 4:
        return points
    array = np.array(points, dtype=np.float64)
    far = int(np.hypot(*(array - array[0]).T).argmax())
    closed = np.vstack([array, array[:1]])

    def rdp(start, end, keep):
        if end - start < 2:
            return
        a, b = closed[start], closed[end]
        rel = closed[start + 1:end] - a
        dx, dy = b - a
        length = float(np.hypot(dx, dy))
        distance = np.hypot(rel[:, 0], rel[:, 1]) if length == 0 else np.abs(dx * rel[:, 1] - dy * rel[:, 0]) / length
        index = int(distance.argmax())
        if distance[index] > epsilon:
            middle = start + 1 + index
            rdp(start, middle, keep)
            keep.append(middle)
            rdp(middle, end, keep)

    keep = [0, far]
    rdp(0, far, keep)
    rdp(far, len(points), keep)
    return [tuple(closed[i]) for i in sorted(set(keep)) if i < len(points)]


def _path(loops) -> str:
    parts = []
    for loop in loops:
        points = simplify(loop, 0.35)
        if len(points) >= 3:
            parts.append("M" + " ".join(f"{x + 0.5:.1f},{y + 0.5:.1f}" for x, y in points) + "Z")
    return "".join(parts)


def vectorize(source: Path) -> str | None:
    """SVG for a Yaru folder PNG, or None when the artwork is not a flat folder."""
    np = _numpy()
    Image = _pil()[0]
    image = Image.open(source)
    if image.size[0] < 256 or image.size[0] > 2048:
        return None
    alpha, roles, fit = classify(image)
    if fit < _MIN_FIT:
        return None
    names, size, solid = list(ROLES), image.size[0], alpha > 0.5
    silhouette = _path(contours(alpha))
    body = [  # Yaru's soft shadow, as two offset copies of the silhouette.
        f'<path d="{silhouette}" fill="#000000" fill-opacity="0.10" fill-rule="evenodd" transform="translate(0 {size * 0.012:.1f})"/>',
        f'<path d="{silhouette}" fill="#000000" fill-opacity="0.08" fill-rule="evenodd" transform="translate(0 {size * 0.004:.1f})"/>',
    ]
    for role, members in _LAYERS:
        if members is None:
            data = silhouette
        else:
            mask = np.isin(roles, [names.index(name) for name in members]) & solid
            if not mask.any():
                continue
            data = _path(contours(_soften(mask)))
        if data:
            body.append(f'<path d="{data}" fill="{ROLES[role]}" fill-rule="evenodd"/>')
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="{size}" height="{size}" viewBox="0 0 {size} {size}">\n'
            f"<!-- Traced by Omarchroma from Yaru ({source.name}). Yaru: CC BY-SA 4.0, Ubuntu community. -->\n"
            + "\n".join(body) + "\n</svg>\n")


# -------------------------------------------------------------------- cli --

def main() -> int:
    parser = argparse.ArgumentParser(prog="hyprchroma-icons")
    sub = parser.add_subparsers(dest="command", required=True)
    run = sub.add_parser("apply")
    run.add_argument("--theme", default="")
    sub.add_parser("revert")
    sub.add_parser("status")
    folders = sub.add_parser("folders")
    folders.add_argument("mode", nargs="?", default="")
    folders.add_argument("--save-only", action="store_true")
    choose = sub.add_parser("set")
    choose.add_argument("icon_set", choices=ICON_SETS)
    covers = sub.add_parser("covers")
    covers.add_argument("value", choices=("on", "off"))
    args = parser.parse_args()

    if args.command == "status":
        print(json.dumps(write_status()))
        return 0
    if args.command == "folders":
        status = set_folders(args.mode or folder_mode(), not args.save_only)
        print(f"folders from {status['mode']}: {status['face']}")
        return 0
    if args.command == "set":
        if not set_installed(args.icon_set):
            print(f"{SET_LABELS[args.icon_set]} is not installed", file=sys.stderr)
            return 3
        save_setting("icon_set", args.icon_set)
        write_status()
        return 0
    if args.command == "covers":
        save_setting("covers", args.value == "on")
        write_status()
        return 0
    if args.command == "revert":
        revert()
        print("reverted; Reversal and Yaru stay installed")
        return 0
    try:
        summary = apply(args.theme)
    except MissingSet as error:
        print(str(error), file=sys.stderr)
        return 3
    drawn = summary["clip"] + summary["plate"] + summary["plain"]
    print(f"{summary['base']}; folders from {summary['folders']} {summary['face']}; "
          f"{drawn} app icons drawn, {summary['alias']} aliased"
          + ("" if summary["changed"] else "; unchanged"))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except BaseException as error:  # one line for the log, not a traceback
        print(f"{type(error).__name__}: {error}", file=sys.stderr)
        sys.exit(1)
