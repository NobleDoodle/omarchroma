_DEFAULT_SETTINGS = {"icon_set": "reversal", "covers": True, "folder_mode": "background"}


def settings() -> dict[str, object]:
    data: dict[str, object] = dict(_DEFAULT_SETTINGS)
    stored = read_json_file(state_dir() / "settings.json", {})
    data.update({key: stored[key] for key in _DEFAULT_SETTINGS if key in stored})
    if data["icon_set"] not in ICON_SETS:
        data["icon_set"] = "reversal"
    if data["folder_mode"] not in FOLDER_MODES:
        data["folder_mode"] = "background"
    data["covers"] = data["covers"] is not False
    return data


def save_setting(key: str, value: object) -> dict[str, object]:
    if key not in _DEFAULT_SETTINGS:
        raise SystemExit(f"unknown setting: {key}")
    current = settings()
    current[key] = value
    write_json_file(state_dir() / "settings.json", current)
    return current


def icon_set() -> str:
    return str(settings()["icon_set"])


def folder_mode() -> str:
    return str(settings()["folder_mode"])


