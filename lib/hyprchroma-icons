def home() -> Path:
    return Path(os.environ.get("HOME") or os.path.expanduser("~"))


def _xdg(name: str, fallback: str) -> Path:
    value = os.environ.get(name, "")
    return Path(value) if value.startswith("/") else home() / fallback


def state_dir() -> Path:
    return _xdg("XDG_STATE_HOME", ".local/state") / "hyprchroma" / "icons"


def data_dir() -> Path:
    return _xdg("XDG_DATA_HOME", ".local/share") / "hyprchroma" / "icons"


def cover_store() -> Path:
    return data_dir() / "apps"


def place_store() -> Path:
    return data_dir() / "places"


def private_icons() -> Path:
    """Where the generated icon theme lives: the app menu scans it before hicolor."""
    return home() / ".icons"


def public_icons() -> Path:
    return _xdg("XDG_DATA_HOME", ".local/share") / "icons"


def user_themes() -> Path:
    return _xdg("XDG_CONFIG_HOME", ".config") / "omarchy" / "themes"


def stock_themes() -> Path:
    root = os.environ.get("OMARCHY_PATH", "")
    return (Path(root) if root.startswith("/") else Path("/usr/share/omarchy")) / "themes"


def omarchy_current() -> Path:
    return _xdg("XDG_STATE_HOME", ".local/state") / "omarchy" / "current"


def icon_roots() -> list[Path]:
    """Installed icon themes, user first."""
    roots = [public_icons()]
    for entry in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":"):
        if entry.startswith("/"):
            roots.append(Path(entry) / "icons")
    return roots


def find_theme(name: str) -> Path | None:
    for root in icon_roots():
        if (root / name / "index.theme").is_file():
            return root / name
    return None


def set_installed(icon_set: str) -> bool:
    if icon_set == "reversal":
        # The AUR package (reversal-icon-theme-git) installs only the default
        # Reversal and Reversal-dark, under /usr/share/icons; that is enough.
        return find_theme("Reversal") is not None
    if icon_set == "yaru":
        return find_theme("Yaru") is not None
    return False


def isolated() -> bool:
    """Tests and scratch homes: never reach a session bus."""
    return os.environ.get("HYPRCHROMA_ICONS_ISOLATED") == "1"


# ------------------------------------------------------------- safe write --

def write_text(path: Path, text: str, mode: int | None = None) -> None:
    atomic_write(path, text.encode(), mode)


def write_if_changed(path: Path, text: str, mode: int | None = None) -> bool:
    if not path.is_symlink() and path.is_file():
        try:
            if path.read_text(errors="replace") == text:
                return False
        except OSError:
            pass
    write_text(path, text, mode)
    return True


def replace_symlink(link: Path, target: str) -> None:
    """Point link at target, through a temporary in a verified directory."""
    descriptor = open_dir(link.parent, create=True)
    try:
        for _ in range(_TEMPORARY_ATTEMPTS):
            temporary = f".{link.name}.{os.urandom(8).hex()}.tmp"
            try:
                os.symlink(target, temporary, dir_fd=descriptor)
            except FileExistsError:
                continue
            try:
                os.replace(temporary, link.name, src_dir_fd=descriptor, dst_dir_fd=descriptor)
            except BaseException:
                os.unlink(temporary, dir_fd=descriptor)
                raise
            return
        raise OSError(f"could not create a temporary beside {link}")
    finally:
        os.close(descriptor)


def remove_entry(path: Path) -> None:
    """Unlink one name (a file or a symlink, never followed) if it is there."""
    try:
        descriptor = open_dir(path.parent)
    except OSError:
        return
    try:
        os.unlink(path.name, dir_fd=descriptor)
    except (FileNotFoundError, IsADirectoryError):
        pass
    finally:
        os.close(descriptor)


def remove_tree(path: Path) -> None:
    """Delete a directory we made. A symlink in its place is unlinked, not followed."""
    if path.is_symlink():
        remove_entry(path)
    elif path.is_dir():
        shutil.rmtree(path)


def make_dir(path: Path) -> None:
    os.close(open_dir(path, create=True))


def read_json_file(path: Path, default):
    text = safe_read(path, 4 << 20) if path.exists() else None
    if text is None:
        return default
    try:
        value = json.loads(text)
    except ValueError:
        return default
    return value if isinstance(value, type(default)) else default


def write_json_file(path: Path, value) -> None:
    write_text(path, json.dumps(value, indent=2) + "\n", 0o644)


class Lock:
    """An flock on a private file in the state directory, created following no link."""

    def __init__(self, name: str, blocking: bool = True):
        self.name, self.blocking, self.handle = name, blocking, -1

    def __enter__(self):
        descriptor = open_dir(state_dir(), create=True)
        try:
            self.handle = os.open(self.name, os.O_RDONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,
                                  0o600, dir_fd=descriptor)
        finally:
            os.close(descriptor)
        fcntl.flock(self.handle, fcntl.LOCK_EX | (0 if self.blocking else fcntl.LOCK_NB))
        return self

    def __exit__(self, *_):
        os.close(self.handle)


