    accent = theme_color(slug, "accent")
    fallbacks = {
        "reversal": {"omacarchy": "Reversal-grey", "osaka-jade": "Reversal-green"},
        "yaru": {"omacarchy": "Yaru-sage", "osaka-jade": "Yaru-prussiangreen"},
    }[chosen_set]
    name = base_theme_name(accent, theme_mode(slug), None if accent else fallbacks.get(slug), chosen_set)
    if find_theme(name) is None:
        # A color not installed (Reversal can be installed without its color
        # variants) falls back to the set's own default rather than to nothing.
        root = "Yaru" if chosen_set == "yaru" else "Reversal"
        name = root if name in (root, f"{root}-sage") or not name.endswith("-dark") else f"{root}-dark"
    return name


def current_theme_slug() -> str:
    text = _read(omarchy_current() / "theme.name", 256).strip().lower().replace(" ", "-")
    return valid_slug(text)


def theme_slugs() -> list[str]:
    names: set[str] = set()
    for root in (user_themes(), stock_themes()):
        if not root.is_dir():
            continue
        for path in root.iterdir():
            if path.is_dir() and valid_slug(path.name):
                names.add(path.name)
    return sorted(names)


def _mix(base: str, over: str, amount: float) -> str:
    one = [int(base[i:i + 2], 16) for i in (1, 3, 5)]
    two = [int(over[i:i + 2], 16) for i in (1, 3, 5)]
    return "#" + "".join(f"{round(x + (y - x) * amount):02x}" for x, y in zip(one, two))


def sidebar_highlight(slug: str) -> str | None:
    """The selected row of a GTK sidebar (Home in Files): libadwaita draws it as
    10% foreground over lighter_background. Not the theme's selection key."""
    surface = theme_color(slug, "lighter_background") or theme_color(slug, "background")
    foreground = theme_color(slug, "foreground")
    if surface and foreground:
        return _mix(surface, foreground, 0.10)
    return surface


def _first_color(value: str) -> str | None:
    """First color of a Hyprland color or gradient string, as #rrggbb."""
    match = re.search(r"rgba?\(\s*([0-9A-Fa-f]{6})(?:[0-9A-Fa-f]{2})?\s*\)|#([0-9A-Fa-f]{6})", value)
    return "#" + (match.group(1) or match.group(2)).lower() if match else None


def border_color(slug: str) -> str | None:
    """First stop of the theme's active window border."""
    if slug and slug == current_theme_slug():
        match = re.search(r'^active-border\s*=\s*"([^"]+)"',
                          _read(omarchy_current() / "theme" / "shell.toml"), re.M)
        if match and _first_color(match.group(1)):
            return _first_color(match.group(1))
    match = re.search(r'^hyprland_active_border\s*=\s*"([^"]+)"', _read(theme_file(slug, "colors.toml")), re.M)
    if match and _first_color(match.group(1)):
        return _first_color(match.group(1))
    return theme_color(slug, "accent")


def original_icon_theme(slug: str) -> str:
    """The icon set the theme itself names, before Icons pointed it elsewhere:
    the copy saved when it was first changed, else the theme's own file, else
    Omarchy's stock copy of it."""
    if not valid_slug(slug):
        return ""
    candidates = [state_dir() / "icons-theme-backup" / slug / "icons.theme",
                  user_themes() / slug / "icons.theme", stock_themes() / slug / "icons.theme"]
    for path in candidates:
        value = _read(path, 256).strip()
        if value and value != THEME_NAME:
            return value
    return ""


def yaru_color(slug: str) -> str | None:
    """The folder color of the Yaru variant the theme names (Yaru-blue, Yaru-sage-dark, ...)."""
    name = original_icon_theme(slug).removesuffix("-dark")
    return YARU_COLORS.get(name)


def mode_source(slug: str, mode: str) -> str:
    background = sidebar_highlight(slug)
    accent = theme_color(slug, "accent") or background or _FALLBACK_COLOR
    background = background or accent
    if mode == "yaru":
        # A theme naming no Yaru color (Papirus, or Yaru-grey, which Yaru
        # does not ship) takes its accent instead.
        return yaru_color(slug) or accent
    if mode == "border":
        return border_color(slug) or accent
    if mode == "accent":
        return accent
    return background


def yaru_roles(face: str) -> dict[str, str]:
    """Every Yaru folder role for a new face, keeping Yaru's own steps: each
    role keeps its OKLCh lightness ratio (darker roles) or offset (lighter),
    its chroma ratio and its hue offset from Yaru's orange face."""
    base_l, base_c, base_h = oklch(ROLES["face"])
    face_l, face_c, face_h = oklch(face)
    roles = {}
    for role, value in ROLES.items():
        if role == "face":
            roles[role] = face.lower()
            continue
        role_l, role_c, role_h = oklch(value)
        lightness = face_l * role_l / base_l if role_l < base_l else min(0.98, face_l + role_l - base_l)
        chroma = face_c * (role_c / base_c if base_c else 1.0)
        roles[role] = _lch_to_hex(lightness, chroma, face_h + (role_h - base_h))
    return roles


def folder_palette(slug: str, mode: str | None = None, chosen_set: str | None = None) -> dict[str, str]:
    chosen = mode if mode in FOLDER_MODES else folder_mode()
    chosen_set = chosen_set or icon_set()
    source = mode_source(slug, chosen)
    if chosen_set == "yaru":
        roles = yaru_roles(source)
        face, shade = roles["face"], roles["tab"]
    else:
        face, shade = folder_colors(source)
    return {"mode": chosen, "face": face, "shade": shade, "source": source, "slug": slug, "icon_set": chosen_set}


# ------------------------------------------------------------- base sets --

def reversal_dir() -> Path | None:
    return find_theme("Reversal")


def _walk_icons(root: Path, follow: bool = False):
    for directory, _dirs, files in os.walk(root, followlinks=follow):
        if "/apps" not in directory and "/devices" not in directory:
            continue
        yield directory, files


def reversal_icon_names() -> dict[str, Path]:
    """Icon stem to one scalable (or any) SVG in the base Reversal theme."""
    found: dict[str, tuple[int, Path]] = {}
    root = reversal_dir()
    if root is None:
        return {}
    for directory, files in _walk_icons(root, follow=True):
        text = directory + "/"
        score = 3 if "/apps/scalable/" in text else 2 if "/apps/" in text else 1 if "/scalable/" in text else 0
        for name in files:
            if name.endswith(".svg"):
                current = found.get(name[:-4])
                if current is None or score > current[0]:
                    found[name[:-4]] = (score, Path(directory) / name)
    return {stem: path for stem, (_score, path) in found.items()}


def yaru_icon_names() -> dict[str, Path]:
    """Best file per app or device stem in Yaru: SVG, else the largest PNG."""
    best: dict[str, tuple[int, Path]] = {}
    root = find_theme("Yaru")
    if root is None:
        return {}
    for directory, files in _walk_icons(root):
        match = re.match(r"(\d+)x\d+(?:@(\d)x)?", Path(directory).parent.name)
        size = int(match.group(1)) * int(match.group(2) or 1) if match else 0
        for name in files:
            stem, _dot, suffix = name.rpartition(".")
            if suffix not in {"png", "svg"}:
                continue
            score = 10_000 if suffix == "svg" else size
            current = best.get(stem)
            if current is None or score > current[0]:
                best[stem] = (score, Path(directory) / name)
    return {stem: path for stem, (_score, path) in best.items()}


def base_icon_names(chosen_set: str) -> dict[str, Path]:
    return yaru_icon_names() if chosen_set == "yaru" else reversal_icon_names()


def _copy_theme(source: Path, destination: Path) -> None:
    """Hard links where allowed (a user's own Reversal), a copy otherwise
    (a system Reversal, which protected_hardlinks will not let us link)."""
    linked = subprocess.run(["cp", "-al", "--", str(source), str(destination)], capture_output=True)
    if linked.returncode != 0:
        remove_tree(destination)
        subprocess.run(["cp", "-a", "--reflink=auto", "--", str(source), str(destination)],
                       check=True, capture_output=True)


def ensure_reversal_sage() -> None:
    """Build Reversal-sage and Reversal-sage-dark from the green variant.

    Only the folder artwork differs: green's face and tab become sage. Every
    rewrite replaces the file (a hard link in the copy) rather than writing
    through it, or the green theme would change too."""
    icons = public_icons()
    # Sage is made from green; a Reversal installed without its color
    # variants has none, and themes simply inherit Reversal itself then.
    if find_theme("Reversal-green") is None or find_theme("Reversal-green-dark") is None:
        return
    sage_folder = icons / "Reversal-sage/places/scalable/folder.svg"
    if (sage_folder.is_file() and _SAGE_FACE in _read(sage_folder).lower()
            and (icons / "Reversal-sage-dark/index.theme").is_file()):
        return
    for source_name, dest_name in (("Reversal-green", "Reversal-sage"), ("Reversal-green-dark", "Reversal-sage-dark")):
        source = find_theme(source_name)
        if source is None:
            raise SystemExit(f"Reversal's {source_name} theme is not installed")
        destination = icons / dest_name
        make_dir(icons)
        remove_tree(destination)
        _copy_theme(source, destination)
        remove_entry(destination / "icon-theme.cache")
        index = destination / "index.theme"
        write_text(index, _read(index, 1 << 20).replace(source_name, dest_name), 0o644)
        for svg in (destination / "places/scalable").glob("*.svg"):
            if svg.is_symlink():
                continue
            body = _read(svg, 1 << 22)
            updated = re.sub(_GREEN_FACE, _SAGE_FACE, body, flags=re.I)
            updated = re.sub(_GREEN_SHADE, _SAGE_SHADE, updated, flags=re.I)
            if updated != body:
                write_text(svg, updated, 0o644)
        tool = shutil.which("gtk-update-icon-cache")
        if tool:
            subprocess.run([tool, "-f", "-q", str(destination)], check=False, capture_output=True)


# ----------------------------------------------------------- app covers --

CANVAS = 256
# 4.5/64, 55/64 and 12/64 of a 256px tile, measured from Reversal's plates.
PLATE = (18, 18, 220, 220)
RADIUS = 48
SHRINK = 0.93
SAFE = 0.62


def _icon_bases() -> list[Path]:
    bases = [private_icons(), public_icons()]
    for entry in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":"):
        if entry.startswith("/"):
            bases.append(Path(entry) / "icons")
    return bases


def _skipped_theme(path: Path) -> bool:
    return any(part.startswith(("Reversal", "Yaru", THEME_NAME)) for part in path.parts)


def artwork_index() -> dict[str, Path]:
    """Best artwork for each icon name outside the base sets, scanned once."""
    best: dict[str, tuple[int, Path]] = {}

    def consider(path: Path, score: int) -> None:
        if _skipped_theme(path):
            return
        current = best.get(path.stem)
        if current is None or score > current[0]:
            best[path.stem] = (score, path)

    for base in _icon_bases():
        if not base.is_dir():
            continue
        for directory, files in _walk_icons(base):
            text = directory + "/"
            for name in files:
                if not name.endswith((".svg", ".png")):
                    continue
                score = (100 if name.endswith(".svg") else 0) + (40 if "/scalable/" in text else 0)
                score += 10 if "/hicolor/" in text else 0
                parent = Path(directory).name
                if parent.isdigit():
                    score += min(int(parent), 512) // 32
                consider(Path(directory) / name, score)
    pixmaps = Path("/usr/share/pixmaps")
    if pixmaps.is_dir():
        for path in pixmaps.iterdir():
            if path.suffix in {".svg", ".png"}:
                consider(path, 5 if path.suffix == ".svg" else 1)
    return {stem: path for stem, (_score, path) in best.items()}


def application_dirs() -> list[Path]:
    roots = [_xdg("XDG_DATA_HOME", ".local/share") / "applications"]
    for entry in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":"):
        if entry.startswith("/"):
            roots.append(Path(entry) / "applications")
    return roots


def desktop_entries() -> list[tuple[str, Path]]:
    """Visible (icon, desktop file) pairs, first of each file name. Icon may be absolute."""
    seen: set[str] = set()
    entries: list[tuple[str, Path]] = []
    for root in application_dirs():
        if not root.is_dir():
            continue
        for path in sorted(root.rglob("*.desktop")):
            if path.name in seen:
                continue
            seen.add(path.name)
            text = _read(path, 1 << 18)
            if "NoDisplay=true" in text or "Hidden=true" in text:
                continue
            match = re.search(r"^Icon=(.+)$", text, re.M)
            if match and match.group(1).strip():
                entries.append((match.group(1).strip(), path))
    return entries


def _safe_stem(name: str) -> str:
    return re.sub(r"[^A-Za-z0-9._+-]", "-", name).strip(".-") or "icon"


def _rewrite_absolute(path: Path, icon_name: str, originals: dict[str, str]) -> None:
    """An absolute Icon= cannot be themed, so a desktop file of the user's own
    names the cover instead. Its original line is kept for revert. Never a
    symlink -- that file belongs to whatever put the link there."""
    try:
        path.relative_to(home())
    except ValueError:
        return
    if path.is_symlink() or not path.is_file():
        return
    text = _read(path, 1 << 18)
    match = re.search(r"^Icon=(.*)$", text, re.M)
    if not match or match.group(1).strip() == icon_name:
        return
    originals.setdefault(str(path), match.group(1).strip())
    write_text(path, text[:match.start(1)] + icon_name + text[match.end(1):])


def _pil():
    try:
        from PIL import Image, ImageChops, ImageDraw, ImageFilter
    except ImportError as error:
        raise SystemExit("python-pillow is not installed; app-icon covers need it") from error
    return Image, ImageChops, ImageDraw, ImageFilter


def plate_mask():
    Image, _chops, ImageDraw, _filter = _pil()
    mask = Image.new("L", (CANVAS, CANVAS), 0)
    left, top, width, height = PLATE
    ImageDraw.Draw(mask).rounded_rectangle((left, top, left + width - 1, top + height - 1), radius=RADIUS, fill=255)
    return mask


def _pixels(image):
    flattened = getattr(image, "get_flattened_data", None)
    return flattened() if flattened else image.getdata()


def metrics(image) -> dict[str, float] | None:
    binary = image.getchannel("A").point(lambda pixel: 255 if pixel > 24 else 0)
    box = binary.getbbox()
    if box is None:
        return None
    left, top, right, bottom = box
    width, height = right - left, bottom - top
    if width < 2 or height < 2:
        return None
    opaque = sum(1 for pixel in _pixels(binary.crop(box)) if pixel)
    return {"fill": opaque / (width * height), "cover_w": width / CANVAS, "cover_h": height / CANVAS,
            "aspect": width / height, "left": left, "top": top, "right": right, "bottom": bottom}


def is_filled_plate(info: dict[str, float]) -> bool:
    return (info["cover_w"] >= 0.80 and info["cover_h"] >= 0.80
            and 0.85 <= info["aspect"] <= 1.18 and info["fill"] >= 0.58)


def hash_color(name: str) -> tuple[int, int, int]:
    return HASH_COLORS[hashlib.sha256(name.encode()).digest()[0] % len(HASH_COLORS)]


def contrast_plate(color: tuple[int, int, int], glyph_luma: float) -> tuple[int, int, int]:
    hue, saturation, _value = colorsys.rgb_to_hsv(*(channel / 255 for channel in color))
    saturation = min(1.0, max(saturation, 0.38))
    value = 0.40 if glyph_luma >= 0.55 else 0.90
    if glyph_luma < 0.55:
        saturation = min(saturation, 0.62)
    red, green, blue = colorsys.hsv_to_rgb(hue, saturation, value)
    return (round(red * 255), round(green * 255), round(blue * 255))


def dominant_color(image, name: str) -> tuple[int, int, int]:
    pixels = [pixel for pixel in _pixels(image) if pixel[3] > 140]
    if len(pixels) < 8:
        return hash_color(name)
    buckets: list[list[tuple[int, int, int, float]]] = [[] for _ in range(16)]
    for red, green, blue, _alpha in pixels:
        hue, saturation, value = colorsys.rgb_to_hsv(red / 255, green / 255, blue / 255)
        if saturation >= 0.18 and value >= 0.12:
            buckets[int(hue * 16) % 16].append((red, green, blue, saturation))
    ranked = sorted(range(16), key=lambda index: sum(item[3] for item in buckets[index]), reverse=True)
    chosen = buckets[ranked[0]]
    if not chosen:
        return hash_color(name)
    mean = tuple(sum(item[channel] for item in chosen) // len(chosen) for channel in range(3))
    luma = sum((0.2126 * r + 0.7152 * g + 0.0722 * b) / 255 for r, g, b, _a in pixels) / len(pixels)
    return contrast_plate(mean, luma)


def _shift(color: tuple[int, int, int], delta: float) -> tuple[int, int, int]:
    hue, saturation, value = colorsys.rgb_to_hsv(*(channel / 255 for channel in color))
    red, green, blue = colorsys.hsv_to_rgb(hue, saturation, min(1.0, max(0.0, value + delta)))
    return (round(red * 255), round(green * 255), round(blue * 255))


def _shadow():
    Image, _chops, ImageDraw, ImageFilter = _pil()
    shadow = Image.new("RGBA", (CANVAS, CANVAS), (0, 0, 0, 0))
    left, top, width, height = PLATE
    ImageDraw.Draw(shadow).rounded_rectangle((left, top + 6, left + width - 1, top + height + 5),
                                             radius=RADIUS, fill=(0, 0, 0, 78))
    return shadow.filter(ImageFilter.GaussianBlur(7))


def _clip(image, mask):
    Image, ImageChops, _draw, _filter = _pil()
    red, green, blue, alpha = image.split()
    return Image.merge("RGBA", (red, green, blue, ImageChops.multiply(alpha, mask)))


def render_clip(image, mask):
    Image = _pil()[0]
    size = max(1, round(CANVAS * SHRINK))
    scaled = image.resize((size, size), Image.Resampling.LANCZOS)
    canvas = Image.new("RGBA", (CANVAS, CANVAS), (0, 0, 0, 0))
    canvas.paste(scaled, ((CANVAS - size) // 2,) * 2, scaled)
    return Image.alpha_composite(_shadow(), _clip(canvas, mask))


def render_plate(image, info, color, mask):
    Image, _chops, ImageDraw, _filter = _pil()
    top, bottom = _shift(color, 0.10), _shift(color, -0.08)
    plate = Image.new("RGBA", (CANVAS, CANVAS), (0, 0, 0, 0))
    draw = ImageDraw.Draw(plate)
    for y in range(CANVAS):
        blend = y / (CANVAS - 1)
        draw.line((0, y, CANVAS, y), fill=tuple(round(top[c] * (1 - blend) + bottom[c] * blend) for c in range(3)) + (255,))
    left, top_edge, width, height = PLATE
    glyph = image.crop((int(info["left"]), int(info["top"]), int(info["right"]), int(info["bottom"])))
    safe = max(1, round(width * SAFE))
    scale = min(safe / glyph.width, safe / glyph.height)
    glyph = glyph.resize((max(1, round(glyph.width * scale)), max(1, round(glyph.height * scale))),
                         Image.Resampling.LANCZOS)
    plate.paste(glyph, (left + (width - glyph.width) // 2, top_edge + (height - glyph.height) // 2), glyph)
    return Image.alpha_composite(_shadow(), _clip(plate, mask))


def render_plain(image):
    Image = _pil()[0]
    canvas = Image.new("RGBA", (CANVAS, CANVAS), (0, 0, 0, 0))
    art = image.copy()
    art.thumbnail((CANVAS, CANVAS), Image.Resampling.LANCZOS)
    canvas.alpha_composite(art, ((CANVAS - art.width) // 2, (CANVAS - art.height) // 2))
    return canvas


def _looks_like_svg(path: Path) -> bool:
    if path.suffix.lower() == ".svg":
        return True
    try:
        with open(path, "rb") as handle:
            head = handle.read(256).lstrip().lower()
    except OSError:
        return False
    return head.startswith((b"<?xml", b"<svg"))


def _render_svg(path: Path):
    Image = _pil()[0]
    import io
    try:
        result = subprocess.run(["rsvg-convert", "-w", str(CANVAS), "-h", str(CANVAS), "--", str(path)],
                                check=True, capture_output=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    try:
        return Image.open(io.BytesIO(result.stdout)).convert("RGBA")
    except OSError:
        return None


def load_artwork(path: Path):
    Image = _pil()[0]
    if _looks_like_svg(path):
        return _render_svg(path)
    try:
        image = Image.open(path)
        # Icons, not posters: anything this large is not app artwork.
        if image.width * image.height > 4096 * 4096:
            return None
        image = image.convert("RGBA")
    except (OSError, Image.DecompressionBombError):
        return _render_svg(path)
    if image.size != (CANVAS, CANVAS):
        fitted = Image.new("RGBA", (CANVAS, CANVAS), (0, 0, 0, 0))
        scale = min(CANVAS / image.width, CANVAS / image.height)
        resized = image.resize((max(1, round(image.width * scale)), max(1, round(image.height * scale))),
                               Image.Resampling.LANCZOS)
        fitted.paste(resized, ((CANVAS - resized.width) // 2, (CANVAS - resized.height) // 2), resized)
        return fitted
    return image


def svg_document(png: bytes) -> str:
    """A cover is an SVG around its PNG: the app menu takes every SVG before
    any PNG, so a PNG cover would lose to an hicolor SVG of the same name."""
    import base64
    payload = base64.b64encode(png).decode()
    return ('<?xml version="1.0" encoding="UTF-8"?>\n'
            '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" '
            'width="64" height="64" viewBox="0 0 64 64">\n'
            f'<image width="64" height="64" href="data:image/png;base64,{payload}" '
            f'xlink:href="data:image/png;base64,{payload}"/>\n</svg>\n')


def write_icon(image, destination: Path) -> None:
    import io
    buffer = io.BytesIO()
    image.save(buffer, format="PNG", optimize=True)
    write_text(destination, svg_document(buffer.getvalue()), 0o644)


def build_icon(artwork, name: str, mask):
    info = metrics(artwork) or {"fill": 0, "cover_w": 0, "cover_h": 0, "aspect": 1,
                                "left": 96, "top": 96, "right": 160, "bottom": 160}
    if is_filled_plate(info):
        return render_clip(artwork, mask), "clip"
    return render_plate(artwork, info, dominant_color(artwork, name), mask), "plate"


def _link_into(store: Path, stem: str, source: Path) -> None:
    link = store / f"{stem}.svg"
    target = os.path.relpath(source, store)
    if not (link.is_symlink() and os.readlink(link) == target):
        replace_symlink(link, target)


def generate(store: Path, covers: bool, chosen_set: str) -> dict[str, int]:
    """App-icon covers. With covers off, only desktop files that pointed at an
    absolute path get an entry (their Icon= was rewritten to a name), drawn
    as-is; everything else falls through to the base set and hicolor."""
    names = base_icon_names(chosen_set)
    lower = {stem.lower(): stem for stem in names}
    sources = artwork_index()
    mask = None
    counts = {"clip": 0, "plate": 0, "plain": 0, "alias": 0, "skipped": 0}
    wanted: set[str] = set()
    originals = read_json_file(state_dir() / "absolute-icons.json", {})
    absolute_sources = read_json_file(state_dir() / "absolute-sources.json", {})
    cache = read_json_file(state_dir() / "cache.json", {})
    if cache.get("version") != VERSION or not isinstance(cache.get("icons"), dict):
        cache = {"version": VERSION, "icons": {}}
    make_dir(store)

    for icon, desktop in desktop_entries():
        remembered = None
        if icon.startswith("/"):
            source = Path(icon)
            if not source.is_file():
                counts["skipped"] += 1
                continue
            stem = _safe_stem(desktop.stem)
            _rewrite_absolute(desktop, stem, originals)
            absolute_sources[stem] = str(source)
        else:
            stem = icon
            if "/" in stem or stem.startswith("."):
                counts["skipped"] += 1
                continue
            source = None
            remembered = absolute_sources.get(stem)
            if isinstance(remembered, str) and Path(remembered).is_file():
                source = Path(remembered)

        # Yaru: the menu takes the first SVG it finds, and Reversal's SVGs would
        # win over Yaru's PNGs, so every visible app gets an entry: Yaru's own
        # icon, else the app's own, drawn as-is. Plates are Reversal's shape.
        draw_plain = not covers or chosen_set == "yaru"
        if chosen_set == "yaru" and not icon.startswith("/"):
            yaru_path = names.get(stem)
            if yaru_path is not None and yaru_path.suffix == ".svg":
                _link_into(store, stem, yaru_path)
                wanted.add(f"{stem}.svg")
                continue
            source = yaru_path or source or sources.get(stem)
            if source is None or not source.is_file():
                counts["skipped"] += 1
                continue
        alias = ALIASES.get(stem) if chosen_set == "reversal" else None
        alias = alias or (lower.get(stem.lower()) if stem not in names else None)
        if alias and alias in names and names[alias].suffix == ".svg" and not icon.startswith("/"):
            _link_into(store, stem, names[alias])
            wanted.add(f"{stem}.svg")
            counts["alias"] += 1
            continue
        if chosen_set != "yaru" and stem in names and not icon.startswith("/"):
            continue
        if chosen_set != "yaru" and not covers and not icon.startswith("/") and not remembered:
            continue
        source = source or sources.get(stem)
        if source is None or not source.is_file():
            counts["skipped"] += 1
            continue
        destination = store / f"{stem}.svg"
        stamp = f"{VERSION}:{'plain' if draw_plain else 'cover'}:{source}:{source.stat().st_mtime_ns}"
        if (cache["icons"].get(stem) == stamp and destination.is_file()
                and not destination.is_symlink()):
            wanted.add(destination.name)
            continue
        artwork = load_artwork(source)
        if artwork is None:
            counts["skipped"] += 1
            continue
        if draw_plain:
            image, kind = render_plain(artwork), "plain"
        else:
            mask = mask or plate_mask()
            image, kind = build_icon(artwork, stem, mask)
        if destination.is_symlink():
            remove_entry(destination)
        write_icon(image, destination)
        write_text(store / f".{stem}.mode", kind + "\n", 0o644)
        cache["icons"][stem] = stamp
        wanted.add(destination.name)

    for existing in list(store.iterdir()):
        if existing.name.startswith("."):
            if existing.name.endswith(".mode") and existing.name[1:-5] + ".svg" not in wanted:
                remove_entry(existing)
            continue
        if existing.name not in wanted:
            remove_entry(existing)
            cache["icons"].pop(existing.stem, None)
    write_json_file(state_dir() / "absolute-icons.json", originals)
    write_json_file(state_dir() / "absolute-sources.json", absolute_sources)
    write_json_file(state_dir() / "cache.json", cache)
    # Totals from the store itself, so the summary matches what is there.
    counts = {"clip": 0, "plate": 0, "plain": 0, "alias": 0, "skipped": counts["skipped"]}
    for path in store.iterdir():
        if path.suffix == ".svg" and path.is_symlink():
            counts["alias"] += 1
        elif path.name.startswith(".") and path.name.endswith(".mode"):
            kind = _read(path, 16).strip()
            if kind in counts:
                counts[kind] += 1
    return counts


# --------------------------------------------------------------- folders --

def ensure_yaru_templates() -> Path:
    """Trace Yaru's folder PNGs to SVG once. The stamp is the tracer version
    and every source file's time, so a Yaru update re-traces."""
    root = find_theme("Yaru")
    if root is None:
        raise SystemExit("Yaru is not installed (yaru-icon-theme)")
    source = root / "256x256@2x/places"
    if not source.is_dir():
        source = root / "256x256/places"
    target = data_dir() / "templates" / "yaru"
    files = sorted(source.glob("*.png"))
    stamp = f"{TRACE_VERSION}|" + "|".join(f"{p.name}:{p.lstat().st_mtime_ns}" for p in files)
    if _read(target / ".stamp") == stamp:
        return target
    remove_tree(target)
    make_dir(target)
    traced = set()
    for png in files:
        if not png.is_symlink():
            svg = vectorize(png)
            if svg:
                write_text(target / f"{png.stem}.svg", svg, 0o644)
                traced.add(png.stem)
    for png in files:
        if png.is_symlink() and Path(os.readlink(png)).stem in traced:
            replace_symlink(target / f"{png.stem}.svg", f"{Path(os.readlink(png)).stem}.svg")
    write_text(target / ".stamp", stamp, 0o644)
    return target


def folder_templates(chosen_set: str) -> tuple[Path, tuple[tuple[str, str], ...]]:
    """Template folder artwork and its (template hex, role) pairs."""
    if chosen_set == "yaru":
        return ensure_yaru_templates(), tuple((value, role) for role, value in ROLES.items())
    reversal = find_theme("Reversal")
    if reversal is None:
        raise SystemExit("Reversal is not installed")
    return reversal / "places/scalable", REVERSAL_FOLDER_HEXES


def recolor_folders(slug: str = "", mode: str | None = None) -> dict[str, str]:
    """Rewrite the shared folder icons for the theme and mode. Takes its own
    short lock, so a folder change does not wait behind a whole apply."""
    slug = valid_slug(slug) or current_theme_slug()
    with Lock("folders.lock"):
        palette = _recolor_folders_locked(slug, mode)
    return palette


def _recolor_folders_locked(slug: str, mode: str | None) -> dict[str, str]:
    palette = folder_palette(slug, mode)
    chosen_set = palette["icon_set"]
    store = place_store()
    make_dir(store)
    stamp = f"{chosen_set}|{slug}|{palette['mode']}|{palette['face']}|{palette['shade']}|{VERSION}"
    stamp_path = state_dir() / "folder-stamp"
    if _read(stamp_path) == stamp and any(store.glob("*.svg")):
        palette["unchanged"] = "true"
        return palette
    templates, template_roles = folder_templates(chosen_set)
    if not templates.is_dir():
        raise SystemExit(f"missing folder templates: {templates}")
    targets = yaru_roles(palette["face"]) if chosen_set == "yaru" else {"face": palette["face"], "tab": palette["shade"]}
    pattern = re.compile("|".join(re.escape(value) for value, _role in template_roles), re.I)
    by_hex = {value.lower(): targets[role] for value, role in template_roles}
    written: set[str] = set()
    for svg in templates.glob("*.svg"):
        if svg.is_symlink():
            continue
        body = _read(svg, 1 << 22)
        updated = pattern.sub(lambda match: by_hex[match.group(0).lower()], body)
        if updated != body:
            destination = store / svg.name
            if destination.is_symlink():
                remove_entry(destination)
            write_text(destination, updated, 0o644)
            written.add(svg.name)
    for svg in templates.glob("*.svg"):
        if svg.is_symlink() and Path(os.readlink(svg)).name in written:
            replace_symlink(store / svg.name, Path(os.readlink(svg)).name)
            written.add(svg.name)
    for stale in store.iterdir():
        if stale.name not in written:
            remove_entry(stale)
    write_text(stamp_path, stamp, 0o644)
    palette["written"] = str(len(written))
    refresh_icon_cache()
    return palette


