def _overflow_uid() -> int:
    """The uid shown for an owner not mapped into this namespace, or -1 where
    that uid is a real account. See the same function in hyprchroma-state."""
    try:
        overflow = int(pathlib_read("/proc/sys/kernel/overflowuid"))
    except (OSError, ValueError):
        overflow = 65534
    try:
        mapping = pathlib_read("/proc/self/uid_map")
    except OSError:
        return -1
    for line in mapping.splitlines():
        try:
            inside, _, count = (int(field) for field in line.split())
        except ValueError:
            return -1
        if inside <= overflow < inside + count:
            return -1
    return overflow


def pathlib_read(name: str) -> str:
    with open(name, "r", encoding="ascii") as handle:
        return handle.read().strip()


_OVERFLOW_UID = _overflow_uid()

PATH_CANDIDATES = ("/usr/bin", "/usr/share/omarchy/bin")


def trusted_path() -> str:
    """Commands come from root-owned directories only, as in hyprchroma-state."""
    keep = []
    for directory in PATH_CANDIDATES:
        try:
            info = os.stat(directory)
        except OSError:
            continue
        if not stat.S_ISDIR(info.st_mode) or info.st_uid not in (0, _OVERFLOW_UID):
            continue
        if info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            continue
        keep.append(directory)
    return ":".join(keep) if keep else ":".join(PATH_CANDIDATES)


os.environ["PATH"] = trusted_path()

# --------------------------------------------------------------- safe io --
# This block is shared verbatim between bin/hyprchroma-state and
# bin/hyprchroma-dark-reader; test-safeio asserts the two copies stay
# byte-identical, so a fix can never land in only one of them.
#
# An exclusive temporary filename is not enough on its own: the directory it
# is created in, and the destination it is renamed onto, were still named by
# ordinary pathname strings, so a symlink swapped into any ancestor could
# redirect the create or the rename somewhere else entirely. Here the parent
# directory is resolved once, verified, and kept open as a descriptor; every
# create, stat, rename and unlink is then performed relative to that
# descriptor. The directory a descriptor refers to cannot be changed by
# renaming or relinking anything on disk afterwards, which closes the window
# between checking a path and using it.
#
# Legitimate symlinks are still honored -- dotfile managers routinely link
# ~/.config entries -- by resolving the path first and then walking the
# resolved chain with O_NOFOLLOW. Nothing in that chain may be a symlink at
# the moment it is opened, and every component must be owned by root or by
# this user and be unwritable by anyone else, so no other account can ever
# redirect a write, and a component swapped in mid-walk fails the open rather
# than silently changing the destination.

SAFE_DIR_MODE = 0o700
_TEMPORARY_ATTEMPTS = 16


def _verify_directory(descriptor: int, where: str) -> None:
    info = os.fstat(descriptor)
    if not stat.S_ISDIR(info.st_mode):
        raise OSError(f"not a directory: {where}")
    if info.st_uid not in (0, os.geteuid(), _OVERFLOW_UID):
        raise OSError(f"directory belongs to uid {info.st_uid}: {where}")
    # Group- or world-writable is only safe with the sticky bit, which stops
    # anyone but an entry's owner renaming or removing it -- the /tmp rule.
    # Another account can still create a new name in such a directory, but the
    # ownership check above rejects walking into anything it made.
    if (info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
            and not info.st_mode & stat.S_ISVTX):
        raise OSError(f"directory is writable by others: {where}")


def open_dir(path, create: bool = False) -> int:
    """Return a verified descriptor for path. The caller closes it."""
    resolved = Path(os.path.realpath(str(path)))
    if not resolved.is_absolute():
        raise ValueError(f"refusing a relative directory: {path}")
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
    descriptor = os.open("/", flags)
    try:
        _verify_directory(descriptor, "/")
        walked = Path("/")
        for part in resolved.parts[1:]:
            walked = walked / part
            try:
                nested = os.open(part, flags | os.O_NOFOLLOW, dir_fd=descriptor)
            except FileNotFoundError:
                if not create:
                    raise
                os.mkdir(part, SAFE_DIR_MODE, dir_fd=descriptor)
                nested = os.open(part, flags | os.O_NOFOLLOW, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = nested
            _verify_directory(descriptor, str(walked))
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def atomic_write(path, data, mode: int | None = None) -> None:
    """Replace path with data, through a temporary in a verified directory."""
    path = Path(path)
    descriptor = open_dir(path.parent, create=True)
    try:
        atomic_write_at(descriptor, path.name, data, mode)
    finally:
        os.close(descriptor)


def atomic_write_at(descriptor: int, name: str, data, mode: int | None = None) -> None:
    """atomic_write for a name in a directory already open and verified, so a
    caller that walked there itself, following no link, keeps that walk."""
    if name in ("", ".", "..") or "/" in name:
        raise OSError(f"refusing to write {name!r}: not a plain file name")
    if isinstance(data, str):
        data = data.encode()
    if mode is None:
        try:
            mode = stat.S_IMODE(
                os.stat(name, dir_fd=descriptor, follow_symlinks=False).st_mode)
        except (FileNotFoundError, OSError):
            mode = 0o644
    temporary = None
    for _ in range(_TEMPORARY_ATTEMPTS):
        candidate = f".{name}.{os.urandom(8).hex()}.tmp"
        try:
            opened = os.open(
                candidate,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                0o600,
                dir_fd=descriptor,
            )
        except FileExistsError:
            continue
        temporary = candidate
        break
    if temporary is None:
        raise OSError(f"could not create a temporary beside {name}")
    try:
        with os.fdopen(opened, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
            os.fchmod(handle.fileno(), mode)
        os.replace(temporary, name,
                   src_dir_fd=descriptor, dst_dir_fd=descriptor)
        os.fsync(descriptor)
    except BaseException:
        try:
            os.unlink(temporary, dir_fd=descriptor)
        except FileNotFoundError:
            pass
        raise


def safe_read(path, limit: int) -> str | None:
    """Read at most limit characters through a verified parent descriptor.

    At most limit + 1 characters are read, so the size is judged from what was
    actually read rather than from a stat that a swap could invalidate."""
    path = Path(path)
    try:
        descriptor = open_dir(path.parent)
    except OSError:
        return None
    try:
        # O_NONBLOCK, and nothing but a regular file: a fifo planted at the path
        # would otherwise block this unattended service indefinitely.
        opened = os.open(path.name, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC,
                         dir_fd=descriptor)
    except OSError:
        return None
    finally:
        os.close(descriptor)
    try:
        regular = stat.S_ISREG(os.fstat(opened).st_mode)
    except OSError:
        regular = False
    if not regular:
        os.close(opened)
        return None
    try:
        with os.fdopen(opened, "r", encoding="utf-8", errors="strict") as handle:
            content = handle.read(limit + 1)
    except (OSError, ValueError, UnicodeDecodeError):
        return None
    return None if len(content) > limit else content



