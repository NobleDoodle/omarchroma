def _lin(channel: float) -> float:
    return channel / 12.92 if channel <= 0.04045 else ((channel + 0.055) / 1.055) ** 2.4


def oklch(hex_color: str) -> tuple[float, float, float]:
    hex_color = hex_color.lstrip("#")
    red, green, blue = (_lin(int(hex_color[i:i + 2], 16) / 255) for i in (0, 2, 4))
    long = 0.4122214708 * red + 0.5363325363 * green + 0.0514459929 * blue
    mid = 0.2119034982 * red + 0.6806995451 * green + 0.1073969566 * blue
    short = 0.0883024619 * red + 0.2817188376 * green + 0.6299787005 * blue
    long, mid, short = long ** (1 / 3), mid ** (1 / 3), short ** (1 / 3)
    lightness = 0.2104542553 * long + 0.7936177850 * mid - 0.0040720468 * short
    aye = 1.9779984951 * long - 2.4285922050 * mid + 0.4505937099 * short
    bee = 0.0259040371 * long + 0.7827717662 * mid - 0.8086757660 * short
    return lightness, (aye * aye + bee * bee) ** 0.5, math.degrees(math.atan2(bee, aye)) % 360


def _oklab_to_hex(lightness: float, aye: float, bee: float) -> str:
    long = (lightness + 0.3963377774 * aye + 0.2158037573 * bee) ** 3
    mid = (lightness - 0.1055613458 * aye - 0.0638541728 * bee) ** 3
    short = (lightness - 0.0894841775 * aye - 1.2914855480 * bee) ** 3
    red = 4.0767416621 * long - 3.3077115913 * mid + 0.2309699292 * short
    green = -1.2684380046 * long + 2.6097574011 * mid - 0.3413193965 * short
    blue = -0.0041960863 * long - 0.7034186147 * mid + 1.7076147010 * short

    def channel(value: float) -> int:
        value = max(0.0, min(1.0, value))
        value = value * 12.92 if value <= 0.0031308 else 1.055 * (value ** (1 / 2.4)) - 0.055
        return round(max(0.0, min(255.0, value * 255)))

    return f"#{channel(red):02x}{channel(green):02x}{channel(blue):02x}"


def _lch_to_hex(lightness: float, chroma: float, hue: float) -> str:
    radians = math.radians(hue)
    return _oklab_to_hex(lightness, chroma * math.cos(radians), chroma * math.sin(radians))


_PALETTE_LCH = {name: oklch(value) for name, value in FOLDER_COLORS.items()}
_YARU_LCH = {name: oklch(value) for name, value in YARU_COLORS.items()}


def folder_colors(hex_color: str) -> tuple[str, str]:
    """Folder face and tab: the face is the theme color exactly; the tab keeps
    its hue and chroma, 0.07 darker in OKLCh, like Reversal's own tab."""
    face = hex_color.lower()
    lightness, chroma, hue = oklch(face)
    return face, _lch_to_hex(max(0.0, lightness - 0.07), chroma, hue)


def base_family(accent: str, chosen_set: str = "reversal") -> str:
    """Closest color variant of the base set for an accent, without -dark."""
    lightness, chroma, hue = oklch(accent)
    palette = _YARU_LCH if chosen_set == "yaru" else _PALETTE_LCH
    best_name, best_score = next(iter(palette)), 1e9
    for name, (other_l, other_c, other_h) in palette.items():
        distance = abs(hue - other_h) % 360
        distance = min(distance, 360 - distance)
        score = (distance / 50) ** 2 + ((lightness - other_l) * 2.8) ** 2 + ((chroma - other_c) * 4.0) ** 2
        if score < best_score:
            best_name, best_score = name, score
    if chosen_set == "yaru":
        # Yaru has no grey: near-grey accents take its quietest color.
        return "Yaru-sage" if chroma < 0.03 else best_name
    # Near-grey stays grey, unless it is green enough to be sage.
    if chroma < 0.02 or (chroma < 0.04 and best_name != "Reversal-sage"):
        return "Reversal-black" if lightness < 0.50 else "Reversal-grey"
    return best_name


def base_theme_name(accent: str | None, mode: str, fallback: str | None = None,
                    chosen_set: str = "reversal") -> str:
    base = "Yaru" if chosen_set == "yaru" else "Reversal"
    if accent:
        family = base_family(accent, chosen_set)
    else:
        family = fallback or ("Yaru-sage" if chosen_set == "yaru" else "Reversal-grey")
    if mode == "light":
        return family
    return base + "-dark" if family == base else family + "-dark"


def valid_slug(slug: str) -> str:
    return slug if _SLUG.match(slug or "") else ""


def theme_file(slug: str, name: str) -> Path | None:
    """A theme's file: the user's copy first, then Omarchy's own."""
    if not valid_slug(slug):
        return None
    for root in (user_themes(), stock_themes()):
        candidate = root / slug / name
        if candidate.is_file():
            return candidate
    return None


def _read(path: Path | None, limit: int = 1 << 16) -> str:
    if path is None:
        return ""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as handle:
            return handle.read(limit)
    except OSError:
        return ""


def theme_color(slug: str, key: str) -> str | None:
    texts = [_read(theme_file(slug, "colors.toml"))]
    if slug and slug == current_theme_slug():
        texts.insert(0, _read(omarchy_current() / "theme" / "colors.toml"))
    for text in texts:
        match = re.search(rf'^{re.escape(key)}\s*=\s*"?(#[0-9A-Fa-f]{{6}})\b', text, re.M)
        if match:
            return match.group(1).lower()
    return None


def theme_mode(slug: str) -> str:
    text = _read(theme_file(slug, "colors.toml"))
    match = re.search(r'^mode\s*=\s*"?(\w+)', text, re.M)
    if match:
        return "light" if match.group(1) == "light" else "dark"
    # Omarchy marks a light theme with this file; colors.toml may not say.
    return "light" if theme_file(slug, "light.mode") else "dark"


def base_theme_for(slug: str, chosen_set: str | None = None) -> str:
    """What the generated theme inherits for this theme: Reversal-orange-dark, Yaru-sage, ..."""
