# into prefs.js, so taking the user.js line out leaves it on; this is the line
# that a revert has to remove as well, when it was not on to begin with.
STYLESHEETS_PREF = re.compile(
    r'\s*user_pref\("toolkit\.legacyUserProfileCustomizations\.stylesheets",\s*true\);\s*')
