# --------------------------------------------------------------- safe io --
# This block is shared verbatim between bin/hyprchroma-state and
# bin/hyprchroma-dark-reader; test-safeio asserts the two copies stay
# byte-identical, so a fix can never land in only one of them.
#
# An exclusive temporary filename is not enough on its own: the directory it
# is created in, and the destination it is renamed onto, were still named by
# ordinary pathname strings, so a symlink swapped into any ancestor could
# redirect the create or the rename somewhere else entirely. Here the parent
# directory is resolved once, verified, and kept open as a descriptor; every
# create, stat, rename and unlink is then performed relative to that
# descriptor. The directory a descriptor refers to cannot be changed by
# renaming or relinking anything on disk afterwards, which closes the window
# between checking a path and using it.
#
# Legitimate symlinks are still honored -- dotfile managers routinely link
# ~/.config entries -- by resolving the path first and then walking the
# resolved chain with O_NOFOLLOW. Nothing in that chain may be a symlink at
# the moment it is opened, and every component must be owned by root or by
# this user and be unwritable by anyone else, so no other account can ever
# redirect a write, and a component swapped in mid-walk fails the open rather
# than silently changing the destination.

SAFE_DIR_MODE = 0o700
_TEMPORARY_ATTEMPTS = 16


def _verify_directory(descriptor: int, where: str) -> None:
    info = os.fstat(descriptor)
    if not stat.S_ISDIR(info.st_mode):
        raise OSError(f"not a directory: {where}")
    if info.st_uid not in (0, os.geteuid(), _OVERFLOW_UID):
        raise OSError(f"directory belongs to uid {info.st_uid}: {where}")
    # Group- or world-writable is only safe with the sticky bit, which stops
    # anyone but an entry's owner renaming or removing it -- the /tmp rule.
    # Another account can still create a new name in such a directory, but the
    # ownership check above rejects walking into anything it made.
    if (info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
            and not info.st_mode & stat.S_ISVTX):
        raise OSError(f"directory is writable by others: {where}")


def open_dir(path, create: bool = False) -> int:
    """Return a verified descriptor for path. The caller closes it."""
    resolved = Path(os.path.realpath(str(path)))
    if not resolved.is_absolute():
        raise ValueError(f"refusing a relative directory: {path}")
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
    descriptor = os.open("/", flags)
    try:
        _verify_directory(descriptor, "/")
        walked = Path("/")
        for part in resolved.parts[1:]:
            walked = walked / part
            try:
                nested = os.open(part, flags | os.O_NOFOLLOW, dir_fd=descriptor)
            except FileNotFoundError:
                if not create:
                    raise
                os.mkdir(part, SAFE_DIR_MODE, dir_fd=descriptor)
                nested = os.open(part, flags | os.O_NOFOLLOW, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = nested
            _verify_directory(descriptor, str(walked))
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def atomic_write(path, data, mode: int | None = None) -> None:
    """Replace path with data, through a temporary in a verified directory."""
    path = Path(path)
    if isinstance(data, str):
        data = data.encode()
    descriptor = open_dir(path.parent, create=True)
    try:
        if mode is None:
            try:
                mode = stat.S_IMODE(
                    os.stat(path.name, dir_fd=descriptor, follow_symlinks=False).st_mode)
            except (FileNotFoundError, OSError):
                mode = 0o644
        temporary = None
        for _ in range(_TEMPORARY_ATTEMPTS):
            candidate = f".{path.name}.{secrets.token_hex(8)}.tmp"
            try:
                opened = os.open(
                    candidate,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                    0o600,
                    dir_fd=descriptor,
                )
            except FileExistsError:
                continue
            temporary = candidate
            break
        if temporary is None:
            raise OSError(f"could not create a temporary beside {path}")
        try:
            with os.fdopen(opened, "wb") as handle:
                handle.write(data)
                handle.flush()
                os.fsync(handle.fileno())
                os.fchmod(handle.fileno(), mode)
            os.replace(temporary, path.name,
                       src_dir_fd=descriptor, dst_dir_fd=descriptor)
            os.fsync(descriptor)
        except BaseException:
            try:
                os.unlink(temporary, dir_fd=descriptor)
            except FileNotFoundError:
                pass
            raise
    finally:
        os.close(descriptor)


def safe_read(path, limit: int) -> str | None:
    """Read at most limit characters through a verified parent descriptor.

    At most limit + 1 characters are read, so the size is judged from what was
    actually read rather than from a stat that a swap could invalidate."""
    path = Path(path)
    try:
        descriptor = open_dir(path.parent)
    except OSError:
        return None
    try:
        opened = os.open(path.name, os.O_RDONLY | os.O_CLOEXEC, dir_fd=descriptor)
    except OSError:
        return None
    finally:
        os.close(descriptor)
    try:
        with os.fdopen(opened, "r", encoding="utf-8", errors="strict") as handle:
            content = handle.read(limit + 1)
    except (OSError, ValueError, UnicodeDecodeError):
        return None
    return None if len(content) > limit else content


def prepare_lock(path) -> None:
    """Create path as a private regular lock file, following no symlink.

    The sync script then opens it read-only and takes an flock on it, so even
    a successful swap can never truncate or write through this path."""
    path = Path(path)
    # This removes whatever is in the way -- a symlink planted at the lock path,
    # or a fifo that would block the open forever. That is worth having, but it
    # is an unlink, so it is confined to names that are actually locks rather
    # than offered for any path a caller names.
    if path.suffix != ".lock":
        raise ValueError(f"refusing to prepare a lock at {path}: not a .lock name")
    descriptor = open_dir(path.parent, create=True)
    try:
        try:
            existing = os.stat(path.name, dir_fd=descriptor, follow_symlinks=False)
            if not stat.S_ISREG(existing.st_mode) or existing.st_uid != os.geteuid():
                os.unlink(path.name, dir_fd=descriptor)
        except FileNotFoundError:
            pass
        opened = os.open(
            path.name,
            os.O_RDONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
            dir_fd=descriptor,
        )
        try:
            # A lock left behind by an older version was created by a shell
            # redirection under the caller's umask, so narrow it here rather
            # than leaving it as whatever that happened to produce.
            os.fchmod(opened, 0o600)
        finally:
            os.close(opened)
    finally:
        os.close(descriptor)


def read_json(path):
    if not path.is_file():
        return {}
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


UNSAFE_IN_NAME = re.compile(r"[^\w .+-]")


def display_name(value):
    """A name safe to put in a log line or a notification body.

    Window class, window title and a process's own executable name are all set
    by the application, so they are attacker controlled, and notification
    daemons render a subset of HTML in the body -- a window title containing
    markup is enough to garble one. Keep the characters an application name
    legitimately uses and drop the rest."""
    cleaned = UNSAFE_IN_NAME.sub("", value or "").strip()
    return cleaned[:64] or "?"


def window_display_name(title, klass):
    """A readable name for a window.

    The class is the stable choice where it is reverse-DNS: "org.gnome.Nautilus"
    is Nautilus whatever document it happens to be showing, whereas the title is
    that document and changes minute to minute.

    A Chromium web app is not named that way. Its class is built from the URL,
    so "chrome-maps.google.com__-Default" reduced to its last dotted segment
    gives "Com__-Default", which names nothing anyone would recognize. Those
    windows carry the page name in the title instead, which is what the user
    opened and what they would look for."""
    if klass and (klass.startswith("chrome-") or "__" in klass):
        return display_name(title or klass)
    if klass:
        return display_name(klass.rsplit(".", 1)[-1])
    return display_name(title)


def write_json(path, value):
    atomic_write(path, json.dumps(value, indent=2) + "\n")


def command_output(command):
    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, check=False)
    return result.stdout.strip() if result.returncode == 0 else None


GENERATED_MARKER = "Generated by Hyprchroma"


def ensure_import(path: Path, line: str) -> str:
    """Make sure path pulls in our stylesheet, without taking the file over.

    Owning gtk.css outright meant any customization the user had there stopped
    working the moment this was installed, and was overwritten again on every
    theme change. The colors live in a file of our own now and gtk.css only
    references it, so what the user put there survives.

    The import is put first, not appended: in GTK's CSS a later @define-color
    replaces an earlier one, so appending would silently override whatever the
    user wrote, which is the wrong way round. First means our colors are the
    defaults and anything below overrides them."""
    text = read_capped(path)
    if text is None:
        try:
            path.stat()
        except FileNotFoundError:
            atomic_write(path, line + "\n", 0o644)
            return "created"
        return "unreadable"
    if line in text:
        return "present"
    # A file this wrote in full, before the import existed. Its whole content is
    # ours, so it is replaced rather than prepended to and kept forever.
    if GENERATED_MARKER in text:
        atomic_write(path, line + "\n", 0o644)
        return "migrated"
    atomic_write(path, line + "\n\n" + text.lstrip("\n"), 0o644)
    return "added"


def remove_import(path: Path, line: str) -> str:
    """Take our reference back out and leave whatever else was there."""
    text = read_capped(path)
    if text is None:
        return "absent"
    kept = [row for row in text.splitlines() if row.strip() != line]
    remaining = "\n".join(kept).strip()
    if not remaining:
        # Nothing of the user's was ever in it.
        try:
            path.unlink()
        except FileNotFoundError:
            pass
        return "removed"
    atomic_write(path, remaining + "\n", 0o644)
    return "stripped"


def generated_by_marker(path):
    try:
        with path.open("r", errors="replace") as handle:
            return GENERATED_MARKER in handle.read(4096)
    except OSError:
        return False


def generated_kdeglobals(path):
    try:
        return "ColorScheme=Hyprchroma" in path.read_text(errors="replace")
    except OSError:
        return False


def always_generated(path):
    return True


# How to tell Hyprchroma's own output from a genuine original, per snapshot key.
# Capture is create-once, so a plugin update cannot overwrite a good baseline --
# but if the state directory is lost while the generated files are still on disk,
# the next capture would record Hyprchroma's own colors as the "original" and
# every later restore would reinstate them. These probes stop that.
HYPRCHROMA_IMPORT = '@import url("hyprchroma.css");'


def has_hyprchroma_import(path):
    """Either shape of our output in a gtk.css: the import line this writes
    now, or a whole file written by a version that owned gtk.css outright."""
    text = read_capped(path)
    if text is None:
        return False
    return HYPRCHROMA_IMPORT in text or GENERATED_MARKER in text


def strip_hyprchroma_import(path):
    """The user's gtk.css without our line, or None if that was all of it.

    A backup must never carry Hyprchroma's own output: restoring it would put
    back an import of a stylesheet the restore just deleted, and the next
    capture would take that as the user's original and keep it forever."""
    text = read_capped(path)
    if text is None:
        return None
    # An older version wrote the whole file, so there is no user content in it
    # to keep and nothing to hand back.
    if GENERATED_MARKER in text:
        return None
    kept = [row for row in text.splitlines() if row.strip() != HYPRCHROMA_IMPORT]
    remaining = "\n".join(kept).strip()
    return remaining + "\n" if remaining else None


GENERATED_PROBES = {
    "gtk3_hyprchroma_css": generated_by_marker,
    "gtk4_hyprchroma_css": generated_by_marker,
    # gtk.css is the user's; what is ours in it is the one import line.
    "gtk3_css": has_hyprchroma_import,
    "gtk4_css": has_hyprchroma_import,
    "kdeglobals": generated_kdeglobals,
    "hyprchroma_colors": always_generated,
    "pear_css": always_generated,
}

# Files that are Hyprchroma's in their entirety once a probe recognizes them, so
# a capture records them absent and stores nothing -- which is also their correct
# stock value, Omarchy writing none of them. A gtk.css carrying the generated
# header is ours whole; one without it is the user's and is captured normally.
# gtk.css is the user's: only an import line is added to it, so it is backed
# up as their file. What is wholly generated is the stylesheet it points at.
WHOLLY_GENERATED = frozenset({"hyprchroma_colors", "pear_css",
                              "gtk3_hyprchroma_css", "gtk4_hyprchroma_css"})

# kdeglobals is the one file Hyprchroma shares with its owner: KDE and the user
# keep real settings there. These are the parts Hyprchroma writes -- whole
# sections it replaces from the generated scheme, and individual keys it sets in
# sections it does not own -- mirroring lib/sync-qt-kde-theme.
HYPRCHROMA_KDE_SECTION_PREFIXES = ("[Colors:", "[ColorEffects:")
HYPRCHROMA_KDE_SECTIONS = frozenset({"[WM]"})
HYPRCHROMA_KDE_KEYS = {
    "[General]": {"ColorScheme", "ColorSchemeHash"},
    "[KDE]": {"contrast"},
    "[UiSettings]": {"ColorScheme"},
    "[Icons]": {"Theme"},
}


def strip_generated_kdeglobals(path):
    """kdeglobals with everything Hyprchroma wrote removed, or None if nothing
    of the user's is left.

    A backup must never hold Hyprchroma's own output: restoring it would put
    back the colors the restore was meant to remove, and capturing it again
    later would carry the same content forward indefinitely."""
    try:
        lines = path.read_text(errors="replace").splitlines()
    except OSError:
        return None

    kept, section, owned = [], None, False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            # "[Colors:Header][Inactive]" is a subgroup of a section we own.
            section = stripped
            owned = (section in HYPRCHROMA_KDE_SECTIONS
                     or section.startswith(HYPRCHROMA_KDE_SECTION_PREFIXES))
            if not owned:
                kept.append(line)
            continue
        if owned:
            continue
        if section in HYPRCHROMA_KDE_KEYS and "=" in stripped:
            if stripped.split("=", 1)[0].strip() in HYPRCHROMA_KDE_KEYS[section]:
                continue
        kept.append(line)

    # Drop sections left with nothing under them, then decide if anything real
    # survived at all.
    result, index = [], 0
    while index < len(kept):
        line = kept[index].strip()
        if line.startswith("[") and line.endswith("]"):
            body = []
            probe = index + 1
            while probe < len(kept):
                nxt = kept[probe].strip()
                if nxt.startswith("[") and nxt.endswith("]"):
                    break
                if nxt:
                    body.append(kept[probe])
                probe += 1
            if body:
                result.append(kept[index])
                result.extend(body)
            index = probe
            continue
        if line:
            result.append(kept[index])
        index += 1

    return "\n".join(result) + "\n" if result else None


GENERATED_CLEANERS = {"kdeglobals": strip_generated_kdeglobals,
                      "gtk3_css": strip_hyprchroma_import,
                      "gtk4_css": strip_hyprchroma_import}


def snapshot_file(snapshot_dir, manifest, key, path):
    files = manifest.setdefault("files", {})
    if key in files:
        return
    entry = {"path": str(path), "existed": path.exists()}
    generated = entry["existed"] and GENERATED_PROBES.get(key, lambda _: False)(path)
    if generated:
        # Evidence of an earlier Hyprchroma install whose state was lost. The
        # gsettings values captured alongside this are suspect for the same
        # reason, so flag the manifest as a whole rather than just this entry.
        entry["generated"] = True
        manifest["captureTainted"] = True
    cleaned = None
    if generated:
        if key in WHOLLY_GENERATED:
            entry["existed"] = False
        else:
            cleaner = GENERATED_CLEANERS.get(key)
            cleaned = cleaner(path) if cleaner else None
            # Nothing of the user's left once Hyprchroma's part is removed, so
            # there is no original to keep.
            if cleaned is None:
                entry["existed"] = False
    if entry["existed"]:
        backup = snapshot_dir / "files" / key
        backup.parent.mkdir(parents=True, exist_ok=True)
        if cleaned is None:
            shutil.copy2(path, backup)
        else:
            atomic_write(backup, cleaned)
            shutil.copystat(path, backup)
        entry["backup"] = str(backup.relative_to(snapshot_dir))
    files[key] = entry


def strip_generated_pear_themes(snapshot_dir, manifest):
    """Drop Hyprchroma's stylesheet from the captured Pear config.

    config.json is a genuine user file, so it is always captured; only the entry
    Hyprchroma appends to options.themes is ours. Removing it from the backup
    keeps a re-capture from recording our own stylesheet as part of the original.
    """
    entry = manifest.get("files", {}).get("pear_config", {})
    if not entry.get("existed"):
        return
    backup = snapshot_dir / entry["backup"]
    try:
        config = json.loads(backup.read_text())
    except (OSError, ValueError):
        return
    options = config.get("options")
    if not isinstance(options, dict) or not isinstance(options.get("themes"), list):
        return
    kept = [theme for theme in options["themes"]
            if "hyprchroma" not in os.path.basename(str(theme)).lower()]
    if kept == options["themes"]:
        return
    options["themes"] = kept
    atomic_write(backup, json.dumps(config, indent="\t") + "\n")
    manifest["captureTainted"] = True


def snapshot_gsettings(manifest):
    # Create-once per key rather than for the group as a whole, so an install
    # that predates a newly managed key still records that key's original value
    # the first time this version runs, before anything overwrites it.
    values = manifest.setdefault("gsettings", {})
    for key in ("gtk-theme", "color-scheme", "accent-color", "icon-theme",
                "monospace-font-name"):
        if key in values:
            continue
        value = command_output(["gsettings", "get", "org.gnome.desktop.interface", key])
        if value is not None:
            values[key] = value


def snapshot(state_dir, data_dir, target):
    snapshot_dir = state_dir / "original"
    manifest_path = snapshot_dir / "manifest.json"
    manifest = read_json(manifest_path)
    home = Path.home()

    if target == "gtk":
        snapshot_file(snapshot_dir, manifest, "gtk3_css", home / ".config/gtk-3.0/gtk.css")
        snapshot_file(snapshot_dir, manifest, "gtk4_css", home / ".config/gtk-4.0/gtk.css")
        snapshot_file(snapshot_dir, manifest, "gtk3_hyprchroma_css",
                      home / ".config/gtk-3.0/hyprchroma.css")
        snapshot_file(snapshot_dir, manifest, "gtk4_hyprchroma_css",
                      home / ".config/gtk-4.0/hyprchroma.css")
        snapshot_gsettings(manifest)
    elif target == "qt-kde":
        snapshot_file(snapshot_dir, manifest, "kdeglobals", home / ".config/kdeglobals")
        snapshot_file(snapshot_dir, manifest, "hyprchroma_colors", home / ".local/share/color-schemes/Hyprchroma.colors")
    elif target == "pear":
        snapshot_file(snapshot_dir, manifest, "pear_config", home / ".config/YouTube Music/config.json")
        snapshot_file(snapshot_dir, manifest, "pear_css", home / ".config/YouTube Music/hyprchroma.css")
        strip_generated_pear_themes(snapshot_dir, manifest)
    else:
        raise SystemExit(f"unknown target: {target}")

    write_json(manifest_path, manifest)


def restore_file(snapshot_dir, entry):
    path = Path(entry["path"])
    if not entry.get("existed"):
        path.unlink(missing_ok=True)
        return
    backup = snapshot_dir / entry["backup"]
    # Replace the destination rather than writing into it. shutil.copy2 opens
    # the destination by name and follows a symlink left there, so a link where
    # a config file used to be would send the restore somewhere else entirely;
    # atomic_write renames over the path, which replaces the link itself.
    atomic_write(path, backup.read_bytes(), mode=stat.S_IMODE(backup.stat().st_mode))


def restore_gsettings(values):
    for key, value in values.items():
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", key, value], check=False)


def config_home():
    return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")


def find_ini_key(lines, group, key):
    """Index and value of key inside [group], or (None, None). Subgroups such as
    "[UiSettings][Foo]" are deliberately not matched."""
    in_group = False
    for index, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            in_group = stripped == f"[{group}]"
        elif in_group and "=" in stripped:
            name, value = stripped.split("=", 1)
            if name.strip() == key:
                return index, value.strip()
    return None, None


def write_lines(path, lines):
    atomic_write(path, "".join(lines))


MAX_FOREIGN_FILE = 8 * 1024 * 1024


def read_capped(path, limit=MAX_FOREIGN_FILE):
    """Read a file this program does not own, or None if it will not fit.

    An rc file in ~/.config is written by whichever application owns it and has
    no bound Hyprchroma controls, while this runs unattended on every window
    event. At most limit+1 characters are read, so the size is judged from what
    was actually read rather than from a stat that could change underneath.
    Undecodable content returns None too, so the caller skips it rather than
    rewriting a file through replacement characters."""
    try:
        with path.open("r") as handle:
            data = handle.read(limit + 1)
    except (OSError, UnicodeDecodeError):
        return None
    return None if len(data) > limit else data


def readable_rc_files():
    for path in sorted(config_home().glob("*rc")):
        if path.is_symlink() or not path.is_file():
            continue
        text = read_capped(path)
        if text is None:
            continue
        yield path, text.splitlines(keepends=True)


def clear_app_color_schemes(state_dir):
    """A KDE app can pin its own color scheme in its rc file, which wins over
    kdeglobals and leaves that app ignoring the synchronized palette. Record the
    original value once, then drop the key so every app follows kdeglobals. The
    key is only ever removed, never rewritten to track the theme; the
    uninstaller puts the original back."""
    manifest_path = state_dir / "original/manifest.json"
    manifest = read_json(manifest_path)
    recorded = manifest.setdefault("appColorSchemes", {})
    running = running_executables()

    for path, lines in readable_rc_files():
        index, value = find_ini_key(lines, APP_COLOR_SCHEME_GROUP, APP_COLOR_SCHEME_KEY)
        if index is None:
            continue
        # "kdenliverc" belongs to "kdenlive". A running app rewrites its rc on
        # exit, so editing it underneath would be undone anyway; leave the file,
        # and the process, exactly as they are. It is cleared the next time a
        # sync runs with the app closed.
        owner = path.name[:-2] if path.name.endswith("rc") else path.name
        if owner in running:
            print(f"Hyprchroma: {owner} is running; leaving its pinned "
                  f"{value} color scheme alone until it is restarted")
            continue
        recorded.setdefault(str(path), {"existed": True, "value": value})
        del lines[index]
        write_lines(path, lines)
        print(f"Hyprchroma: cleared the {value} color scheme pinned in {path.name}")

    write_json(manifest_path, manifest)


def restore_app_color_schemes(manifest):
    for raw_path, entry in manifest.get("appColorSchemes", {}).items():
        if not entry.get("existed"):
            continue
        path = Path(raw_path)
        if path.is_symlink() or not path.is_file():
            continue
        text = read_capped(path)
        if text is None:
            continue
        lines = text.splitlines(keepends=True)
        restored = f"{APP_COLOR_SCHEME_KEY}={entry.get('value', '')}\n"
        index, _ = find_ini_key(lines, APP_COLOR_SCHEME_GROUP, APP_COLOR_SCHEME_KEY)
        if index is not None:
            lines[index] = restored
        else:
            group = next(
                (i for i, line in enumerate(lines)
                 if line.strip() == f"[{APP_COLOR_SCHEME_GROUP}]"),
                None,
            )
            if group is None:
                if lines and not lines[-1].endswith("\n"):
                    lines.append("\n")
                lines.extend([f"[{APP_COLOR_SCHEME_GROUP}]\n", restored])
            else:
                lines.insert(group + 1, restored)
        write_lines(path, lines)


def running_executables():
    """Basenames of every running executable. Used to tell whether an app would
    simply write a change back, and to leave it alone if so."""
    names = set()
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            names.add(os.path.basename(os.readlink(entry / "exe")))
        except OSError:
            continue
    return names


def last_sync_at(state_dir):
    """When Hyprchroma last wrote the palette, as epoch seconds.

    The honest baseline for a standing display: an application is showing the
    previous theme if it started before Hyprchroma last wrote one, which is not
    the same question as when the Omarchy theme last changed."""
    stamp = read_json(state_dir / "status.json").get("lastSync")
    if not isinstance(stamp, str):
        return None
    try:
        return int(datetime.fromisoformat(stamp).timestamp())
    except ValueError:
        return None


def theme_switched_at():
    """When the active Omarchy theme was selected, as epoch seconds."""
    marker = Path(
        os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state"
    ) / "omarchy/current/theme.name"
    try:
        return int(marker.stat().st_mtime)
    except OSError:
        return None


def process_started_at(pid):
    """Epoch seconds when a process began, from its start time in jiffies."""
    try:
        with open(f"/proc/{pid}/stat", "rb") as handle:
            fields = handle.read().rsplit(b") ", 1)[1].split()
        with open("/proc/stat") as handle:
            boot = next(int(line.split()[1]) for line in handle
                        if line.startswith("btime "))
    except (OSError, StopIteration, IndexError, ValueError):
        return None
    return boot + int(fields[19]) // os.sysconf("SC_CLK_TCK")


def open_windows():
    """(title, class, pid) per mapped window, or None if that cannot be read.
    None means nothing is reported rather than something being guessed."""
    result = subprocess.run(["hyprctl", "-j", "clients"], stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, text=True, check=False)
    if result.returncode != 0:
        return None
    try:
        clients = json.loads(result.stdout)
    except json.JSONDecodeError:
        return None
    return [
        (window_title(c), (c.get("class") or "").lower(), c.get("pid"))
        for c in clients if c.get("pid", 0) > 0
    ]


def window_title(client):
    """The name a window keeps.

    initialTitle is what the window opened with and does not churn the way title
    does as the user moves between documents -- except for a Chromium web app,
    whose initial title is the URL it was launched from ("maps.google.com_/")
    while its current title is the page name ("Google Maps")."""
    klass = client.get("class") or ""
    if klass.startswith("chrome-") or "__" in klass:
        return client.get("title") or client.get("initialTitle") or klass or "?"
    return client.get("initialTitle") or client.get("title") or klass or "?"


def omarchy_reloaded_executables():
    """Executables Omarchy re-themes itself when the theme changes.

    Read out of Omarchy's own theme-set path rather than listed here, so it
    follows along as Omarchy gains more: the shell hot-reloads over IPC, and the
    omarchy-restart-* helpers signal terminals, TUIs and the compositor to
    reread their config. Telling someone to restart one of those would be wrong.

    Tokens are matched loosely and then intersected with what is actually
    running, so shell keywords and file paths in those scripts fall away on
    their own instead of needing a parser."""
    root = Path(os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy") / "bin"
    sources = [root / "omarchy-theme-set", *sorted(root.glob("omarchy-restart-*"))]
    tokens = set()
    for source in sources:
        try:
            tokens |= set(re.findall(r"[A-Za-z][A-Za-z0-9_-]{2,}", source.read_text()))
        except OSError:
            continue
    return tokens & running_executables()


def window_executable(pid):
    try:
        return os.path.basename(os.readlink(f"/proc/{pid}/exe"))
    except OSError:
        return None


def stale_open_apps(since=None):
    """Names of apps with a window open that started before the current theme
    was selected, so they are still drawing the previous one.

    Applications Omarchy re-themes on its own are left out, so the list is only
    what genuinely will not change until it is restarted.

    Reporting only. Nothing here signals, quits or writes to a running app: an
    open window keeps whatever it started with until its owner restarts it."""
    # Same baseline question as refresh_idle_apps: a run that just wrote the
    # palette must measure against that write, not against the last theme
    # switch, or a toggle hours later finds every open window "current" and
    # reports nothing.
    if since is None:
        since = theme_switched_at()
    windows = open_windows()
    if since is None or not windows:
        return []
    reloaded = omarchy_reloaded_executables()
    names = set()
    for title, klass, pid in windows:
        started = process_started_at(pid)
        if started is None or started >= since:
            continue
        # A terminal, TUI or the shell already picked the theme up when Omarchy
        # told it to; naming it would send someone to restart nothing.
        if window_executable(pid) in reloaded:
            continue
        name = window_display_name(title, klass)
        names.add(name[:1].upper() + name[1:])
    return sorted(names)


# Any process with KColorScheme mapped reads the colors in kdeglobals and
# reloads when they change. That is the predicate, rather than a list of KDE
# applications, so it covers ones this plugin has never heard of.
KDE_COLOR_LIBRARY = "libKF6ColorScheme"

# Bound on re-arming, so a session spent opening and closing KDE apps cannot
# leave this looping forever. The recovery service covers anything past it.
WATCH_ROUNDS = 32

# How long a waiter lingers before leaving it to the recovery service.
WATCH_TIMEOUT_SECONDS = 900

# A burst of window events -- a workspace of clients opening at login, say --
# collapses into one sync this many seconds after the last one.
EVENT_DEBOUNCE_SECONDS = 1.5


def kde_color_clients():
    """Names of running processes that would reload if kdeglobals were rewritten
    and have a window to disturb.

    Having the library mapped is not enough on its own. A process with no window
    has nothing on screen to interrupt, and treating one as a reason to hold the
    palette back is how a stray background copy of an application blocks its own
    theming indefinitely. Only windows count."""
    windows = open_windows()
    if windows is None:
        # Without a window list this cannot tell an idle process from one in
        # use, so it holds back rather than risk writing under a live window.
        return ["unknown"]
    windowed = {pid for _, _, pid in windows}
    names = set()
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit() or int(entry.name) not in windowed:
            continue
        try:
            with open(entry / "maps") as handle:
                if not any(KDE_COLOR_LIBRARY in line for line in handle):
                    continue
        except OSError:
            continue
        names.add(display_name(window_executable(entry.name) or entry.name))
    return sorted(names)


def kde_color_client_pids():
    """PIDs behind the windows that are holding the color files open."""
    windows = open_windows()
    if windows is None:
        return []
    windowed = {pid for _, _, pid in windows}
    pids = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit() or int(entry.name) not in windowed:
            continue
        try:
            with open(entry / "maps") as handle:
                if not any(KDE_COLOR_LIBRARY in line for line in handle):
                    continue
        except OSError:
            continue
        pids.append(int(entry.name))
    return pids


def hyprland_event_socket():
    """Hyprland's event stream, or None when it cannot be reached."""
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not signature or not runtime:
        return None
    path = Path(runtime) / "hypr" / signature / ".socket2.sock"
    try:
        return path if path.is_socket() else None
    except OSError:
        return None


def apply_and_check_clear(state_dir, data_dir, action):
    """Write the Qt/KDE palette -- or revert it -- and report a clear run at it."""
    if action == "revert":
        # A sync cannot do this: qtKde was disabled a moment ago, so every sync
        # from here skips the framework and the revert would never happen.
        restore(state_dir, data_dir, ("qt-kde",), "captured")
    else:
        subprocess.run(
            ["/usr/bin/hyprchroma", "--target=qt-kde", "--quiet"],
            check=False,
        )
    return not kde_color_client_pids()


def watch_windows_close(stream, state_dir, data_dir, action):
    """Write the palette once no KDE window is holding the files, waking on
    Hyprland's window events.

    The condition being waited on is a window going away, not a process ending.
    Closing a KDE application often leaves the process alive with no window --
    kdenlive routinely leaves several -- so waiting for the process to exit
    waits for something that may never happen, which is why this used to fall
    through to the recovery service a minute later."""
    stream.settimeout(WATCH_TIMEOUT_SECONDS)
    pending = b""
    while True:
        if not kde_color_client_pids() and apply_and_check_clear(state_dir, data_dir, action):
            return
        try:
            received = stream.recv(4096)
        except (TimeoutError, socket.timeout):
            return  # the recovery service covers anything past this
        if not received:
            return  # Hyprland went away
        pending += received
        while b"\n" in pending:
            line, pending = pending.split(b"\n", 1)
            if line.startswith(b"closewindow"):
                break  # re-check who is holding the files


def gdbus(*args):
    result = subprocess.run(
        ["gdbus", *args], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        text=True, check=False, timeout=10,
    )
    return result.stdout.strip() if result.returncode == 0 else None


def bus_call(dest, path, method, *args):
    return gdbus("call", "--session", "--dest", dest, "--object-path", path,
                 "--method", method, *args)


def bus_names(method):
    raw = bus_call("org.freedesktop.DBus", "/org/freedesktop/DBus",
                   f"org.freedesktop.DBus.{method}")
    return set(re.findall(r"'([A-Za-z][A-Za-z0-9_.-]+)'", raw or ""))


def connection_pid(name):
    raw = bus_call("org.freedesktop.DBus", "/org/freedesktop/DBus",
                   "org.freedesktop.DBus.GetConnectionUnixProcessID", name)
    # "(uint32 52840,)" -- match the number only, never the 32 in the type name
    found = re.search(r"uint32\s+(\d+)", raw or "")
    return int(found.group(1)) if found else None


# Only inside this namespace is "--quit" assumed. It is the GNOME convention,
# and guessing a flag at an application that does not know it could as easily
# open a window as close one.
GNOME_NAMESPACE = "org.gnome."

# How long an application's own --quit is given before escalating. Measured
# live against this project's own idle-recycle target (nautilus 50.3.1): the
# command returns in well under this, but the process it targets does not
# reliably follow within it, so this is a grace period for the polite path,
# not a promise it keeps.
QUIT_GRACE_SECONDS = 1.0

# How long a direct signal is given to take effect before the next one. Not
# GApplication's ten-second bus-release ceiling: a signal does not wait on a
# D-Bus round trip or a toolkit's own shutdown bookkeeping, so a process that
# is going to die from it does so in well under a second.
SIGNAL_GRACE_SECONDS = 1.0


def process_alive(pid):
    # kill(pid, 0) alone is not enough: a zombie still holds its pid until
    # whatever forked it reaps it, so it keeps answering this the same as a
    # running process. Whoever that parent is, it is never this daemon --
    # every target here is an independent application started by the desktop
    # session -- so waiting for a reap that is someone else's job to perform
    # would be waiting on nothing. A zombie has already released everything
    # that theming cares about: its stylesheet, its bus name. Treat it as gone.
    try:
        with open(f"/proc/{pid}/stat", "rb") as handle:
            # comm can itself contain ") ", so split from the right of the
            # last ")" rather than assume a fixed field count from the left.
            state = handle.read().rsplit(b") ", 1)[1].split()[0]
        return state != b"Z"
    except (OSError, IndexError):
        pass
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:
        # Owned by someone else, or some other reason this cannot signal it --
        # either way, not something this can wait out.
        return False
    return True


def name_has_owner(name):
    raw = bus_call("org.freedesktop.DBus", "/org/freedesktop/DBus",
                   "org.freedesktop.DBus.NameHasOwner", name)
    return raw is not None and "true" in raw


def trusted_executable(path) -> bool:
    """Whether path is a binary only root can have put there or changed.

    The file and every directory above it must be owned by root and unwritable
    by group and other, so a name taken out of a data file can never send this
    to something this account -- or any other non-root one -- could plant."""
    if not path:
        return False
    resolved = Path(os.path.realpath(str(path)))
    try:
        info = os.stat(resolved)
    except OSError:
        return False
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0:
        return False
    if info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        return False
    for parent in resolved.parents:
        try:
            above = os.stat(parent)
        except OSError:
            return False
        if above.st_uid != 0 or above.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            return False
    return True


def service_file_exec(name):
    """The binary a D-Bus service file launches, so an application's own quit
    flag can be used without keeping a list of binaries."""
    # XDG_DATA_DIRS is inherited, so the list of places to look is attacker
    # influenced in exactly the way PATH was: every root is read through
    # safe_read, which resolves and verifies the whole chain before opening,
    # and a root that fails verification is skipped rather than trusted.
    roots = [Path.home() / ".local/share"]
    roots += [Path(part) for part in (os.environ.get("XDG_DATA_DIRS")
                                      or "/usr/share").split(":") if part]
    for root in roots:
        text = safe_read(root / "dbus-1" / "services" / f"{name}.service",
                         MAX_FOREIGN_FILE)
        if text is None:
            continue
        for line in text.splitlines():
            if line.startswith("Exec="):
                try:
                    parts = shlex.split(line[len("Exec="):])
                except ValueError:
                    return None
                if not parts:
                    return None
                # A service file is data, never a command. The binary it
                # names is run only when root owns it and nobody else can
                # rewrite it or anything above it -- which allows the
                # /usr/lib helpers real services use, and refuses anything
                # planted somewhere this account can write.
                candidate = parts[0]
                if not os.path.isabs(candidate):
                    candidate = shutil.which(candidate, path=trusted_path()) or ""
                return candidate if trusted_executable(candidate) else None
    return None


def quit_application(pid, name, path):
    """End an idle application, preferring its own --quit for GNOME ones, but
    not waiting on D-Bus for a process a signal can already reach directly.

    The polite requests come first: an application's own --quit is supposed to
    reach g_application_quit() in under half a second, and failing that, its
    generic quit action is the same request by a slower route. Both go through
    GApplication's D-Bus machinery, and both were measured, live, taking far
    longer than either is supposed to -- the action's own documented ceiling is
    ten seconds, and the "fast" path was observed not making its own much
    shorter one either. This is only ever called on something open_windows()
    has already confirmed has no window on screen, so nothing visible is
    disturbed by finishing the job with a signal instead of waiting out a
    toolkit's bus timeout: SIGTERM first, which still runs normal cleanup
    handlers, then SIGKILL if even that is ignored.

    Returns whether the application is actually gone by the time this returns,
    so a caller never reports something closed that is still running -- a
    guess here is exactly what would leave a reopened window stuck on the
    stale instance rather than a fresh one."""
    if name.startswith(GNOME_NAMESPACE):
        binary = service_file_exec(name)
        if binary:
            try:
                subprocess.run([binary, "--quit"], stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, check=False, timeout=10)
            except (OSError, subprocess.SubprocessError):
                pass
            deadline = time.monotonic() + QUIT_GRACE_SECONDS
            while time.monotonic() < deadline:
                if not name_has_owner(name):
                    return True
                time.sleep(0.1)

    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.kill(pid, sig)
        except OSError:
            # Already gone, or never ours to signal -- either way, nothing
            # further to send it.
            return not process_alive(pid)
        deadline = time.monotonic() + SIGNAL_GRACE_SECONDS
        while time.monotonic() < deadline:
            if not process_alive(pid):
                return True
            time.sleep(0.05)
    return False


def has_quit_action(name, path):
    """Whether this is a well-behaved GApplication-style desktop app, which is
    what this is really asking: quit_application no longer activates this
    action itself, but exposing one is still the filter for "a signal to this
    is asking a desktop app to close," not "sending a signal to whatever else
    is D-Bus activatable and idle."""
    raw = bus_call(name, path, "org.gtk.Actions.List")
    return raw is not None and re.search(r"'quit'", raw) is not None


# Long enough that an application the user launched a moment ago, which has not
# put a window on screen yet, is never mistaken for an idle service.
LAUNCH_GRACE_SECONDS = 5


def refresh_idle_apps(since=None):
    """Quit background application services still holding the previous theme.

    GTK 4 and libadwaita read the user stylesheet once, at startup. An
    application that stayed resident after its last window closed therefore
    hands its next window the palette it started with, so closing and reopening
    it appears to do nothing. Ending the idle service means the next launch
    reads the new stylesheet -- the same approach omarchy-nautilus-theme takes
    with "nautilus -q", generalised.

    No list of applications. One qualifies only on what can be observed about
    it: D-Bus activatable, so quitting is a no-op the next launch undoes;
    running; started before the theme it would be serving; showing no window, so
    nothing on screen is touched; and exposing its own quit action, which is
    activated rather than signalling the process. Failing any check leaves it
    alone, and one already newer than the theme never qualifies, so running this
    repeatedly changes nothing."""
    # Staleness is measured against when the palette on disk was last written.
    # A theme switch and a forced run both write it now, so they pass `since`;
    # an event-driven run writes nothing new and measures against the theme
    # instead, or closing a window would quit every idle service every time.
    newer_than = since if since is not None else theme_switched_at()
    windows = open_windows()
    if newer_than is None or windows is None:
        # Without a window list an idle service cannot be told from one in use.
        return
    windowed = {klass for _, klass, _ in windows if klass}

    for name in sorted(bus_names("ListActivatableNames") & bus_names("ListNames")):
        if name.startswith("org.freedesktop.") or name.lower() in windowed:
            continue
        pid = connection_pid(name)
        if pid is None:
            continue
        started = process_started_at(pid)
        if started is None or started >= newer_than:
            continue
        path = "/" + name.replace(".", "/").replace("-", "_")
        if not has_quit_action(name, path):
            continue
        if quit_application(pid, name, path):
            print(f"Hyprchroma: closed idle {name} so its next window is themed")
        else:
            # Not even SIGKILL worked -- an uninterruptible sleep, most likely.
            # Silently doing nothing here would look identical to success in
            # the log; naming the holdout is what makes a genuine failure
            # findable instead of just a window someone reports as stale.
            print(f"Hyprchroma: {name} did not quit; its next window may still be themed")


def browser_client_pids():
    """PIDs of the default browser.

    Dark Reader's settings live inside the browser's own database, so unlike the
    KDE color files this has to wait for the processes to end rather than for a
    window to close -- and a browser leaves a good many running for a while after
    its last window goes. Since the window is already gone by then, no further
    window event arrives to prompt a retry, which is why this needs its own
    wait."""
    result = subprocess.run(
        [str(Path.home() / ".local/bin/hyprchroma-dark-reader"), "--info"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, check=False,
    )
    try:
        executables = set(json.loads(result.stdout).get("executables") or [])
    except (json.JSONDecodeError, TypeError, AttributeError):
        return []
    if not executables:
        return []
    pids = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        if window_executable(entry.name) in executables:
            pids.append(int(entry.name))
    return pids


def watch_browser_exit(state_dir, data_dir, action="sync"):
    """Apply or revert Dark Reader once the browser has actually exited.

    Waits on pidfds, so the kernel wakes this when the last process ends rather
    than anything polling for it. Re-arms if the browser spawns more while it
    waits, holds a lock so one runs at a time, and leaves anything past its
    bound to the service."""
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR") or state_dir)
    runtime.mkdir(parents=True, exist_ok=True)
    # Created following no symlink, then opened read-only: flock needs no
    # write access, so this path can never be truncated or written through.
    prepare_lock(runtime / "hyprchroma-browser-wait.lock")
    lock = open(runtime / "hyprchroma-browser-wait.lock", "r")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # another waiter already holds this

    if action == "revert":
        # Switching the toggle off already recorded darkReader as disabled, so a
        # sync would now skip this framework entirely. Call the helper directly
        # instead, or the revert the toggle promised would never happen.
        finish = [str(Path.home() / ".local/bin/hyprchroma-dark-reader"),
                  "--restore", "--mode=captured",
                  "--state-dir", str(state_dir), "--status", str(state_dir / "status.json")]
    else:
        finish = ["/usr/bin/hyprchroma",
                  "--target=dark-reader", "--quiet"]
    for _ in range(WATCH_ROUNDS):
        pids = browser_client_pids()
        if not pids:
            subprocess.run(finish, check=False)
            return

        descriptors = []
        for pid in pids:
            try:
                descriptors.append(os.pidfd_open(pid))
            except OSError:
                continue  # exited between listing it and waiting on it
        if not descriptors:
            continue

        poller = select.poll()
        for descriptor in descriptors:
            poller.register(descriptor, select.POLLIN)
        remaining = set(descriptors)
        while remaining:
            events = poller.poll(WATCH_TIMEOUT_SECONDS * 1000)
            if not events:
                return  # nothing ended in all that time; the service covers it
            for descriptor, _ in events:
                poller.unregister(descriptor)
                os.close(descriptor)
                remaining.discard(descriptor)


def watch_events(state_dir, data_dir):
    """Run a sync whenever a window opens or closes.

    After the theme-set hook the changes this service still has to notice -- a
    changed default browser, a newly installed Pear Desktop, an application
    closing that a deferred Dark Reader or Qt/KDE write was waiting on -- all
    surface on Hyprland's event stream as a window opening or closing. Waking on
    those and letting the sync decide whether anything actually moved replaces
    polling on a fixed interval.

    One runs at a time. When the stream closes -- or before it exists, at
    login -- this returns and the unit restarts it. A change in that gap is
    caught by the sync the daemon runs before watching, and then by the next
    window event."""
    lock_dir = Path(os.environ.get("XDG_RUNTIME_DIR") or state_dir)
    lock_dir.mkdir(parents=True, exist_ok=True)
    # Created following no symlink, then opened read-only: flock needs no
    # write access, so this path can never be truncated or written through.
    prepare_lock(lock_dir / "hyprchroma-watch-events.lock")
    lock = open(lock_dir / "hyprchroma-watch-events.lock", "r")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # another watcher already owns the stream

    stream_path = hyprland_event_socket()
    if stream_path is None:
        # No stream yet -- Hyprland not up at login. Returning lets the unit
        # restart us in a moment; there is no fallback timer behind this any
        # more, so silently carrying on would mean never watching at all.
        return

    sync = ["/usr/bin/hyprchroma", "--quiet"]
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as stream:
        stream.connect(str(stream_path))
        pending = b""
        deadline = None
        while True:
            if deadline is None:
                stream.settimeout(None)
            else:
                stream.settimeout(max(0.05, deadline - time.monotonic()))
            try:
                chunk = stream.recv(4096)
            except (TimeoutError, socket.timeout):
                subprocess.run(sync, check=False)
                deadline = None
                continue
            if not chunk:
                return  # Hyprland went away
            pending += chunk
            while b"\n" in pending:
                line, pending = pending.split(b"\n", 1)
                if (line.startswith((b"openwindow>>", b"closewindow>>"))
                        and deadline is None):
                    deadline = time.monotonic() + EVENT_DEBOUNCE_SECONDS


def watch_kde_exit(state_dir, data_dir, action="sync"):
    """Wait for the KDE applications holding the color files to exit, then
    write the palette once -- or revert it, when a toggle was switched off.

    The wait is on pidfds handed to poll(), so the kernel wakes this the moment
    a process ends. Nothing is polled and nothing is signalled: it sleeps at zero
    cost until there is something to do. One instance at a time, so a waiter per
    theme change cannot pile up, and a pid that has already gone simply never
    registers."""
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR") or state_dir)
    runtime.mkdir(parents=True, exist_ok=True)
    # Created following no symlink, then opened read-only: flock needs no
    # write access, so this path can never be truncated or written through.
    prepare_lock(runtime / "hyprchroma-kde-wait.lock")
    lock = open(runtime / "hyprchroma-kde-wait.lock", "r")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # another waiter already holds this

    stream_path = hyprland_event_socket()
    if stream_path is not None:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as stream:
            try:
                stream.connect(str(stream_path))
            except OSError:
                stream_path = None
            else:
                watch_windows_close(stream, state_dir, data_dir, action)
                return

    # No event stream: fall back to waiting for the processes themselves to end.
    # Re-arm rather than hand off. A replacement spawned by a later sync cannot
    # take this lock while it is still held, so handing off would leave that
    # replacement exiting and nothing watching at all.
    for _ in range(WATCH_ROUNDS):
        descriptors = []
        for pid in kde_color_client_pids():
            try:
                descriptors.append(os.pidfd_open(pid))
            except OSError:
                continue  # exited between listing it and waiting on it

        if descriptors:
            poller = select.poll()
            for descriptor in descriptors:
                poller.register(descriptor, select.POLLIN)
            remaining = set(descriptors)
            while remaining:
                for descriptor, _ in poller.poll():
                    poller.unregister(descriptor)
                    os.close(descriptor)
                    remaining.discard(descriptor)

        if apply_and_check_clear(state_dir, data_dir, action):
            return  # nothing holding the files, so that run wrote the palette


def gsettings_reset(key):
    subprocess.run(["gsettings", "reset", "org.gnome.desktop.interface", key], check=False)


def reauthor_omarchy_gsettings():
    """Let Omarchy write the three interface keys it owns.

    omarchy-theme-set-gnome sets exactly gtk-theme, color-scheme and icon-theme
    from the current theme and calls no hook, so this re-authors them without
    running a whole theme switch -- which would fire the Hyprchroma theme-set
    hook and immediately re-apply what was just reverted."""
    if shutil.which("omarchy-theme-set-gnome") is None:
        return False
    subprocess.run(["omarchy-theme-set-gnome"], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True


def rewrite_pear_themes(chosen):
    """Replace options.themes in Pear's config.json and nothing else.

    That file also carries window geometry, the current track URL and plugin
    state, none of which Hyprchroma ever writes. Copying the whole backup over
    it -- which is what restoring it as a plain file did -- would roll all of
    that back to whenever the snapshot was taken."""
    path = Path.home() / ".config/YouTube Music/config.json"
    if path.is_symlink() or not path.is_file():
        return
    try:
        config = json.loads(path.read_text())
    except (OSError, ValueError):
        return
    options = config.get("options")
    if not isinstance(options, dict):
        return
    current = options.get("themes")
    if not isinstance(current, list):
        current = []
    wanted = chosen(current)
    if wanted == current:
        return
    options["themes"] = wanted
    atomic_write(path, json.dumps(config, indent="\t") + "\n")


def captured_pear_themes(snapshot_dir, manifest):
    entry = manifest.get("files", {}).get("pear_config", {})
    if not entry.get("existed"):
        return []
    try:
        backup = json.loads((snapshot_dir / entry["backup"]).read_text())
    except (OSError, ValueError):
        return None
    themes = backup.get("options", {}).get("themes")
    return themes if isinstance(themes, list) else []


def restore_target_captured(snapshot_dir, manifest, target):
    for key in TARGET_FILE_KEYS[target]:
        # Pear's config.json is edited in place rather than copied back whole.
        if key == "pear_config":
            continue
        entry = manifest.get("files", {}).get(key)
        if entry is not None:
            restore_file(snapshot_dir, entry)
    if target == "pear":
        captured = captured_pear_themes(snapshot_dir, manifest)
        if captured is not None:
            rewrite_pear_themes(lambda current: captured)
    elif target == "gtk":
        restore_gsettings(manifest.get("gsettings", {}))
        # Restoring the backup already drops our import, because the backup is
        # the user's own gtk.css from before any of this. Where there was no
        # backup -- the file did not exist, or held only our line -- this takes
        # the line out rather than leaving an import of a file just deleted.
        for directory in (".config/gtk-3.0", ".config/gtk-4.0"):
            remove_import(Path.home() / directory / "gtk.css",
                          '@import url("hyprchroma.css");')
    elif target == "qt-kde":
        restore_app_color_schemes(manifest)


def restore_target_stock(snapshot_dir, manifest, target):
    home = Path.home()
    for relative in STOCK_ABSENT_FILES[target]:
        (home / relative).unlink(missing_ok=True)
    if target == "pear":
        rewrite_pear_themes(lambda current: [
            entry for entry in current
            if "hyprchroma" not in os.path.basename(str(entry)).lower()
        ])
    elif target == "gtk":
        # Stock means Omarchy's own defaults, which include no import of ours.
        for directory in (".config/gtk-3.0", ".config/gtk-4.0"):
            remove_import(Path.home() / directory / "gtk.css",
                          '@import url("hyprchroma.css");')
        for key in HYPRCHROMA_ONLY_GSETTINGS:
            gsettings_reset(key)
        if not reauthor_omarchy_gsettings():
            # Without Omarchy on PATH there is nothing authoritative to ask, so
            # fall back to what was captured for the keys Omarchy owns.
            restore_gsettings({key: value
                               for key, value in manifest.get("gsettings", {}).items()
                               if key in OMARCHY_OWNED_GSETTINGS})
    elif target == "qt-kde":
        # Omarchy pins no per-app color scheme, so it has no stock value to
        # offer. The recorded one is the app's own: Hyprchroma only ever deleted
        # these keys and never wrote them, so it cannot be Hyprchroma output.
        restore_app_color_schemes(manifest)
        try:
            (home / ".local/share/color-schemes").rmdir()
        except OSError:
            pass


def restore(state_dir, data_dir, targets, mode):
    snapshot_dir = state_dir / "original"
    manifest = read_json(snapshot_dir / "manifest.json")
    for target in targets:
        if mode == "stock":
            restore_target_stock(snapshot_dir, manifest, target)
        else:
            restore_target_captured(snapshot_dir, manifest, target)
        print(f"Hyprchroma: {target} reverted to its {mode} state")

    if set(targets) != set(TARGETS):
        return
    # Hyprchroma's own runtime state, which belongs to no framework. Only
    # cleared on a full revert; a single toggle must not drop settings.json,
    # which is where that toggle was just recorded.
    for path in (data_dir / "dark-reader-theme.json",
                 state_dir / "settings.json",
                 state_dir / "status.json",
                 state_dir / "last-stale-notify"):
        path.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser()
    # write-file and prepare-lock act on one named path and touch neither
    # tree, so they are not made to supply directories they will not use.
    # Everything else still is, checked below.
    parser.add_argument("--state-dir", type=Path)
    parser.add_argument("--data-dir", type=Path)
    sub = parser.add_subparsers(dest="command", required=True)
    snap = sub.add_parser("snapshot")
    snap.add_argument("--target", required=True)
    rest = sub.add_parser("restore")
    rest.add_argument("--target", default="all", choices=("all",) + TARGETS)
    rest.add_argument("--mode", default="captured", choices=("captured", "stock"))
    sub.add_parser("clear-app-color-schemes")
    stale = sub.add_parser("report-stale-apps")
    stale.add_argument("--written-now", action="store_true",
                       help="the palette was just written, so judge staleness against now")
    stale.add_argument("--since-last-sync", action="store_true",
                       help="judge staleness against the last recorded sync, for a standing display")
    sub.add_parser("kde-color-clients")
    kde_wait = sub.add_parser("watch-kde-exit")
    kde_wait.add_argument("--action", default="sync", choices=("sync", "revert"))
    sub.add_parser("watch-events")
    idle = sub.add_parser("refresh-idle-apps")
    idle.add_argument("--written-now", action="store_true",
                      help="the palette was just written, so judge staleness against now")
    # Shell callers route their writes through here rather than using mktemp
    # and a redirection of their own: a redirection names its destination by
    # path every time it runs, while this goes through the same verified
    # directory descriptor as every other write in the plugin.
    imports = sub.add_parser("ensure-import")
    imports.add_argument("--path", required=True)
    imports.add_argument("--line", required=True)

    unimport = sub.add_parser("remove-import")
    unimport.add_argument("--path", required=True)
    unimport.add_argument("--line", required=True)

    write = sub.add_parser("write-file")
    write.add_argument("--path", required=True)
    write.add_argument("--mode", default=None)

    lock = sub.add_parser("prepare-lock")
    lock.add_argument("--path", required=True)

    browser_wait = sub.add_parser("watch-browser-exit")
    browser_wait.add_argument("--action", default="sync", choices=("sync", "revert"))
    args = parser.parse_args()

    # write-file and prepare-lock act on one named path; everything else
    # works on the state and data trees and must be given both.
    if args.command not in ("write-file", "prepare-lock",
                            "ensure-import", "remove-import") and (
            args.state_dir is None or args.data_dir is None):
        parser.error("--state-dir and --data-dir are required for " + args.command)

    if args.command == "ensure-import":
        print(ensure_import(Path(args.path), args.line))
        return
    if args.command == "remove-import":
        print(remove_import(Path(args.path), args.line))
        return

    if args.command == "snapshot":
        snapshot(args.state_dir, args.data_dir, args.target)
    elif args.command == "clear-app-color-schemes":
        clear_app_color_schemes(args.state_dir)
    elif args.command == "report-stale-apps":
        if args.written_now:
            since = int(time.time()) - LAUNCH_GRACE_SECONDS
        elif args.since_last_sync:
            since = last_sync_at(args.state_dir)
        else:
            since = None
        for name in stale_open_apps(since):
            print(name)
    elif args.command == "kde-color-clients":
        for name in kde_color_clients():
            print(name)
    elif args.command == "watch-kde-exit":
        watch_kde_exit(args.state_dir, args.data_dir, args.action)
    elif args.command == "watch-events":
        watch_events(args.state_dir, args.data_dir)
    elif args.command == "refresh-idle-apps":
        refresh_idle_apps(
            int(time.time()) - LAUNCH_GRACE_SECONDS if args.written_now else None)
    elif args.command == "write-file":
        # Masked to the permission bits: nothing this writes is ever meant to
        # be setuid, setgid or sticky, and accepting those made a theme helper
        # into a way of setting them.
        atomic_write(Path(args.path), sys.stdin.buffer.read(),
                     (int(args.mode, 8) & 0o777) if args.mode else None)
    elif args.command == "prepare-lock":
        prepare_lock(Path(args.path))
    elif args.command == "watch-browser-exit":
        watch_browser_exit(args.state_dir, args.data_dir, args.action)
    else:
        targets = TARGETS if args.target == "all" else (args.target,)
        restore(args.state_dir, args.data_dir, targets, args.mode)


if __name__ == "__main__":
    main()
