    ("Firefox", (".mozilla/firefox", ".config/mozilla/firefox",
                 ".var/app/org.mozilla.firefox/.mozilla/firefox",
                 ".var/app/org.mozilla.firefox/config/mozilla/firefox")),
    ("Floorp", (".floorp", ".config/floorp", ".var/app/one.ablaze.floorp/.floorp")),
    ("Zen", (".zen", ".config/zen", ".var/app/app.zen_browser.zen/.zen")),
    ("LibreWolf", (".librewolf", ".config/librewolf", ".config/librewolf/librewolf",
                   ".var/app/io.gitlab.librewolf-community/.librewolf")),
    ("Waterfox", (".waterfox", ".config/waterfox", ".var/app/net.waterfox.waterfox/.waterfox")),
)
VIVALDI_ROOTS = (".config/vivaldi", ".config/vivaldi-snapshot",
                 ".var/app/com.vivaldi.Vivaldi/config/vivaldi")
VIVALDI_EXECUTABLES = {"vivaldi-bin"}

BROWSER_STYLESHEET = "hyprchroma.css"
USERCHROME_IMPORT = '@import url("hyprchroma.css");'
# userChrome.css is ignored unless this is on. user.js is re-applied at every
# start, so the line is the whole of the change and removing it is the revert.
