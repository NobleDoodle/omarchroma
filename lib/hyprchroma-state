# Commands are resolved from a fixed, verified set of directories, never from
# the inherited PATH: this runs unattended from the shell service, so a
# directory someone else can write to appearing earlier in PATH would hand them
# every command this helper runs. /usr/local/bin and /usr/local/sbin are gone
# from the set -- nothing this plugin invokes lives there, and they are the
# entries most often left group-writable on a real machine. /bin, /sbin and
# /usr/sbin are gone too: on a usrmerge system they are symlinks to /usr/bin
# and contribute nothing. What remains is checked rather than assumed.
def _overflow_uid() -> int:
    """The uid the kernel shows for an owner not mapped into this namespace.

    Under systemd's sandboxing every read-only bind mount -- /, /usr, /home --
    reports this instead of root, because root is not mapped. Such a directory
    cannot be written by anyone here at all, so it is trusted like root's; the
    mode check below still applies to it either way."""
    try:
        return int(pathlib_read("/proc/sys/kernel/overflowuid"))
    except (OSError, ValueError):
        return 65534


def pathlib_read(name: str) -> str:
    with open(name, "r", encoding="ascii") as handle:
        return handle.read().strip()


_OVERFLOW_UID = _overflow_uid()


PATH_CANDIDATES = ("/usr/bin", "/usr/share/omarchy/bin")


def trusted_path() -> str:
    keep = []
    for directory in PATH_CANDIDATES:
        try:
            info = os.stat(directory)
        except OSError:
            continue
        if not stat.S_ISDIR(info.st_mode):
            continue
        # Root, or an owner not mapped into this namespace -- under systemd's
        # sandboxing /usr reports the overflow uid rather than root, and a
        # directory owned by an unmapped uid cannot be written by anyone here.
        if info.st_uid not in (0, _OVERFLOW_UID):
            continue
        if info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            continue
        keep.append(directory)
    # With nothing surviving there is nothing to resolve against, and an empty
    # PATH fails every lookup silently. Fall back to the same fixed identities
    # the shell entry points use rather than to whatever was inherited.
    return ":".join(keep) if keep else ":".join(PATH_CANDIDATES)


os.environ["PATH"] = trusted_path()

