class BrowserProfile(namedtuple("BrowserProfile", "anchor parts")):
    """A browser profile folder: the anchor it lies beneath, resolved the way
    the user's own folders are, and the components below it.

    Below the anchor is the browser's to write -- and for a Flatpak, its
    sandbox's -- so those components are only ever walked following no link,
    never resolved by pathname: a link planted there must stop the walk, not
    steer a write or a removal somewhere outside the profile."""
    __slots__ = ()

    @property
    def path(self):
        return Path(self.anchor, *self.parts)

    @property
    def name(self):
        return self.path.name

    def __str__(self):
        return str(self.path)

    def open(self, *below, create=False):
        return open_beneath(self.anchor, self.parts + below, create)


def open_child(descriptor, part, create=False):
    """A verified descriptor for one directory below descriptor, never a link:
    O_NOFOLLOW refuses one outright rather than resolving it."""
    if part in ("", ".", "..") or "/" in part or "\0" in part:
        raise OSError(f"refusing the path component {part!r}")
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
    try:
        nested = os.open(part, flags, dir_fd=descriptor)
    except FileNotFoundError:
        if not create:
            raise
        os.mkdir(part, SAFE_DIR_MODE, dir_fd=descriptor)
        nested = os.open(part, flags, dir_fd=descriptor)
    try:
        _verify_directory(nested, part)
    except BaseException:
        os.close(nested)
        raise
    return nested


def open_beneath(anchor, parts, create=False):
    """A verified descriptor for anchor/parts that follows no link below anchor.

    open_dir resolves its whole path first, which is right for the user's own
    folders and wrong below one another program writes into."""
    descriptor = open_dir(anchor)
    try:
        for part in parts:
            nested = open_child(descriptor, part, create)
            os.close(descriptor)
            descriptor = nested
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def lstat_at(descriptor, name):
    try:
        return os.stat(name, dir_fd=descriptor, follow_symlinks=False)
    except FileNotFoundError:
        return None


def read_at(descriptor, name, limit=None):
    """The text of a regular file named relative to a verified directory, or
    None. No link is followed and nothing but a regular file is read -- opened
    blocking, a fifo planted where a file belongs would stall this unattended
    service indefinitely. The bytes are decoded as they are, without newline
    translation, so what is written back is exactly what was read."""
    limit = MAX_FOREIGN_FILE if limit is None else limit
    try:
        opened = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
                         dir_fd=descriptor)
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(opened).st_mode):
            return None
        chunks, size = [], 0
        while size <= limit:
            chunk = os.read(opened, min(1 << 20, limit + 1 - size))
            if not chunk:
                break
            chunks.append(chunk)
            size += len(chunk)
    except OSError:
        return None
    finally:
        os.close(opened)
    data = b"".join(chunks)
    if len(data) > limit:
        return None
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        return None


def browser_root(home, relative):
    """(root, anchor) for one of the roots above. A Flatpak's data folder,
    ~/.var/app/<id>, is the bind mount its sandbox writes into and cannot
    itself replace, so that is the anchor; a native root is its own."""
    parts = Path(relative).parts
    if parts[:2] == (".var", "app"):
        return Path(home, *parts), Path(home, *parts[:3])
    return Path(home, *parts), Path(home, *parts)


def root_beneath(root, anchor):
    root = Path(root)
    anchor = root if anchor is None else Path(anchor)
    return os.path.realpath(anchor), root.relative_to(anchor).parts


def read_root_file(base, inner, name):
    try:
        descriptor = open_beneath(base, inner)
    except OSError:
        return None
    try:
        return read_at(descriptor, name)
    finally:
        os.close(descriptor)


def is_profile_folder(profile):
    try:
        os.close(profile.open())
    except OSError:
        return False
    return True


def firefox_profiles(root, anchor=None):
    """The profiles a Firefox-family profiles.ini lists -- only those below root.

    profiles.ini allows absolute paths, and a browser rewrites its own
    profiles.ini, so an entry anywhere else is refused: accepting it would let
    one browser aim this at any directory the account owns. Every folder is
    then reached from the anchor following no link, which also refuses a
    profile folder that is itself a link out."""
    base, inner = root_beneath(root, anchor)
    text = read_root_file(base, inner, "profiles.ini")
    if text is None:
        return []
    lexical = (Path(root), Path(base, *inner))
    found = set()
    section, path, relative = "", None, "1"

    def flush():
        if not (section.startswith("Profile") and path):
            return
        if relative == "1":
            parts = None if path.startswith("/") else Path(path).parts
        else:
            parts = next((Path(path).relative_to(prefix).parts for prefix in lexical
                          if Path(path).is_relative_to(prefix)), None)
        if not parts or any(part in ("", ".", "..") for part in parts):
            return
        candidate = BrowserProfile(base, inner + parts)
        if is_profile_folder(candidate):
            found.add(candidate)

    for line in text.splitlines():
        stripped = line.strip()
        header = re.fullmatch(r"\[(.+)\]", stripped)
        if header:
            flush()
            section, path, relative = header.group(1), None, "1"
            continue
        key, separator, value = stripped.partition("=")
        if separator and key.strip() == "Path":
            path = value.strip()
        elif separator and key.strip() == "IsRelative":
            relative = value.strip()
    flush()
    return sorted(found)


def vivaldi_profiles(root, anchor=None):
    """Vivaldi profile folders named in Local State, below root."""
    base, inner = root_beneath(root, anchor)
    text = read_root_file(base, inner, "Local State")
    if text is None:
        return []
    try:
        cache = json.loads(text).get("profile", {}).get("info_cache", {})
    except (ValueError, AttributeError, RecursionError):
        return []
    names = set(cache) if isinstance(cache, dict) else set()
    names.add("Default")
    found = []
    for name in sorted(names):
        if not re.fullmatch(r"[A-Za-z0-9 _-]+", str(name)):
            continue
        candidate = BrowserProfile(base, inner + (name,))
        try:
            descriptor = candidate.open()
        except OSError:
            continue
        try:
            present = lstat_at(descriptor, "Preferences") is not None
        finally:
            os.close(descriptor)
        if present:
            found.append(candidate)
    return found


def detected_browsers():
    """(name, family, profiles) for every supported browser with a profile here."""
    home = Path.home()
    detected = []
    for name, roots in FIREFOX_FAMILY:
        profiles = sorted({profile for relative in roots
                           for profile in firefox_profiles(*browser_root(home, relative))})
        if profiles:
            detected.append((name, "firefox", profiles))
    profiles = sorted({profile for relative in VIVALDI_ROOTS
                       for profile in vivaldi_profiles(*browser_root(home, relative))})
    if profiles:
        detected.append(("Vivaldi", "vivaldi", profiles))
    return detected


def browser_palette(data_dir):
    """The palette the sync wrote for this framework, or None if it is unusable."""
    text = read_capped(data_dir / "browsers-theme.json")
    try:
        palette = json.loads(text) if text is not None else None
    except ValueError:
        return None
    if not isinstance(palette, dict) or palette.get("mode") not in ("dark", "light"):
        return None
    if not all(HEX_COLOR.fullmatch(str(palette.get(key, ""))) for key in BROWSER_COLORS):
        return None
    return palette


