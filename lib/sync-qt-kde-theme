#!/usr/bin/env bash
set -euo pipefail

# Commands are resolved from a fixed, verified set of directories rather than
# from whatever PATH was inherited. Most of these scripts run unattended --
# from the shell service and from theme hooks -- so a directory someone else
# can write to appearing earlier in PATH would hand them every command run
# here; the installer and uninstaller pin it for the same reason even though
# a person starts those.
# /usr/local/bin and /usr/local/sbin are not in the set -- nothing this plugin
# invokes lives there, and they are the entries most often left group-writable
# on a real machine -- and /bin, /sbin and /usr/sbin are usrmerge symlinks to
# /usr/bin that add nothing. What is left is checked to be root-owned and
# unwritable by anyone else rather than assumed to be. /usr/bin/stat is named
# absolutely because it is the trust root the check is anchored to: if it
# cannot be trusted, nothing here can be.
hyprchroma_trusted_path() {
  local directory owner mode trusted=""
  for directory in /usr/bin /usr/share/omarchy/bin; do
    [[ -d $directory ]] || continue
    read -r owner mode < <(/usr/bin/stat -Lc '%u %a' "$directory" 2>/dev/null) || continue
    # Root, or an owner not mapped into this namespace: under systemd's
    # sandboxing /usr reports the overflow uid rather than root.
    [[ $owner == 0 || $owner == "$(</proc/sys/kernel/overflowuid)" ]] || continue
    (( (8#$mode & 8#022) == 0 )) || continue
    trusted="${trusted:+$trusted:}$directory"
  done
  # With stat itself unavailable there is nothing to validate against, so fall
  # back to the same fixed identities rather than to the inherited PATH.
  printf '%s' "${trusted:-/usr/bin:/usr/share/omarchy/bin}"
}
PATH=$(hyprchroma_trusted_path)
export PATH

# Derived from this script's own resolved location, never from the
# environment: it chooses which executable performs every write. See the same
# reasoning in bin/hyprchroma.
HYPRCHROMA_LIB=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")


# The palette is resolved once and kept, not asked for a key at a time: each
# call costs a process start, and a full sync reads more than fifty keys.
declare -A PALETTE
PALETTE_LOADED=0

load_palette() {
  local key value
  while IFS=$'\t' read -r key value; do
    [[ -n $key ]] && PALETTE[$key]=$value
  done < <("$HYPRCHROMA_LIB/hyprchroma-palette" --all 2>&1)
  if [[ -z ${PALETTE[background]:-} ]]; then
    echo "sync-qt-kde-theme: no palette available; see 'hyprchroma palette --template'" >&2
    exit 1
  fi
  PALETTE_LOADED=1
}

color() {
  # Deliberately does not load: every call site is $(color x), which runs in a
  # subshell, so anything this set would be discarded and the palette would be
  # re-resolved once per key. The caller loads it once, in the parent shell.
  local value=${PALETTE[$1]:-}
  if [[ ! $value =~ ^#[0-9A-Fa-f]{6}$ ]]; then
    echo "sync-qt-kde-theme: invalid palette color '$1': $value" >&2
    exit 1
  fi
  printf '%s' "$value"
}


rgb() {
  local hex=${1#\#}
  printf '%d,%d,%d' \
    "$((16#${hex:0:2}))" \
    "$((16#${hex:2:2}))" \
    "$((16#${hex:4:2}))"
}

# Omarchy themes each name an icon theme in icons.theme, but nothing in Omarchy
# applies it, so KDE and GTK drift apart or fall back to whatever was set last.
omarchy_icon_theme() {
  local name_file="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme.name"
  [[ -f $name_file ]] || return 0
  local slug directory value
  slug=$(tr -d "\\n" <"$name_file")
  [[ -n $slug ]] || return 0
  directory=$(omarchy theme dir "$slug" 2>/dev/null) || return 0
  [[ -f "$directory/icons.theme" ]] || return 0
  value=$(tr -d "\\n" <"$directory/icons.theme")
  [[ $value =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 0
  # A theme may name an icon set that is not installed; the stock vantablack and
  # white themes both do. Applying one would leave apps with no icons at all.
  [[ -d "/usr/share/icons/$value" || \
     -d "${XDG_DATA_HOME:-$HOME/.local/share}/icons/$value" ]] || {
    printf "%s: Omarchy theme requests icon theme '%s', which is not installed\\n" \
      "$1" "$value" >&2
    return 0
  }
  printf "%s" "$value"
}

load_palette
background=$(color background)
dark_background=$(color dark_background)
darker_background=$(color darker_background)
lighter_background=$(color lighter_background)
foreground=$(color foreground)
dark_foreground=$(color dark_foreground)
light_foreground=$(color light_foreground)
bright_foreground=$(color bright_foreground)
accent=$(color accent)
selection=$(color selection)
selection_foreground=$(color selection_foreground)
red=$(color red)
green=$(color green)
yellow=$(color yellow)
blue=$(color blue)
magenta=$(color magenta)

background_rgb=$(rgb "$background")
dark_background_rgb=$(rgb "$dark_background")
darker_background_rgb=$(rgb "$darker_background")
lighter_background_rgb=$(rgb "$lighter_background")
foreground_rgb=$(rgb "$foreground")
dark_foreground_rgb=$(rgb "$dark_foreground")
light_foreground_rgb=$(rgb "$light_foreground")
bright_foreground_rgb=$(rgb "$bright_foreground")
accent_rgb=$(rgb "$accent")
selection_rgb=$(rgb "$selection")
selection_foreground_rgb=$(rgb "$selection_foreground")
red_rgb=$(rgb "$red")
green_rgb=$(rgb "$green")
yellow_rgb=$(rgb "$yellow")
blue_rgb=$(rgb "$blue")
magenta_rgb=$(rgb "$magenta")

scheme_dir="${XDG_DATA_HOME:-$HOME/.local/share}/color-schemes"
scheme_file="$scheme_dir/Hyprchroma.colors"
kdeglobals="${XDG_CONFIG_HOME:-$HOME/.config}/kdeglobals"
mkdir -p "$scheme_dir" "$(dirname "$kdeglobals")"
# The scheme is composed in memory and handed to the state helper, which
# creates its temporary and renames it relative to a directory descriptor it
# has verified. Nothing here names the destination directory a second time,
# so no ancestor can be swapped between composing the file and placing it.

write_roles() {
  local normal_bg=$1 alternate_bg=$2 normal_fg=$3 inactive_fg=$4
  cat <<EOF
BackgroundAlternate=$alternate_bg
BackgroundNormal=$normal_bg
DecorationFocus=$accent_rgb
DecorationHover=$accent_rgb
ForegroundActive=$accent_rgb
ForegroundInactive=$inactive_fg
ForegroundLink=$blue_rgb
ForegroundNegative=$red_rgb
ForegroundNeutral=$yellow_rgb
ForegroundNormal=$normal_fg
ForegroundPositive=$green_rgb
ForegroundVisited=$magenta_rgb
EOF
}

scheme_content=$({
  cat <<EOF
[ColorEffects:Disabled]
Color=$dark_foreground_rgb
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=$light_foreground_rgb
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
EOF
  write_roles "$lighter_background_rgb" "$selection_rgb" \
    "$foreground_rgb" "$dark_foreground_rgb"
  cat <<EOF

[Colors:Complementary]
EOF
  write_roles "$darker_background_rgb" "$dark_background_rgb" \
    "$bright_foreground_rgb" "$dark_foreground_rgb"
  cat <<EOF

[Colors:Header]
EOF
  write_roles "$dark_background_rgb" "$lighter_background_rgb" \
    "$foreground_rgb" "$dark_foreground_rgb"
  cat <<EOF

[Colors:Header][Inactive]
EOF
  write_roles "$darker_background_rgb" "$dark_background_rgb" \
    "$dark_foreground_rgb" "$dark_foreground_rgb"
  cat <<EOF

[Colors:Selection]
EOF
  write_roles "$selection_rgb" "$accent_rgb" \
    "$selection_foreground_rgb" "$light_foreground_rgb"
  cat <<EOF

[Colors:Tooltip]
EOF
  write_roles "$lighter_background_rgb" "$dark_background_rgb" \
    "$bright_foreground_rgb" "$light_foreground_rgb"
  cat <<EOF

[Colors:View]
EOF
  write_roles "$dark_background_rgb" "$background_rgb" \
    "$foreground_rgb" "$dark_foreground_rgb"
  cat <<EOF

[Colors:Window]
EOF
  write_roles "$background_rgb" "$lighter_background_rgb" \
    "$foreground_rgb" "$dark_foreground_rgb"
  cat <<EOF

[General]
ColorScheme=Hyprchroma
Name=Hyprchroma
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground=$dark_background_rgb
activeBlend=$bright_foreground_rgb
activeForeground=$bright_foreground_rgb
inactiveBackground=$darker_background_rgb
inactiveBlend=$dark_foreground_rgb
inactiveForeground=$dark_foreground_rgb
EOF
})

scheme_changed=1
if [[ $scheme_content == "$(cat "$scheme_file" 2>/dev/null)" ]]; then
  scheme_changed=0
else
  printf '%s\n' "$scheme_content" |
    "$HYPRCHROMA_LIB/hyprchroma-state" write-file --path "$scheme_file" --mode 644
fi

globals_changed=$(
  python3 - "$HYPRCHROMA_LIB/hyprchroma-state" "$scheme_file" "$kdeglobals" "$(omarchy_icon_theme sync-qt-kde-theme)" <<'PY'
import sys; HELPER = sys.argv.pop(1)  # this installation's own helper, handed over by the shell
import hashlib
import os
import stat
import subprocess
import sys
from pathlib import Path

scheme_path = Path(sys.argv[1])
globals_path = Path(sys.argv[2])
icon_theme = sys.argv[3] if len(sys.argv) > 3 else ""
scheme_text = scheme_path.read_text()
current_text = globals_path.read_text() if globals_path.exists() else ""
scheme_hash = hashlib.sha1(scheme_path.read_bytes()).hexdigest()


def chunks(text):
    preamble = []
    sections = []
    current = None
    for line in text.splitlines():
        if line.startswith("[") and line.endswith("]"):
            current = [line]
            sections.append(current)
        elif current is None:
            preamble.append(line)
        else:
            current.append(line)
    return preamble, sections


def set_key(section, key, value):
    result = [section[0]]
    written = False
    for line in section[1:]:
        if line.strip().startswith(f"{key}="):
            if not written:
                result.append(f"{key}={value}")
                written = True
        else:
            result.append(line)
    if not written:
        result.append(f"{key}={value}")
    return result


_, scheme_sections = chunks(scheme_text)
managed = [
    section
    for section in scheme_sections
    if section[0].startswith("[Colors:")
    or section[0].startswith("[ColorEffects:")
    or section[0] == "[WM]"
]

preamble, existing_sections = chunks(current_text)
output_sections = []
found_general = False
found_kde = False
found_ui_settings = False
found_icons = False
for section in existing_sections:
    header = section[0]
    if (
        header.startswith("[Colors:")
        or header.startswith("[ColorEffects:")
        or header == "[WM]"
    ):
        continue
    if header == "[General]":
        section = set_key(section, "ColorScheme", "Hyprchroma")
        section = set_key(section, "ColorSchemeHash", scheme_hash)
        found_general = True
    elif header == "[KDE]":
        section = set_key(section, "contrast", "4")
        found_kde = True
    elif header == "[Icons]" and icon_theme:
        # KDE reads its icon theme here. Without it, the gtk3 platform theme
        # decides, so KDE and GTK can disagree about which set to draw from.
        section = set_key(section, "Theme", icon_theme)
        found_icons = True
    elif header == "[UiSettings]":
        # KColorSchemeManager, which every KXmlGui app instantiates, reads the
        # active scheme from [UiSettings] ColorScheme and ignores the one in
        # [General]. Without it the manager overwrites the palette the platform
        # theme supplied with its compiled-in Breeze defaults. KConfig merges
        # kdeglobals into every application's config, so setting it here reaches
        # every KDE app without touching a single per-application file.
        section = set_key(section, "ColorScheme", "Hyprchroma")
        found_ui_settings = True
    output_sections.append(section)

if not found_general:
    output_sections.append([
        "[General]",
        "ColorScheme=Hyprchroma",
        f"ColorSchemeHash={scheme_hash}",
    ])
if not found_kde:
    output_sections.append(["[KDE]", "contrast=4"])
if not found_ui_settings:
    output_sections.append(["[UiSettings]", "ColorScheme=Hyprchroma"])
if not found_icons and icon_theme:
    output_sections.append(["[Icons]", f"Theme={icon_theme}"])
output_sections.extend(managed)

parts = []
if preamble:
    parts.append("\n".join(preamble).rstrip())
parts.extend("\n".join(section).rstrip() for section in output_sections)
updated_text = "\n\n".join(part for part in parts if part) + "\n"

if updated_text == current_text:
    print(0)
else:
    # Handed to the state helper, which creates its temporary and renames it
    # relative to a directory descriptor it has verified. This was the fifth
    # copy of an atomic_write that made the temporary name exclusive but still
    # resolved the destination directory by pathname.
    mode = (
        stat.S_IMODE(globals_path.stat().st_mode)
        if globals_path.exists()
        else 0o600
    )
    subprocess.run(
        [HELPER,
         "write-file", "--path", str(globals_path), "--mode", format(mode, "o")],
        input=updated_text.encode(),
        check=True,
    )
    print(1)
PY
)

# Ask running apps to re-read kdeglobals, best effort.
#
# The KF5-era org.kde.KGlobalSettings.notifyChange this used to send has no
# implementation left in KF6, so nothing could have been receiving it. Its
# documented replacement is KConfigWatcher, which listens for ConfigChanged on
# org.kde.kconfig.notify at the config's object path, and that is what is sent
# below.
#
# It is not known to work. A real KConfigWatcher registers exactly the match
# rule this emits against, yet none was seen reacting to it on a session without
# Plasma -- with the group's keys sent as an array of strings or as the array of
# byte arrays a QByteArrayList marshals to, and whether or not the file had just
# changed. So do not count on this repainting anything: KDE apps may still need
# a restart to pick up a new palette. It is left in because it is the correct
# mechanism, costs one signal, and a Plasma session may well act on it.
#
# dbus-send cannot express the dictionary argument at all, and gdbus only infers
# an array of strings when the value is bare rather than wrapped in a variant,
# so the payload below must stay unwrapped.
if (( scheme_changed || globals_changed )) && \
   [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]] && command -v gdbus >/dev/null; then
  notify_payload=$(python3 - "$scheme_file" <<'NOTIFY'
import sys
from pathlib import Path

groups = {}
current = None
for line in Path(sys.argv[1]).read_text().splitlines():
    line = line.strip()
    if line.startswith("[") and line.endswith("]"):
        # "[Colors:Header][Inactive]" is a subgroup; watchers key off the parent.
        current = line[1:-1].split("][", 1)[0]
        groups.setdefault(current, set())
    elif current and "=" in line:
        groups[current].add(line.split("=", 1)[0])
groups.setdefault("General", set()).update({"ColorScheme", "ColorSchemeHash"})
groups.setdefault("KDE", set()).add("contrast")


def quote(value):
    return "'" + value.replace("\\", "\\\\").replace("'", "\\'") + "'"


print("{" + ", ".join(
    f"{quote(group)}: [{', '.join(quote(key) for key in sorted(keys))}]"
    for group, keys in sorted(groups.items()) if keys
) + "}")
NOTIFY
  )
  gdbus emit --session --object-path /kdeglobals \
    --signal org.kde.kconfig.notify.ConfigChanged "$notify_payload" >/dev/null 2>&1 || true
fi
