Target = namedtuple("Target", "browser name family profile")

# A profile folder name as Chromium makes them: Default, Profile 1, and so on.
# It becomes a path component, so nothing that could leave the root passes.
PROFILE_NAME = re.compile(r"\A[A-Za-z0-9 _-]+\Z")


def contained(root: Path, candidate: Path) -> Path | None:
    """candidate resolved, if it is a directory strictly inside root resolved."""
    base = os.path.realpath(root)
    resolved = os.path.realpath(candidate)
    if resolved == base or os.path.commonpath([base, resolved]) != base:
        return None
    return Path(resolved) if os.path.isdir(resolved) else None


def chromium_profiles(root: Path) -> list[Path]:
    """The profiles a Chromium-family Local State names, and Default."""
    state = read_capped_json(root / "Local State").get("profile")
    state = state if isinstance(state, dict) else {}
    cache = state.get("info_cache")
    names = set(cache) if isinstance(cache, dict) else set()
    names.add("Default")
    if isinstance(state.get("last_used"), str):
        names.add(state["last_used"])
    found = []
    for name in sorted(names, key=str):
        if not PROFILE_NAME.match(str(name)):
            continue
        directory = contained(root, root / name)
        if directory is not None and (directory / "Preferences").is_file():
            found.append(directory)
    return found


def firefox_profiles(root: Path) -> list[Path]:
    """Every profile a Firefox-family profiles.ini lists, inside root.

    profiles.ini allows absolute paths. One pointing outside the browser's own
    folder is refused rather than followed, so the file cannot aim this at any
    other directory the account owns."""
    text = read_capped(root / "profiles.ini")
    if text is None:
        return []
    parser = configparser.RawConfigParser(strict=False)
    try:
        parser.read_string(text)
    except configparser.Error:
        return []
    found = set()
    for section in parser.sections():
        if not section.startswith("Profile"):
            continue
        path = parser.get(section, "Path", fallback="")
        if not path:
            continue
        relative = parser.get(section, "IsRelative", fallback="1") == "1"
        directory = contained(root, root / path if relative else Path(path))
        if directory is not None:
            found.add(directory)
    return sorted(found)


def dark_reader_targets() -> list:
    """Every profile of every supported browser that has Dark Reader installed."""
    targets, seen = [], set()
    for browser, spec in BROWSERS.items():
        family = spec["family"]
        for root in spec["roots"]:
            root = Path(root).expanduser()
            profiles = firefox_profiles(root) if family == "firefox" else chromium_profiles(root)
            for profile in profiles:
                if profile in seen:
                    continue
                seen.add(profile)
                installed = (firefox_dark_reader_installed(profile) if family == "firefox"
                             else chromium_dark_reader_installed(profile))
                if installed:
                    targets.append(Target(browser, spec["name"], family, profile))
    return targets


def running_executable(pid: str) -> str | None:
    """The executable a process runs. A browser updated while it is open keeps
    running the replaced binary, which the kernel reports with " (deleted)"
    after its path -- the same browser, and still holding its databases."""
    try:
        executable = os.path.basename(os.readlink(f"/proc/{pid}/exe"))
    except OSError:
        return None
    return executable.removesuffix(" (deleted)")


def pids_running(executables) -> list[int]:
    expected = set(executables)
    return [int(entry.name) for entry in Path("/proc").iterdir()
            if entry.name.isdigit() and running_executable(entry.name) in expected]


def profile_holders(profile: Path) -> list[int]:
    """PIDs with a Gecko profile's lock file open: the browser running on it.

    Exact where a process name is not -- Zen runs as zen-bin, say -- and the
    lock symlink beside it, left by a crash or a kill, says nothing about
    whether anything is running."""
    lock = os.path.join(os.path.realpath(profile), ".parentlock")
    holders = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            descriptors = os.listdir(entry / "fd")
        except OSError:
            continue
        for descriptor in descriptors:
            try:
                if os.readlink(entry / "fd" / descriptor) == lock:
                    holders.append(int(entry.name))
                    break
            except OSError:
                continue
    return holders


def target_pids(target) -> list[int]:
    """The processes that must exit before this profile's Dark Reader storage
    is written: the browser holding the profile. A Chromium profile's browser
    is known by its executable, a Gecko one by the profile lock it holds."""
    if target.family == "firefox":
        return profile_holders(target.profile)
    return pids_running(BROWSERS[target.browser]["executables"])


def browser_info() -> dict:
    """Where Dark Reader is, and which of those browsers are open now."""
    targets = dark_reader_targets()
    running = {}
    for target in targets:
        pids = target_pids(target)
        if pids:
            running.setdefault(target.name, set()).update(pids)
    return {
        "installed": bool(targets),
        "browsers": sorted({target.name for target in targets}),
        "profiles": [str(target.profile) for target in targets],
        # Changes when Dark Reader appears in, or goes from, any profile, so a
        # sync that would otherwise find nothing changed themes it at once.
        "signature": ";".join(f"{target.browser}:{target.profile}" for target in targets),
        "running": [{"name": name, "pids": sorted(pids)} for name, pids in sorted(running.items())],
    }


# -- captures -------------------------------------------------------------------
SNAPSHOT = Path("original") / "dark-reader.json"


def empty_snapshot() -> dict:
    return {"version": 2, "targets": {}}


def load_snapshot(state_dir: Path) -> dict | None:
    """The captures, one per profile, or None if the file is unusable.

    Keyed by profile and only ever looked up for a profile found on disk: a
    capture never supplies where it is restored to. The state directory is
    writable by anything running as this account, and a capture that named its
    own database could aim a restore at any database the account owns --
    another extension's storage included."""
    path = state_dir / SNAPSHOT
    if not path.exists():
        return empty_snapshot()
    snapshot = read_capped_json(path)
    if snapshot.get("version") == 2 and isinstance(snapshot.get("targets"), dict):
        return snapshot
    if "browserDesktop" in snapshot:
        # Written back at once: the migration reads status.json's single-browser
        # fields, and the next status write drops them, so a migration kept
        # only in memory would lose a browser themed without a capture.
        snapshot = migrate_snapshot(snapshot, state_dir)
        save_snapshot(state_dir, snapshot)
        return snapshot
    return None


def save_snapshot(state_dir: Path, snapshot: dict) -> None:
    atomic_write(state_dir / SNAPSHOT, json.dumps(snapshot, indent=2) + "\n")


def browser_for_desktop(desktop: object) -> str | None:
    return next((browser for browser, spec in BROWSERS.items()
                 if desktop in spec["desktops"]), None)


def migrate_snapshot(legacy: dict, state_dir: Path) -> dict:
    """A capture from the releases that themed only the default browser.

    Those captured the first default browser and never another: one themed
    after the default changed has no original to go back to. status.json names
    the last one themed, and if that is not the captured one it is recorded as
    themed without a capture, which a revert resets to Dark Reader's own
    defaults rather than leaving it themed for good."""
    snapshot = empty_snapshot()
    browser = browser_for_desktop(legacy.get("browserDesktop"))
    profile = legacy.get("browserProfile")
    if browser and isinstance(profile, str):
        entry = {"browser": browser, "captured": True}
        if BROWSERS[browser]["family"] == "firefox":
            entry.update(dataExisted=bool(legacy.get("dataExisted")), data=legacy.get("data") or {})
        else:
            entry.update(extensionId=Path(str(legacy.get("database", ""))).name,
                         entries=legacy.get("entries") or {})
        snapshot["targets"][os.path.realpath(profile)] = entry
    status = read_capped_json(state_dir / "status.json")
    themed, browser = status.get("browserProfile"), browser_for_desktop(status.get("browserDesktop"))
    if (browser and isinstance(themed, str) and status.get("darkReader") == "synchronized"
            and os.path.realpath(themed) not in snapshot["targets"]):
        snapshot["targets"][os.path.realpath(themed)] = {"browser": browser, "captured": False}
    return snapshot


def write_status(path: Path | None, **values: object) -> None:
    if path is None:
        return
    current = read_capped_json(path)
    # Written by the releases that themed one browser; the lists replace them.
    for legacy in ("browser", "browserDesktop", "browserProfile"):
        current.pop(legacy, None)
    current.update(values)
    atomic_write(path, json.dumps(current, indent=2) + "\n")


# -- one profile -------------------------------------------------------------------
class Pending(Exception):
    """The browser took the database between the check and the write."""


def load_plyvel():
    try:
        import plyvel
    except ImportError:
        raise RuntimeError("python-plyvel is required for Chromium browsers") from None
    return plyvel


def chromium_database(target) -> tuple[str, Path]:
    extension = chromium_extension_id(target.profile)
    return extension, target.profile / "Sync Extension Settings" / extension


def open_leveldb(plyvel, database: Path, create: bool):
    try:
        return plyvel.DB(str(database), create_if_missing=create)
    except plyvel.IOError as error:
        # The running check is not atomic with this open: the browser can start,
        # or take the lock for its own writes, in between. The one error LevelDB
        # raises for "someone else has it open" is treated exactly like the
        # check finding it running; anything else is a real failure.
        if "lock" not in str(error).lower():
            raise
        raise Pending() from None


PALETTE_KEYS = {
    "darkColorScheme",
    "darkSchemeBackgroundColor",
    "darkSchemeTextColor",
    "scrollbarColor",
    "selectionColor",
    "styleSystemControls",
    "stylesheet",
}


def recolored(entries: object, theme: dict) -> object:
    """customThemes or presets with the palette written into each, in place."""
    if isinstance(entries, list):
        for entry in entries:
            entry_theme = entry.get("theme") if isinstance(entry, dict) else None
            if isinstance(entry_theme, dict):
                entry_theme.update({name: theme[name] for name in PALETTE_KEYS if name in theme})
    return entries


def apply_chromium(target, theme: dict, capture) -> None:
    plyvel = load_plyvel()
    extension, database = chromium_database(target)
    os.close(open_dir(database, create=True))
    with open_leveldb(plyvel, database, create=True) as db:
        capture(lambda: {"extensionId": extension, "entries": {
            key.decode(): {"existed": (value := db.get(key)) is not None,
                           "value": base64.b64encode(value).decode() if value is not None else ""}
            for key in MANAGED_KEYS}})
        db.put(b"theme", json.dumps(theme, separators=(",", ":")).encode())
        db.put(b"enabled", b"true")
        db.put(b"enabledByDefault", b"true")
        db.put(b"detectDarkTheme", b"false")
        db.put(b"automation", b'{"enabled":false,"mode":"","behavior":"OnOff"}')
        db.put(b"changeBrowserTheme", b"false")
        db.put(b"syncSettings", b"true")
        for key in (b"customThemes", b"presets"):
            raw = db.get(key)
            if raw is None:
                continue
            try:
                entries = json.loads(raw)
            except (ValueError, RecursionError):
                continue
            db.put(key, json.dumps(recolored(entries, theme), separators=(",", ":")).encode())


def apply_firefox(target, theme: dict, capture) -> None:
    database = target.profile / "storage-sync-v2.sqlite"
    data = firefox_storage_data(database)
    capture(lambda: {"dataExisted": bool(data), "data": json.loads(json.dumps(data))})
    data["theme"] = theme
    data["enabled"] = True
    data["enabledByDefault"] = True
    data["detectDarkTheme"] = False
    data["automation"] = {"enabled": False, "mode": "", "behavior": "OnOff"}
    data["changeBrowserTheme"] = False
    data["syncSettings"] = True
    for key in ("customThemes", "presets"):
        recolored(data.get(key), theme)
    write_firefox_storage_data(database, data)


def reset_target(target) -> None:
    """Dark Reader's own defaults: the managed keys deleted, so it rebuilds them."""
    if target.family == "firefox":
        database = target.profile / "storage-sync-v2.sqlite"
        if database.exists():
            with sqlite3.connect(database) as connection:
                connection.execute("DELETE FROM storage_sync_data WHERE ext_id = ?",
                                   (FIREFOX_EXTENSION_ID,))
                connection.commit()
        return
    plyvel = load_plyvel()
    _, database = chromium_database(target)
    if not database.is_dir():
        return
    with open_leveldb(plyvel, database, create=False) as db:
        for key in MANAGED_KEYS:
            db.delete(key)


def restore_target(target, entry: dict) -> None:
    if entry.get("captured") is False:
        reset_target(target)
        return
    if target.family == "firefox":
        database = target.profile / "storage-sync-v2.sqlite"
        if entry.get("dataExisted"):
            data = entry.get("data")
            if not isinstance(data, dict):
                raise ValueError("the capture's data is not an object")
            write_firefox_storage_data(database, data)
        elif database.exists():
            with sqlite3.connect(database) as connection:
                connection.execute("DELETE FROM storage_sync_data WHERE ext_id = ?",
                                   (FIREFOX_EXTENSION_ID,))
                connection.commit()
        return
    plyvel = load_plyvel()
    extension, database = chromium_database(target)
    if entry.get("extensionId") != extension:
        # Captured from another extension instance in this profile -- a store
        # install replaced by a side-loaded one, say. Its values are not this
        # one's to be handed.
        raise ValueError("captured from a different Dark Reader in this profile")
    os.close(open_dir(database, create=True))
    with open_leveldb(plyvel, database, create=True) as db:
        for key, value in (entry.get("entries") or {}).items():
            raw_key = key.encode()
            # Only the keys a capture takes, so a capture cannot be used to
            # write or delete anything else in the extension's storage.
            if raw_key not in MANAGED_KEYS or not isinstance(value, dict):
                continue
            if value.get("existed"):
                db.put(raw_key, base64.b64decode(value["value"], validate=True))
            else:
                db.delete(raw_key)


# -- every profile ---------------------------------------------------------------
def for_each_target(targets, act, verb: str) -> tuple[list, list, list]:
    """act on every target whose browser is closed. Returns (done, pending,
    failed) browser names. One profile that fails -- a database the browser
    left corrupt, say -- is no reason to leave every other one as it was."""
    done, pending, failed = [], [], []
    for target in targets:
        if target_pids(target):
            pending.append(target.name)
            continue
        try:
            if act(target) is not False:
                done.append(target.name)
        except Pending:
            pending.append(target.name)
        except Exception as error:  # noqa: BLE001 -- reported, and counted as failed
            print(f"Hyprchroma: could not {verb} Dark Reader in {target.name} "
                  f"({target.profile.name}): {error}", file=sys.stderr)
            failed.append(target.name)
    return sorted(set(done)), sorted(set(pending)), sorted(set(failed))


def outcome(done, pending, failed, finished: str, waiting: str, status_file) -> int:
    write_status(status_file, darkReader=waiting if pending else finished,
                 darkReaderBrowsers=done, darkReaderPending=pending)
    if done:
        print(f"Hyprchroma: Dark Reader {finished} for {', '.join(done)}")
    if pending:
        print(f"Hyprchroma: Dark Reader waits for {' and '.join(pending)} to close")
    return 1 if failed else 2 if pending else 0


def apply_theme(theme_file: Path, state_dir: Path | None, status_file: Path | None) -> int:
    theme = read_capped_json(theme_file)
    if not theme:
        print(f"Hyprchroma: cannot read the Dark Reader theme {theme_file}", file=sys.stderr)
        return 1
    targets = dark_reader_targets()
    if not targets:
        write_status(status_file, darkReader="not-installed", darkReaderBrowsers=[],
                     darkReaderPending=[])
        print("Hyprchroma: Dark Reader is not installed in any supported browser")
        return 0
    snapshot = load_snapshot(state_dir) if state_dir is not None else empty_snapshot()
    if snapshot is None:
        # Rewriting it would lose every original in it; theming without it would
        # leave nothing to revert to.
        print("Hyprchroma: the Dark Reader snapshot is unreadable; not theming anything",
              file=sys.stderr)
        return 1

    def act(target):
        def capture(read):
            # Taken once per profile, and on disk before anything is written over
            # what it records.
            key = str(target.profile)
            if state_dir is None or key in snapshot["targets"]:
                return
            snapshot["targets"][key] = {"browser": target.browser, "captured": True, **read()}
            save_snapshot(state_dir, snapshot)
        (apply_firefox if target.family == "firefox" else apply_chromium)(target, theme, capture)

    return outcome(*for_each_target(targets, act, "theme"),
                   "synchronized", "pending-browser-exit", status_file)


def restore_theme(state_dir: Path, status_file: Path | None) -> int:
    snapshot = load_snapshot(state_dir)
    if snapshot is None:
        print("Hyprchroma: the Dark Reader snapshot is unreadable; not restoring it",
              file=sys.stderr)
        return 1
    if not snapshot["targets"]:
        print("Hyprchroma: no Dark Reader snapshot found")
        return 0

    def act(target):
        entry = snapshot["targets"].get(str(target.profile))
        if not isinstance(entry, dict) or entry.get("browser") != target.browser:
            return False  # never themed by this
        restore_target(target, entry)
        return True

    return outcome(*for_each_target(dark_reader_targets(), act, "restore"),
                   "restored", "restore-pending-browser-exit", status_file)


def reset_theme(status_file: Path | None) -> int:
    """Return Dark Reader to its factory defaults, in every profile.

    Deliberately independent of the captures. On a machine that has had
    Hyprchroma before, a recorded "original" can itself be Hyprchroma output --
    its theme and every builtIn entry in customThemes already name the generated
    scheme -- so replaying it reinstates a previous generation rather than
    stock. Deleting the managed keys instead lets Dark Reader rebuild its own
    defaults, and costs nothing user-made: Hyprchroma only ever overwrote the
    built-in schemes in place."""
    return outcome(*for_each_target(dark_reader_targets(), reset_target, "reset"),
                   "reset", "reset-pending-browser-exit", status_file)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--info", action="store_true")
    parser.add_argument("--theme", type=Path)
    parser.add_argument("--state-dir", type=Path)
    parser.add_argument("--status", type=Path)
    parser.add_argument("--restore", action="store_true")
    parser.add_argument("--mode", default="captured", choices=("captured", "stock"))
    args = parser.parse_args()

    if args.info:
        print(json.dumps(browser_info()))
        return 0
    if args.restore:
        if args.mode == "stock":
            return reset_theme(args.status)
        if args.state_dir is None:
            parser.error("--state-dir is required with --restore --mode=captured")
        return restore_theme(args.state_dir, args.status)
    if args.theme is None:
        parser.error("--theme is required unless --info is used")
    return apply_theme(args.theme, args.state_dir, args.status)


if __name__ == "__main__":
    raise SystemExit(main())
