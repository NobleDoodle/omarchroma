# A Chromium extension id is exactly 32 characters drawn from a-p: it is a
# hex digest re-encoded into that alphabet. Anything else is not an id.
CHROMIUM_ID_PATTERN = re.compile(r"\A[a-p]{32}\Z")


def valid_extension_id(value: object) -> bool:
    """Whether this is shaped like an extension id.

    The id becomes a path component under the profile, and one of the places it
    is read from is a key in the browser's Preferences JSON. A key is just text,
    so without this a crafted one -- "../../../.." and so on -- would send the
    theme write outside the profile entirely."""
    return isinstance(value, str) and bool(CHROMIUM_ID_PATTERN.match(value))


MAX_FOREIGN_FILE = 8 * 1024 * 1024


def open_regular(path, mode="r"):
    """Open path for reading, as a regular file only and without blocking. This
    runs unattended on every window event, and a fifo planted where a file is
    expected would otherwise block it -- and every sync queued behind it --
    indefinitely."""
    opened = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    try:
        if not stat.S_ISREG(os.fstat(opened).st_mode):
            raise OSError(f"not a regular file: {path}")
        return os.fdopen(opened, mode)
    except BaseException:
        os.close(opened)
        raise


def read_capped(path: Path, limit: int = MAX_FOREIGN_FILE) -> str | None:
    """Read a file another program owns, or None if it cannot be trusted to fit.

    A browser's Preferences or Local State is written by the browser and has no
    bound Hyprchroma controls, and this runs unattended on every window event.
    Reading at most limit+1 characters caps the memory a large file can cost
    without a stat-then-open race: the size is judged from what was actually
    read. Undecodable content also returns None, so the caller skips rather than
    processing replacement characters."""
    try:
        with open_regular(path) as handle:
            data = handle.read(limit + 1)
    except (OSError, UnicodeDecodeError):
        return None
    return None if len(data) > limit else data


def read_capped_json(path: Path):
    """Parse a file another program owns, or {} if it is unusable."""
    data = read_capped(path)
    if data is None:
        return {}
    try:
        parsed = json.loads(data)
    except (ValueError, RecursionError):
        return {}
    return parsed if isinstance(parsed, dict) else {}


# Dark Reader declares alarms, fontSettings, scripting and storage. Requiring
# storage is not a guess about branding: Hyprchroma writes the theme into the
# extension's own storage, so one that never asked for storage cannot be the
# extension being themed.
DARK_READER_REQUIRED_PERMISSION = "storage"


def looks_like_dark_reader(manifest: object) -> bool:
    if not isinstance(manifest, dict):
        return False
    name = manifest.get("name")
    if not isinstance(name, str) or name.strip().lower() != "dark reader":
        return False
    permissions = manifest.get("permissions")
    return isinstance(permissions, list) and DARK_READER_REQUIRED_PERMISSION in permissions


def chromium_dark_reader_candidates(profile: Path) -> list[str]:
    """Every installed extension that presents itself as Dark Reader."""
    found = set()

    extensions = profile / "Extensions"
    if extensions.is_dir():
        try:
            entries = sorted(extensions.iterdir())
        except OSError:
            entries = []
        for entry in entries:
            if not entry.is_dir() or not valid_extension_id(entry.name):
                continue
            for manifest in sorted(entry.glob("*/manifest.json")):
                if looks_like_dark_reader(read_capped_json(manifest)):
                    found.add(entry.name)
                    break

    # An unpacked extension has no directory here; Preferences still records it.
    settings = read_capped_json(profile / "Preferences").get("extensions", {})
    settings = settings.get("settings", {}) if isinstance(settings, dict) else {}
    if isinstance(settings, dict):
        for key, entry in settings.items():
            if not valid_extension_id(key) or not isinstance(entry, dict):
                continue
            if looks_like_dark_reader(entry.get("manifest")):
                found.add(key)

    return sorted(found)


def chromium_extension_id(profile: Path) -> str:
    """Which id Dark Reader actually has in this profile.

    Hyprchroma writes the theme into the extension's own storage, which is keyed
    by id, so guessing wrong writes it nowhere -- or into something else. The
    store id wins when it is installed. Otherwise exactly one candidate must
    present itself as Dark Reader: if several do, this refuses to choose between
    them rather than handing the theme to whichever sorted first."""
    if (profile / "Extensions" / CHROMIUM_STORE_EXTENSION_ID).is_dir():
        return CHROMIUM_STORE_EXTENSION_ID

    candidates = chromium_dark_reader_candidates(profile)
    if len(candidates) == 1:
        return candidates[0]
    if len(candidates) > 1:
        print(f"Hyprchroma: {len(candidates)} extensions present themselves as Dark Reader "
              f"({', '.join(candidates)}); not theming any of them", file=sys.stderr)

    return CHROMIUM_STORE_EXTENSION_ID


def chromium_preferences_entry(profile: Path) -> dict | None:
    preferences = profile / "Preferences"
    if not preferences.is_file():
        return None
    settings = read_capped_json(preferences).get("extensions", {})
    settings = settings.get("settings", {}) if isinstance(settings, dict) else {}
    entry = settings.get(CHROMIUM_STORE_EXTENSION_ID) if isinstance(settings, dict) else None
    return entry if isinstance(entry, dict) else None


def chromium_dark_reader_installed(profile: Path) -> bool:
    """Whether Dark Reader is really installed, not merely spoken for.

    Deliberately does not count "Sync Extension Settings/<id>": apply_theme
    creates that directory itself, so counting it made this return true for any
    browser Hyprchroma had ever themed, whether or not the extension existed.

    A bare key in Preferences does not count either. A force-install policy the
    browser accepted but could not fetch leaves an empty entry there -- a
    pending install, not an installed extension."""
    if (profile / "Extensions" / chromium_extension_id(profile)).exists():
        return True
    entry = chromium_preferences_entry(profile)
    return bool(entry) and any(key in entry for key in ("manifest", "path"))


def firefox_dark_reader_installed(profile: Path) -> bool:
    addons = read_capped_json(profile / "extensions.json").get("addons")
    for addon in addons if isinstance(addons, list) else []:
        if (isinstance(addon, dict) and addon.get("id") == FIREFOX_EXTENSION_ID
                and addon.get("active", True)):
            return True
    if (profile / "extensions" / f"{FIREFOX_EXTENSION_ID}.xpi").exists():
        return True
    if (profile / "browser-extension-data" / FIREFOX_EXTENSION_ID).exists():
        return True
    return False


def firefox_storage_data(database: Path) -> dict:
    if not database.exists():
        return {}
    with sqlite3.connect(database) as connection:
        row = connection.execute(
            "SELECT data FROM storage_sync_data WHERE ext_id = ?",
            (FIREFOX_EXTENSION_ID,),
        ).fetchone()
    if row is None or row[0] is None:
        return {}
    data = json.loads(row[0])
    if not isinstance(data, dict):
        # Overwriting it would destroy whatever it is; this profile is skipped.
        raise ValueError("Dark Reader's stored settings are not an object")
    return data


def write_firefox_storage_data(database: Path, data: dict) -> None:
    os.close(open_dir(database.parent, create=True))
    with sqlite3.connect(database) as connection:
        connection.execute(
            "CREATE TABLE IF NOT EXISTS storage_sync_data ("
            "ext_id TEXT NOT NULL PRIMARY KEY, "
            "data TEXT, "
            "sync_change_counter INTEGER NOT NULL DEFAULT 1)"
        )
        connection.execute(
            "INSERT INTO storage_sync_data(ext_id, data, sync_change_counter) "
            "VALUES(?, ?, 1) "
            "ON CONFLICT(ext_id) DO UPDATE SET "
            "data = excluded.data, "
            "sync_change_counter = storage_sync_data.sync_change_counter + 1",
            (FIREFOX_EXTENSION_ID, json.dumps(data, separators=(",", ":"))),
        )
        connection.commit()


