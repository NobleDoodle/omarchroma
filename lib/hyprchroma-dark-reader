CHROMIUM_STORE_EXTENSION_ID = "eimadpbcbfnmbkopoojfekhnkhdbieeh"
FIREFOX_EXTENSION_ID = "addon@darkreader.org"

# Every key Hyprchroma writes or edits. Snapshotting records these, and a stock
