[Unit]
Description=Hyprchroma theme synchronization daemon
Documentation=https://github.com/NobleDoodle/hyprchroma
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/hyprchroma daemon
# Always, not on-failure: the watcher returns 0 when Hyprland's socket is not
# up yet, which is the ordinary case at login, and on-failure would leave the
# daemon permanently stopped after that first clean exit. 78 is EX_CONFIG,
# which the daemon uses for "this is not an Omarchy system" -- the one failure
# restarting cannot fix.
Restart=always
RestartSec=2
RestartPreventExitStatus=78

# The daemon rewrites the user's own theme configuration and nothing else. It
# needs no new privilege, no device, no network, and no kernel surface, so it
# is given none. Every directive below was checked against a real run rather
# than added because it looked prudent: ProtectHome and ProtectSystem are
# absent because it writes $HOME, and ProtectProc is absent because reading
# other processes is how it knows which applications still hold the old theme.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
# Hyprland's event stream, D-Bus and dconf are all unix sockets; nothing here
# opens a network connection, so nothing may.
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
LockPersonality=yes

[Install]
WantedBy=graphical-session.target
