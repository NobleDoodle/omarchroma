[Unit]
Description=Hyprchroma theme synchronization daemon
Documentation=https://github.com/NobleDoodle/hyprchroma
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/hyprchroma daemon
# Always, not on-failure: the watcher returns 0 when Hyprland's socket is not
# up yet, which is the ordinary case at login, and on-failure would leave the
# daemon permanently stopped after that first clean exit. 78 is EX_CONFIG,
# which the daemon uses for "this is not an Omarchy system" -- the one failure
# restarting cannot fix.
Restart=always
RestartSec=2
RestartPreventExitStatus=78

# The daemon rewrites the user's own theme configuration and nothing else. It
# needs no new privilege and no network, so it is given none. Every directive
# below was checked against a real run rather than added because it looked
# prudent. ProtectHome and ProtectSystem are absent because it writes $HOME,
# and ProtectProc because reading other processes is how it knows which
# applications still hold the old theme. So are PrivateTmp, PrivateDevices,
# ProtectKernelTunables, ProtectKernelModules, ProtectControlGroups,
# ProtectHostname and ProtectClock: in a user's service manager each of them
# needs a mount namespace, which systemd can only make inside a user namespace
# of the service's own -- and from there no other process's executable, memory
# map or open file can be read. The daemon then took every window for stale,
# and wrote beneath browsers it could not see were running.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
# Hyprland's event stream, D-Bus and dconf are all unix sockets; nothing here
# opens a network connection, so nothing may.
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
LockPersonality=yes

[Install]
WantedBy=graphical-session.target
