/* Generated by Hyprchroma for Pear Desktop / YouTube Music. */

:root {
  --om-bg: #17241e;
  --om-bg-dark: #101914;
  --om-bg-darker: #0b120e;
  --om-surface: #27382f;
  --om-selection: #405648;
  --om-muted: #64766f;
  --om-fg: #d9e1d4;
  --om-fg-dim: #83938b;
  --om-fg-soft: #b9c7bd;
  --om-fg-bright: #f2ecd9;
  --om-accent: #e8bd72;
  --om-red: #d46f58;
  --om-green: #91a354;

  --yt-spec-base-background: var(--om-bg) !important;
  --yt-spec-raised-background: var(--om-bg-dark) !important;
  --yt-spec-menu-background: var(--om-bg-dark) !important;
  --yt-spec-inverted-background: var(--om-fg) !important;
  --yt-spec-addon-background: var(--om-surface) !important;
  --yt-spec-track-background: var(--om-selection) !important;
  --yt-spec-badge-chip-background: var(--om-surface) !important;
  --yt-spec-button-chip-background-hover: var(--om-selection) !important;
  --yt-spec-touch-response: var(--om-fg-soft) !important;
  --yt-spec-paper-tab-ink: var(--om-accent) !important;
  --yt-spec-filled-button-text: var(--om-bg-darker) !important;
  --yt-spec-call-to-action: var(--om-accent) !important;
  --yt-spec-brand-button-background: var(--om-accent) !important;
  --yt-spec-brand-link-text: var(--om-accent) !important;
  --yt-spec-wordmark-text: var(--om-fg) !important;
  --yt-spec-error-indicator: var(--om-red) !important;
  --yt-spec-themed-blue: var(--om-accent) !important;
  --yt-spec-themed-green: var(--om-green) !important;
  --yt-spec-text-primary: var(--om-fg) !important;
  --yt-spec-text-primary-inverse: var(--om-bg-darker) !important;
  --yt-spec-text-secondary: var(--om-fg-soft) !important;
  --yt-spec-text-disabled: var(--om-fg-dim) !important;
  --yt-spec-icon-active-other: var(--om-fg) !important;
  --yt-spec-icon-inactive: var(--om-fg-soft) !important;
  --yt-spec-icon-disabled: var(--om-muted) !important;
  --yt-spec-brand-icon-active: var(--om-accent) !important;
  --yt-spec-brand-icon-inactive: var(--om-fg-soft) !important;
  --yt-spec-10-percent-layer: color-mix(in srgb, var(--om-fg) 10%, transparent) !important;
  --yt-spec-selected-nav-text: var(--om-accent) !important;
  --yt-spec-brand-background-primary: var(--om-bg) !important;
  --yt-spec-brand-background-solid: var(--om-bg) !important;
  --yt-spec-dark-theme-background-solid: var(--om-bg) !important;

  --ytmusic-nav-bar: var(--om-bg-dark) !important;
  --ytmusic-player-bar-background: var(--om-bg-dark) !important;
  --ytmusic-menu-item-hover-background-color: var(--om-selection) !important;
  --ytmusic-color-black1: var(--om-bg) !important;
  --ytmusic-color-black2: var(--om-bg-dark) !important;
  --ytmusic-color-black3: var(--om-surface) !important;
  --ytmusic-color-black4: var(--om-selection) !important;
  --ytmusic-color-blackOpaque50: color-mix(in srgb, var(--om-bg) 50%, transparent) !important;
  --ytmusic-color-blackOpaque70: color-mix(in srgb, var(--om-bg) 70%, transparent) !important;
  --ytmusic-color-whiteOpaque50: color-mix(in srgb, var(--om-fg) 50%, transparent) !important;
  --ytmusic-text-color-primary: var(--om-fg) !important;
  --ytmusic-text-color-secondary: var(--om-fg-soft) !important;
  --ytmusic-setting-item-toggle-active: var(--om-accent) !important;
  --ytmusic-brand-background-solid: var(--om-bg) !important;
  --ytmusic-general-background-a: var(--om-bg) !important;
  --ytmusic-general-background-b: var(--om-bg-dark) !important;
  --ytmusic-general-background-c: var(--om-bg-darker) !important;
  --ytmusic-surface-100: var(--om-bg-dark) !important;
  --ytmusic-surface-200: var(--om-surface) !important;
  --ytmusic-surface-300: var(--om-selection) !important;
  --ytmusic-surface-400: var(--om-muted) !important;
  --ytmusic-brand-link-text: var(--om-accent) !important;
  --ytmusic-call-to-action: var(--om-accent) !important;

  --paper-slider-active-color: var(--om-accent) !important;
  --paper-slider-secondary-color: var(--om-selection) !important;
  --paper-slider-container-color: var(--om-selection) !important;
  --paper-slider-knob-color: var(--om-accent) !important;
}

html,
body,
ytmusic-app,
ytmusic-app-layout,
#content.ytmusic-app-layout,
ytmusic-browse-response,
ytmusic-section-list-renderer {
  background-color: var(--om-bg) !important;
  color: var(--om-fg) !important;
}

ytmusic-nav-bar,
ytmusic-guide-renderer,
ytmusic-player-bar {
  background-color: var(--om-bg-dark) !important;
  border-color: var(--om-selection) !important;
}

ytmusic-tabs,
ytmusic-tabs.stuck,
ytmusic-search-page.stuck ytmusic-header-renderer.ytmusic-search-page {
  background-color: var(--om-bg-dark) !important;
  box-shadow: none !important;
}

.background-gradient.ytmusic-browse-response,
ytmusic-browse-response[has-background-color] .background-gradient.ytmusic-browse-response,
ytmusic-immersive-header-renderer .background-gradient,
ytmusic-details-header-renderer .background-gradient,
ytmusic-detail-header-renderer .background-gradient,
#background.ytmusic-item-section-renderer,
#background-gradient.ytmusic-browse-response {
  background: var(--om-bg) !important;
  background-image: none !important;
}

ytmusic-immersive-header-renderer,
ytmusic-details-header-renderer,
ytmusic-detail-header-renderer,
ytmusic-visual-header-renderer,
ytmusic-header-renderer {
  background-color: var(--om-bg) !important;
  background-image: none !important;
}

ytmusic-guide-entry-renderer:hover,
ytmusic-responsive-list-item-renderer:hover,
ytmusic-menu-navigation-item-renderer:hover,
ytmusic-menu-service-item-renderer:hover {
  background-color: var(--om-selection) !important;
}

ytmusic-guide-entry-renderer[is-active] {
  color: var(--om-accent) !important;
}

ytmusic-search-box,
ytmusic-search-box input,
tp-yt-paper-input-container,
ytmusic-chip-cloud-chip-renderer,
ytmusic-settings-button,
tp-yt-paper-dialog,
ytmusic-popup-container tp-yt-paper-listbox {
  background-color: var(--om-surface) !important;
  color: var(--om-fg) !important;
}

yt-formatted-string,
.title,
.content,
ytmusic-player-bar .title,
ytmusic-player-bar .time-info {
  color: var(--om-fg) !important;
}

yt-formatted-string.subtitle,
yt-formatted-string.byline,
.subtitle,
.byline,
.secondary-text {
  color: var(--om-fg-soft) !important;
}

a,
a.yt-simple-endpoint,
yt-formatted-string[has-link-only_] a {
  --yt-endpoint-color: var(--om-accent) !important;
  --yt-endpoint-hover-color: var(--om-fg-bright) !important;
}

tp-yt-paper-icon-button[active],
tp-yt-paper-icon-button[aria-pressed="true"],
ytmusic-like-button-renderer[like-status="LIKE"] {
  color: var(--om-accent) !important;
}

ytmusic-play-button-renderer,
ytmusic-play-button-renderer #button {
  --ytmusic-play-button-icon-color: var(--om-bg-darker) !important;
  background-color: var(--om-accent) !important;
  color: var(--om-bg-darker) !important;
}

::selection {
  background: var(--om-selection) !important;
  color: var(--om-fg-bright) !important;
}

:focus-visible {
  outline: 2px solid var(--om-accent) !important;
  outline-offset: 2px !important;
}

::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

::-webkit-scrollbar-track {
  background: var(--om-bg-dark);
}

::-webkit-scrollbar-thumb {
  background: var(--om-muted);
  border: 2px solid var(--om-bg-dark);
  border-radius: 999px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--om-accent);
}
